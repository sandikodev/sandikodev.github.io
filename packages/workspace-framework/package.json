{
  "name": "@sandikodev/workspace-framework",
  "version": "0.1.0",
  "description": "RENDER - Revolutionary desktop environment framework. Ruin your F*cking at door",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "setup": "./scripts/dev-setup.sh",
    "build": "tsup src/index.ts src/astro.ts --format esm --dts",
    "build:native": "cargo build --release",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:native\"",
    "dev:web": "tsup src/index.ts src/astro.ts --format esm --dts --watch",
    "dev:native": "cargo watch -x 'build'",
    "dev:wsl": "DISPLAY=:0 pnpm dev",
    "test": "vitest",
    "test:all": "concurrently \"pnpm test\" \"cargo test\"",
    "lint": "eslint src/ --ext .ts,.js",
    "format": "prettier --write src/",
    "docs": "typedoc src/index.ts",
    "revolution": "echo '🔥 Starting the desktop revolution!' && pnpm dev"
  },
  "keywords": [
    "render",
    "desktop-environment",
    "wayland",
    "compositor",
    "workspace",
    "native-apps",
    "revolution",
    "anti-windows",
    "performance",
    "rust",
    "web-dx"
  ],
  "author": "SandikoDev <sandikodev@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "astro": "^4.0.0"
  },
  "dependencies": {
    "@sandikodev/astro-terminal-code": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "typedoc": "^0.25.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "concurrently": "^8.0.0",
    "cargo-watch": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sandikodev/workspace-framework"
  },
  "homepage": "https://sandikodev.com/workspace",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sandikodev"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
