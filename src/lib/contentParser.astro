---
import {
  type CollectionEntry,
  type CollectionKey,
  getCollection,
} from "astro:content";

export const getSinglePage = async <C extends CollectionKey>(
  collectionName: C,
): Promise<CollectionEntry<C>[]> => {
  const allPages = await getCollection(collectionName);
  const removeIndex = allPages.filter((data) => data.id.match(/^(?!-)/));
  const removeDrafts = removeIndex.filter((data) => !data.data.draft);
  return removeDrafts;
};

// Get all posts from both sources (submodule + local templates)
export const getAllPosts = async (): Promise<CollectionEntry<"posts">[]> => {
  const posts = await getCollection("posts");
  const templates = await getCollection("templates");

  // Convert templates to posts format
  const templatesAsPosts = templates.map((template) => ({
    ...template,
    collection: "posts" as const,
  }));

  const allPosts = [...posts, ...templatesAsPosts].map((post) => ({
    ...post,
    id: post.id.replace(/\.mdx?$/, ""),
  }));
  const removeIndex = allPosts.filter((data) => data.id.match(/^(?!-)/));
  const removeDrafts = removeIndex.filter((data) => !data.data.draft);

  // Sort by date (newest first)
  return removeDrafts.sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });
};
---
