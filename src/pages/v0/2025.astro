---
import config from "@/config/config.json";
import V0Layout from "@/layouts/V0Layout.astro";
import Posts from "@/layouts/Posts.astro";
import { getAllPosts } from "@/lib/contentParser.astro";

const posts = await getAllPosts();
const featuredPosts = posts.slice(0, 6);
---

<V0Layout
  meta_title={`${config.metadata.meta_author} — v0 (2025 archive)`}
  description={config.metadata.meta_description}
>
  <!-- Archive banner -->
  <div class="v0-banner">
    <span class="v0-breadcrumb">
      <a href="/">sandikodev.github.io</a>
      <span>/</span>
      <a href="/v0">v0</a>
      <span>/</span>
      <span>2025</span>
    </span>
    <span class="v0-label"
      >Original 2025 landing page — preserved as shipped.</span
    >
    <a class="v0-link" href="/v0">← Version history</a>
  </div>

  <div class="v0-retrospective">
    <div class="retro-container">
      <div class="retro-header">
        <span class="retro-tag">2026 Perspective</span>
        <h3>The Transition to Modernity</h3>
      </div>
      <p>
        2025 was the bridge to where I am now. I moved to Astro for its
        performance and "Islands Architecture" (as seen in the blog
        implementation). The design shifted towards a typography-first approach,
        prioritizing clarity and content over complex decorations. It set the
        stage for the current 2026 Architectural Engineer identity—minimal,
        fast, and deeply technical.
      </p>
    </div>
  </div>

  <!-- Hero — original, unmodified -->
  <section class="hero-25">
    <h1>{config.metadata.meta_author}</h1>
    <p class="tagline">{config.metadata.tagline}</p>
    <p class="bio">
      Menulis tentang web development, infrastructure, dan continuous learning.
      10 tahun journey dari SMK ke DevOps.
    </p>
    <div class="hero-links">
      <a class="btn-primary" href="/blog">Read Blog</a>
      <a class="btn-secondary" href="/now">What I'm doing now →</a>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="posts-section">
    <div class="section-header">
      <h2>Latest Articles</h2>
      <a class="view-all" href="/blog">View all →</a>
    </div>
    <Posts posts={featuredPosts} />
  </section>

  <!-- About -->
  <section class="about-section">
    <p>
      Passionate tentang web technology dan open source. Percaya pada knowledge
      sharing dan building things that matter.
    </p>
    <div class="social-links">
      <a href={config.contactinfo.github} target="_blank">GitHub</a>
      <a href={config.contactinfo.linkedin} target="_blank">LinkedIn</a>
      <a href={`mailto:${config.contactinfo.email}`}>Email</a>
    </div>
  </section>
</V0Layout>

<style>
  /* ── Original 2025 styles — untouched ── */
  .hero-25 {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
    text-align: center;
  }

  .hero-25 h1 {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: var(--color-text-main);
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .bio {
    font-family: Georgia, serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text-body);
    margin-bottom: 2rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-text-main);
    color: var(--color-bg);
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    color: var(--color-text-main);
  }

  .posts-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0;
  }

  .view-all {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all 0.2s;
  }

  .view-all:hover {
    color: var(--color-text-main);
  }

  .about-section {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .about-section p {
    font-family: Georgia, serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text-body);
    margin-bottom: 1.5rem;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .social-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-main);
    text-decoration: none;
    transition: all 0.2s;
  }

  .social-links a:hover {
    color: var(--color-text-main);
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .hero-25 h1 {
      font-size: 2.25rem;
    }
  }
</style>
