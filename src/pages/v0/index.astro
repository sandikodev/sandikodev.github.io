---
import V0Layout from "@/layouts/V0Layout.astro";
---

<V0Layout meta_title="sandikodev — Version History">
  <div class="v0-root">
    <div class="v0-header">
      <div class="v0-breadcrumb">
        <a href="/">sandikodev.github.io</a>
        <span>/</span>
        <span>v0</span>
      </div>
      <h1>Version History</h1>
      <p class="v0-desc">
        Software is an evolutionary process. This archive preserves the DNA of
        my technical growth—from the hardware tinkerings of 2009 to the
        architectural engineering of today. Each version is a navigable snapshot
        of a specific era.
      </p>
    </div>

    <div class="versions-list">
      <!-- 2026 — current -->
      <a class="version-card current" href="/">
        <div class="ver-meta">
          <span class="ver-tag current-tag">Current</span>
          <span class="ver-date">Feb 2026</span>
        </div>
        <h2 class="ver-title">2026 — Architectural Engineer</h2>
        <p class="ver-desc">
          Full redesign with dark terminal aesthetic, boot sequence hero, and
          7-layer stack depth visualization. Repositioned from "fullstack
          developer" to Architectural Engineer with roots in networking and
          cybersecurity.
        </p>
        <div class="ver-tags">
          <span>Astro 5</span><span>Terminal UI</span><span>Dark theme</span
          ><span>Boot animation</span>
        </div>
        <span class="ver-arrow">↗</span>
      </a>

      <!-- 2025 -->
      <a class="version-card" href="/v0/2025">
        <div class="ver-meta">
          <span class="ver-tag archived-tag">Archived</span>
          <span class="ver-date">2025</span>
        </div>
        <h2 class="ver-title">2025 — Minimal Blog</h2>
        <p class="ver-desc">
          Clean typography-first layout. Centered hero with name and tagline,
          latest posts grid below. Simple and functional — first iteration after
          moving to Astro.
        </p>
        <div class="ver-tags">
          <span>Astro 5</span><span>Minimal</span><span>Typography</span><span
            >Blog-first</span
          >
        </div>
        <span class="ver-arrow">↗</span>
      </a>

      <!-- 2024 -->
      <a class="version-card" href="/v0/2024">
        <div class="ver-meta">
          <span class="ver-tag archived-tag">Archived</span>
          <span class="ver-date">2024</span>
        </div>
        <h2 class="ver-title">2024 — Two-Column Portfolio</h2>
        <p class="ver-desc">
          Split-column hero with live stack code snippet panel, availability
          badge, and explicit DevOps positioning. First version to seriously
          document the infrastructure side of the work.
        </p>
        <div class="ver-tags">
          <span>Astro</span><span>Code panel</span><span>DevOps focus</span
          ><span>Freelance CTA</span>
        </div>
        <span class="ver-arrow">↗</span>
      </a>

      <!-- 2023 -->
      <a class="version-card" href="/v0/2023">
        <div class="ver-meta">
          <span class="ver-tag archived-tag">Archived</span>
          <span class="ver-date">2023</span>
        </div>
        <h2 class="ver-title">2023 — Skills-Forward Portfolio</h2>
        <p class="ver-desc">
          Structured portfolio with explicit nav, four-column skills grid, and a
          "Hire Me" CTA. Indigo accent. First attempt at professionally
          positioning for freelance work internationally.
        </p>
        <div class="ver-tags">
          <span>Next.js</span><span>Skills grid</span><span>Indigo theme</span
          ><span>Hire Me CTA</span>
        </div>
        <span class="ver-arrow">↗</span>
      </a>

      <!-- 2022 -->
      <a class="version-card" href="/v0/2022">
        <div class="ver-meta">
          <span class="ver-tag archived-tag">Archived</span>
          <span class="ver-date">2022</span>
        </div>
        <h2 class="ver-title">2022 — Terminal Green Era</h2>
        <p class="ver-desc">
          Monospace-heavy design with green (#10b981) terminal accent. Included
          a "currently building" project status card and a full tech badge list.
          First real portfolio site with hosted projects listed.
        </p>
        <div class="ver-tags">
          <span>Next.js</span><span>Monospace</span><span>Green accent</span
          ><span>Project cards</span>
        </div>
        <span class="ver-arrow">↗</span>
      </a>

      <!-- 2021 -->
      <a class="version-card origin-card" href="/v0/2021">
        <div class="ver-meta">
          <span class="ver-tag origin-tag">Origin</span>
          <span class="ver-date">2021</span>
        </div>
        <h2 class="ver-title">2021 — First Web Presence</h2>
        <p class="ver-desc">
          Very first site on GitHub Pages. Courier New monospace, percentage
          skill bars, and a hand-written bio. Documents the formal transition
          from system administration and "dark tinkering" into structured
          software development.
        </p>
        <div class="ver-tags">
          <span>HTML + CSS</span><span>GitHub Pages</span><span>Skill bars</span
          >
        </div>
        <span class="ver-arrow">↗</span>
      </a>

      <!-- 2009 - 2020 -->
      <a class="version-card roots-card" href="/v0/legacy">
        <div class="ver-meta">
          <span class="ver-tag roots-tag">The Roots</span>
          <span class="ver-date">2009 — 2020</span>
        </div>
        <h2 class="ver-title">The Fragments — Early Tinkerings</h2>
        <p class="ver-desc">
          Blogspot era, Google AdSense, Meta Pixel optimization, and deep dives
          into web security, scripting, and PHP/Wordpress. A decade of intense
          self-learning, starting from SD, that built the technical intuition I
          carry today.
        </p>
        <div class="ver-tags">
          <span>Blogspot</span><span>Wordpress</span><span>Web Security</span
          ><span>PHP</span><span>Ruby on Rails</span>
        </div>
        <span class="ver-arrow">↗</span>
      </a>
    </div>

    <div class="v0-footer">
      <code class="v0-note">
        # Each version is a navigable snapshot — HTML, CSS, and logic preserved
        as shipped.
      </code>
    </div>
  </div>
</V0Layout>

<style>
  .v0-root {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  /* Header */
  .v0-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .v0-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .v0-breadcrumb a:hover {
    color: var(--color-text-main);
  }

  .v0-header h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .v0-desc {
    font-size: 0.95rem;
    color: var(--color-text-body);
    line-height: 1.65;
    opacity: 0.8;
    margin-bottom: 3rem;
    max-width: 56ch;
  }

  /* Version cards */
  .versions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .version-card {
    display: block;
    position: relative;
    padding: 1.75rem;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .version-card:hover {
    border-color: var(--color-text-main);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.15);
  }

  .version-card.current {
    border-color: rgba(78, 205, 196, 0.35);
    background: linear-gradient(
      135deg,
      rgba(78, 205, 196, 0.04),
      var(--color-surface)
    );
  }

  .version-card.current:hover {
    border-color: rgba(78, 205, 196, 0.6);
    box-shadow: 0 8px 32px -8px rgba(78, 205, 196, 0.2);
  }

  .ver-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .ver-tag {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    border: 1px solid;
  }

  .current-tag {
    color: #4ecdc4;
    border-color: rgba(78, 205, 196, 0.4);
    background: rgba(78, 205, 196, 0.08);
  }

  .archived-tag {
    color: var(--color-text-muted);
    border-color: var(--color-border);
    background: transparent;
  }

  .origin-tag {
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.35);
    background: rgba(245, 158, 11, 0.06);
  }

  .origin-card {
    border-color: rgba(245, 158, 11, 0.2);
  }

  .origin-card:hover {
    border-color: rgba(245, 158, 11, 0.5);
    box-shadow: 0 8px 32px -8px rgba(245, 158, 11, 0.15);
  }

  /* Roots Card (Purple/Security) */
  .roots-tag {
    color: #a78bfa;
    border-color: rgba(167, 139, 250, 0.35);
    background: rgba(167, 139, 250, 0.06);
  }

  .roots-card {
    border-color: rgba(167, 139, 250, 0.2);
    border-style: dashed;
  }

  .roots-card:hover {
    border-color: rgba(167, 139, 250, 0.5);
    border-style: solid;
    box-shadow: 0 8px 32px -8px rgba(167, 139, 250, 0.2);
  }

  .ver-date {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .ver-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .ver-desc {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 1rem;
    max-width: 58ch;
  }

  .ver-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .ver-tags span {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border-radius: 5px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .ver-arrow {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    font-size: 1rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    transition: all 0.2s;
  }

  .version-card:hover .ver-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* Footer note */
  .v0-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .v0-note {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0.6;
  }
</style>
