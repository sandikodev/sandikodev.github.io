---
import { Code } from "astro:components";

import AsciiHero from "@/components/terminal/AsciiHero.astro";
import Prompt from "@/components/terminal/svelte/Prompt.svelte";
import TerminalWindow from "@/components/terminal/svelte/TerminalWindow.svelte";
import TypingAnimation from "@/components/terminal/svelte/TypingAnimation.svelte";

import I3Layout from "../layouts/I3Layout.astro";

const jsCode = `// Arrow functions with ligatures: => !== ===
const fetchData = async (url: string): Promise<Data> => {
  if (url !== "https://api.dev") {
    throw new Error("Invalid endpoint");
  }
  return await fetch(url);
};`;

const rustCode = `// Rust pattern matching and traits
match result {
    Ok(data) => println!("Success: {:?}", data),
    Err(e) if e.is_fatal() => panic!("Fatal error!"),
    _ => unreachable!(),
}`;

const bashCode = `#!/bin/bash
# ZSH completions and history
for file in ~/workspace/**/*; do
  [[ -f "$file" ]] && echo "Node: \${file##*/}"
done`;
---

<I3Layout title="Terminal Features — dev@enigma">
  <div class="space-y-12 px-4 py-10">
    <header class="mx-auto mb-16 max-w-2xl text-center">
      <h1 class="mb-4 text-4xl font-black tracking-tight">
        TERMINAL_CORE v2.0
      </h1>
      <p class="text-text-muted">
        Exploring the advanced features of the workspace terminal emulator.
      </p>
    </header>

    <!-- Neofetch Section -->
    <section class="mx-auto max-w-4xl">
      <TerminalWindow client:load showCursor={false} title="neofetch">
        <div slot="header">
          <Prompt command="neofetch" />
        </div>
        <AsciiHero />
      </TerminalWindow>
    </section>

    <!-- MOTD Section -->
    <section class="mx-auto max-w-4xl">
      <TerminalWindow client:load showCursor={false} title="cat /etc/motd">
        <div slot="header">
          <Prompt command="cat /etc/motd" />
        </div>
        <div class="py-4">
          <TypingAnimation
            client:visible
            speed={40}
            text="Welcome to Antigravity OS. All systems nominal. Authorized access only."
          />
        </div>
      </TerminalWindow>
    </section>

    <!-- Code Highlighting Section -->
    <section class="mx-auto grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
      <TerminalWindow client:load title="typescript_demo.ts">
        <div slot="header">
          <Prompt command="cat typescript_demo.ts" showCursor={false} />
        </div>
        <div class="mt-4">
          <Code code={jsCode} lang="ts" theme="tokyo-night" />
        </div>
      </TerminalWindow>

      <TerminalWindow client:load title="rust_patterns.rs">
        <div slot="header">
          <Prompt command="cat rust_patterns.rs" showCursor={false} />
        </div>
        <div class="mt-4">
          <Code code={rustCode} lang="rust" theme="tokyo-night" />
        </div>
      </TerminalWindow>
    </section>

    <!-- Bash Scripting -->
    <section class="mx-auto max-w-4xl">
      <TerminalWindow client:load title="bash_utils.sh">
        <div slot="header">
          <Prompt command="cat bash_utils.sh" showCursor={false} />
        </div>
        <div class="mt-4">
          <Code code={bashCode} lang="bash" theme="tokyo-night" />
        </div>
      </TerminalWindow>
    </section>
  </div>
</I3Layout>

<style>
  :global(.i3-window) {
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }
</style>
