---
import Base from "@/layouts/Base.astro";
---

<Base title="404 - Page Not Found">
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span
            class="text-dark dark:text-darkmode-dark block text-[8rem] font-bold"
          >
            404
          </span>
          <h1 class="h2 mb-4">Page not found!</h1>
          <div class="content">
            <p>
              The page you are looking for might have been removed, had its name
              changed, or is temporarily unavailable.
            </p>
          </div>
          <a class="btn btn-primary mt-8" href="/"> Back to Home </a>
        </div>
      </div>
    </div>
  </section>
</Base>
