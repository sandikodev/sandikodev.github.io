---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
---

<Base
  description={`Explore ${config.metadata.meta_author}'s production work — SaaS platforms, institutional systems, and AI-powered tools built with Next.js, SvelteKit, Astro, and more.`}
  meta_title={`Portfolio — ${config.metadata.meta_author} | Fullstack Developer`}
  title={`Portfolio | ${config.metadata.meta_author}`}
>
  <!-- Hero -->
  <section class="port-hero">
    <div class="container">
      <div class="hero-inner">
        <div class="availability-wrap">
          <span class="avail-dot"></span>
          <span class="avail-text">Open to Freelance &amp; Collaboration</span>
        </div>
        <h1 class="port-title">
          Production-Grade<br />
          <span class="stroke-text">Work.</span>
        </h1>
        <p class="port-sub">
          A curated collection of real-world applications — SaaS platforms,
          institutional systems, and AI-powered tools — shipped and running in
          production.
        </p>
        <div class="hero-meta">
          <div class="meta-item">
            <span class="meta-num">17+</span>
            <span class="meta-label">Projects</span>
          </div>
          <div class="meta-divider"></div>
          <div class="meta-item">
            <span class="meta-num">8</span>
            <span class="meta-label">Years Exp.</span>
          </div>
          <div class="meta-divider"></div>
          <div class="meta-item">
            <span class="meta-num">3</span>
            <span class="meta-label">Live Products</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter Tabs -->
  <section class="port-filters">
    <div class="container">
      <div class="filter-wrap">
        <div
          class="filter-bar"
          role="tablist"
          aria-label="Portfolio Categories"
        >
          <button class="filter-btn active" data-filter="all" role="tab"
            >All</button
          >
          <button class="filter-btn" data-filter="saas" role="tab">SaaS</button>
          <button class="filter-btn" data-filter="education" role="tab"
            >Education</button
          >
          <button class="filter-btn" data-filter="devops" role="tab"
            >DevOps &amp; CLI</button
          >
          <button class="filter-btn" data-filter="ai" role="tab">AI</button>
          <button class="filter-btn" data-filter="community" role="tab"
            >Community</button
          >
        </div>
        <span class="filter-count" id="filter-count">8 projects</span>
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="port-grid-section">
    <div class="container">
      <div class="port-grid" id="port-grid">
        <!-- Project 1: Margin Pro -->
        <article class="proj-card featured" data-category="saas ai">
          <div class="card-inner">
            <div class="card-top">
              <div class="proj-badge-row">
                <span class="proj-type">SaaS Platform</span>
                <span class="proj-status live">● Live</span>
              </div>
              <div class="proj-icon">📊</div>
            </div>
            <div class="card-body">
              <h2 class="proj-title">Margin Pro</h2>
              <p class="proj-desc">
                Pricing intelligence SaaS for Indonesian F&amp;B businesses.
                Calculates COGS, simulates delivery app margins (GoFood,
                GrabFood), and provides AI-driven pricing recommendations via
                Gemini 2.0.
              </p>
              <div class="tech-stack">
                <span class="tech-tag">Koda Zenith</span>
                <span class="tech-tag">React 19</span>
                <span class="tech-tag">Hono RPC</span>
                <span class="tech-tag">Turso</span>
                <span class="tech-tag">Drizzle ORM</span>
                <span class="tech-tag">Gemini 2.0</span>
                <span class="tech-tag">Bun</span>
              </div>
            </div>
            <div class="card-footer">
              <div class="card-actions">
                <a
                  class="action-btn primary"
                  href="https://github.com/sandikodev"
                  target="_blank"
                  rel="noopener"
