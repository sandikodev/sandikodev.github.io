---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import Posts from "@/layouts/Posts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);
---

<Base title="Blog" description="Articles about web development, infrastructure, and continuous learning">
  <section class="blog-page">
    <header class="blog-header">
      <h1>Blog</h1>
      <p>Thoughts on web development, infrastructure, and learning.</p>
    </header>

    <div class="blog-content">
      <Posts posts={currentPosts} />
      
      {totalPages > 1 && (
        <div class="pagination-wrapper">
          <Pagination currentPage={1} totalPages={totalPages} />
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .blog-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  
  .blog-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .blog-header h1 {
    font-family: 'Inter', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    color: #0a0a0a;
  }
  
  :global(.dark) .blog-header h1 {
    color: #fafafa;
  }
  
  .blog-header p {
    font-size: 1.125rem;
    color: #525252;
    margin: 0;
  }
  
  :global(.dark) .blog-header p {
    color: #a3a3a3;
  }
  
  .pagination-wrapper {
    margin-top: 4rem;
  }
</style>
