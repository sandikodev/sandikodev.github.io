---
import I3Window from "@/components/terminal/svelte/I3Window.svelte";
import Prompt from "@/components/terminal/svelte/Prompt.svelte";
import I3Layout from "@/layouts/I3Layout.astro";

const skills = {
  certifications: [
    { name: "AWS Certified Developer", year: 2023 },
    { name: "Kubernetes Administrator", year: 2024 },
  ],
  interests: [
    "Open Source Contribution",
    "System Design & Architecture",
    "Developer Tools & CLI",
    "Terminal UX & i3wm",
    "Performance Optimization",
  ],
  personal_info: {
    availability: "Open for opportunities",
    location: "Indonesia",
    name: "Sandiko",
    role: "Full Stack Developer",
  },
  soft_skills: [
    "Problem Solving",
    "Team Collaboration",
    "Technical Writing",
    "Code Review",
    "Mentoring",
  ],
  technical_skills: {
    databases: [
      { name: "PostgreSQL", proficiency: "expert", type: "relational" },
      { name: "MongoDB", proficiency: "advanced", type: "document" },
      { name: "Redis", proficiency: "advanced", type: "cache" },
    ],
    frameworks: [
      { category: "frontend", name: "React", proficiency: "expert" },
      { category: "fullstack", name: "Next.js", proficiency: "expert" },
      { category: "frontend", name: "Astro", proficiency: "advanced" },
      { category: "backend", name: "Node.js", proficiency: "expert" },
      { category: "backend", name: "Express", proficiency: "advanced" },
    ],
    languages: [
      {
        focus: "Full-stack development",
        name: "JavaScript",
        proficiency: "Expert",
      },
      {
        focus: "Type-safe architecture",
        name: "TypeScript",
        proficiency: "Expert",
      },
      {
        focus: "Automation & Data processing",
        name: "Python",
        proficiency: "Advanced",
      },
      { focus: "Backend services", name: "Go", proficiency: "Intermediate" },
      { focus: "Systems tooling", name: "Rust", proficiency: "Learning" },
    ],
    tools: [
      { name: "Git", type: "version-control" },
      { name: "Docker", type: "containerization" },
      { name: "Kubernetes", type: "orchestration" },
      { name: "VS Code", type: "editor" },
      { name: "Neovim", type: "editor" },
      { name: "Linux", type: "os" },
    ],
  },
};
---

<I3Layout title="Skills | dev@enigma">
  <div class="i3-split-h">
    <I3Window client:load focused={true} title="alacritty — dev@enigma:~">
      <div class="terminal-content">
        <Prompt command="cat skills.json | jq" showCursor={false} />

        <pre class="json-output" id="json-container"></pre>

        <Prompt showCursor={true} />
      </div>
    </I3Window>
  </div>
</I3Layout>

<style>
  .terminal-content {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .json-output {
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    overflow-x: auto;
    white-space: pre;
  }

  /* JQ-style syntax highlighting */
  :global(.json-key) {
    color: #7aa2f7; /* Blue - keys */
    font-weight: 600;
  }

  :global(.json-string) {
    color: #9ece6a; /* Green - string values */
  }

  :global(.json-number) {
    color: #ff9e64; /* Orange - numbers */
  }

  :global(.json-boolean) {
    color: #bb9af7; /* Purple - booleans */
  }

  :global(.json-null) {
    color: #565f89; /* Gray - null */
  }

  :global(.json-punctuation) {
    color: var(--text-muted); /* Gray - brackets, colons, commas */
  }

  /* Scrollbar */
  .json-output::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  .json-output::-webkit-scrollbar-track {
    background: var(--bg-primary);
  }

  .json-output::-webkit-scrollbar-thumb {
    background: var(--bg-tertiary);
    border-radius: 4px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .terminal-content {
      font-size: 0.75rem;
    }
  }
</style>

<script is:inline define:vars={{ skills }}>
  // JSON syntax highlighter (jq-style)
  function highlightJSON(obj) {
    const json = JSON.stringify(obj, null, 2);

    // Regex-based syntax highlighting
    const highlighted = json
      .replace(
        /"([^"]+)":/g,
        '<span class="json-key">"$1"</span><span class="json-punctuation">:</span>',
      )
      .replace(/: "([^"]*)"/g, ': <span class="json-string">"$1"</span>')
      .replace(/: (\d+\.?\d*)/g, ': <span class="json-number">$1</span>')
      .replace(/: (true|false)/g, ': <span class="json-boolean">$1</span>')
      .replace(/: null/g, ': <span class="json-null">null</span>')
      .replace(/([{}[\],])/g, '<span class="json-punctuation">$1</span>');

    return highlighted;
  }

  // Inject highlighted JSON
  const container = document.getElementById("json-container");
  if (container) {
    container.innerHTML = highlightJSON(skills);
  }
</script>
