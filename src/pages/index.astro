---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Posts from "@/layouts/Posts.astro";
import { getAllPosts } from "@/lib/contentParser.astro";

const posts = await getAllPosts();
const featuredPosts = posts.slice(0, 3);
---

<Base
  description="Sandikodev — Architectural Engineer specializing in resilient full-stack systems, security-first infrastructure, and high-performance cloud deployments. Turning technical depth into business value."
  meta_title={`${config.metadata.meta_author} — Architectural Engineer & Fullstack Developer`}
  hideFooter={true}
>
  <!-- Boot Sequence Hero -->
  <section class="hero-boot">
    <div class="boot-bg" aria-hidden="true">
      <div class="grid-lines"></div>
      <div class="scan-line"></div>
    </div>

    <div class="boot-container">
      <!-- Terminal Boot -->
      <div class="terminal-panel" id="terminal-panel">
        <div class="terminal-bar">
          <div class="term-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="term-title">zsh — sandikodev@arch ~</span>
        </div>
        <div class="terminal-body">
          <div class="boot-line" data-delay="0">
            <span class="ok">[ OK ]</span> Starting network interfaces...
          </div>
          <div class="boot-line" data-delay="300">
            <span class="ok">[ OK ]</span> Mounting /dev/sda1 on /
          </div>
          <div class="boot-line" data-delay="600">
            <span class="ok">[ OK ]</span> Loading iptables rules...
          </div>
          <div class="boot-line" data-delay="900">
            <span class="ok">[ OK ]</span> Starting Docker daemon...
          </div>
          <div class="boot-line" data-delay="1200">
            <span class="ok">[ OK ]</span> Configuring nginx upstream...
          </div>
          <div class="boot-line" data-delay="1500">
            <span class="ok">[ OK ]</span> Deploying application containers...
          </div>
          <div class="boot-line highlight-line" data-delay="1800">
            <span class="prompt">$</span> whoami
          </div>
          <div class="boot-line result-line" data-delay="2100">
            <span class="teal">sandikodev</span> — Architectural Engineer &amp; Fullstack
            Developer
          </div>
          <div class="boot-cursor-line" data-delay="2400">
            <span class="prompt">$</span>
            <span class="boot-cursor"></span>
          </div>
        </div>
      </div>

      <!-- Hero Text -->
      <div class="hero-text">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>Available for collaboration</span>
        </div>
        <h1 class="hero-title">
          More than a<br />
          <span class="title-gradient">Fullstack Dev.</span>
        </h1>
        <p class="hero-desc">
          I build resilient, high-performance systems with an architectural
          background in
          <strong>security audits and network engineering</strong>. I leverage
          this depth to ensure your production stack is efficient, secure, and
          engineered to scale.
        </p>
        <div class="hero-actions">
          <a class="cta-main" href="/about">
            My Background
            <svg
              fill="none"
              width="16"
              height="16"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M5 12h14M12 5l7 7-7 7"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a class="cta-ghost" href="/portfolio">View Work ↗</a>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <span class="stat-n">2016</span>
            <span class="stat-l">First ping</span>
          </div>
          <div class="stat-div"></div>
          <div class="stat">
            <span class="stat-n">10+</span>
            <span class="stat-l">Years in tech</span>
          </div>
          <div class="stat-div"></div>
          <div class="stat">
            <span class="stat-n">7</span>
            <span class="stat-l">Stack layers</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Depth Section: 7-Layer Stack Visualization -->
  <section class="depth-section">
    <div class="depth-container">
      <div class="depth-header">
        <span class="depth-tag">
          <span class="teal">$</span> cat /proc/sandikodev/stack
        </span>
        <h2>Fluent at Every Layer</h2>
        <p>
          Most developers operate at layers 5–7. I've worked with all seven —
          from physical hardware to the UI your users interact with.
        </p>
      </div>

      <div class="stack-layers">
        <div class="layer" data-layer="1">
          <div class="layer-num">L1</div>
          <div class="layer-content">
            <div class="layer-name">Physical &amp; Hardware</div>
            <div class="layer-desc">
              Built and maintained physical machines, diagnosed hardware
              failures, configured NICs, understood signal behavior on copper
              and fiber
            </div>
            <div class="layer-tags">
              <span>CompTIA A+</span><span>Cisco</span><span>Wireshark</span>
            </div>
          </div>
          <div class="layer-bar" style="--w: 95%"></div>
        </div>
        <div class="layer" data-layer="2">
          <div class="layer-num">L2</div>
          <div class="layer-content">
            <div class="layer-name">Network &amp; Security</div>
            <div class="layer-desc">
              Routing protocols, VLAN segmentation, firewall policy, IPSec
              tunnels, network intrusion detection, and penetration testing
              fundamentals
            </div>
            <div class="layer-tags">
              <span>iptables</span><span>pfSense</span><span>Snort</span><span
                >VPN</span
              >
            </div>
          </div>
          <div class="layer-bar" style="--w: 90%"></div>
        </div>
        <div class="layer" data-layer="3">
          <div class="layer-num">L3</div>
          <div class="layer-content">
            <div class="layer-name">Operating System &amp; Kernel</div>
            <div class="layer-desc">
              Linux internals, process scheduling, file descriptors, cgroups and
              namespaces — the same primitives containers are built on
            </div>
            <div class="layer-tags">
              <span>Linux</span><span>systemd</span><span>Bash</span><span
                >cgroups</span
              >
            </div>
          </div>
          <div class="layer-bar" style="--w: 87%"></div>
        </div>
        <div class="layer" data-layer="4">
          <div class="layer-num">L4</div>
          <div class="layer-content">
            <div class="layer-name">Infrastructure &amp; DevOps</div>
            <div class="layer-desc">
              Container orchestration, CI/CD pipeline design, server
              provisioning, observability stacks, and zero-downtime deployment
              strategies
            </div>
            <div class="layer-tags">
              <span>Docker</span><span>AWS</span><span>Nginx</span><span
                >GitHub Actions</span
              >
            </div>
          </div>
          <div class="layer-bar" style="--w: 93%"></div>
        </div>
        <div class="layer" data-layer="5">
          <div class="layer-num">L5</div>
          <div class="layer-content">
            <div class="layer-name">Backend &amp; API</div>
            <div class="layer-desc">
              REST and RPC API design, relational schema architecture, query
              optimization, authentication systems, and multi-tenant data
              isolation
            </div>
            <div class="layer-tags">
              <span>Node.js</span><span>Hono</span><span>PostgreSQL</span><span
                >Drizzle</span
              >
            </div>
          </div>
          <div class="layer-bar" style="--w: 91%"></div>
        </div>
        <div class="layer" data-layer="6">
          <div class="layer-num">L6</div>
          <div class="layer-content">
            <div class="layer-name">Full-Stack Frameworks</div>
            <div class="layer-desc">
              SSR, SSG, edge rendering, and isomorphic patterns — understanding
              why each rendering strategy exists, not just how to use them
            </div>
            <div class="layer-tags">
              <span>Next.js</span><span>SvelteKit</span><span>Astro</span><span
                >Hono RPC</span
              >
            </div>
          </div>
          <div class="layer-bar" style="--w: 95%"></div>
        </div>
        <div class="layer active-layer" data-layer="7">
          <div class="layer-num">L7</div>
          <div class="layer-content">
            <div class="layer-name">Product &amp; UI</div>
            <div class="layer-desc">
              Component architecture, accessible interfaces, state management,
              performance budgeting, and translating user feedback into product
              decisions
            </div>
            <div class="layer-tags">
              <span>React 19</span><span>Svelte 5</span><span>TypeScript</span
              ><span>Tailwind</span>
            </div>
          </div>
          <div class="layer-bar" style="--w: 89%"></div>
        </div>
      </div>
    </div>
  </section>
</Base>
<!-- Core Exploration Section -->
<section class="explore-section">
  <div class="explore-container">
    <div class="explore-grid">
      <a href="/architecture" class="explore-card">
        <div class="explore-icon">🏗️</div>
        <div class="explore-content">
          <h3>Architectural Manifesto</h3>
          <p>
            Explore the business value of technical depth, ROI engineering, and
            my security-first blueprint.
          </p>
          <span class="explore-link">Read Manifesto →</span>
        </div>
      </a>
      <a href="/v0" class="explore-card">
        <div class="explore-icon">🕰️</div>
        <div class="explore-content">
          <h3>The v0 Legacy Archive</h3>
          <p>
            The journey from 2009. Explore the technical evolution, past
            projects, and deep engineering roots.
          </p>
          <span class="explore-link">Explore Archive →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- Workspace Mode Intro -->
<section class="workspace-intro">
  <div class="ws-container">
    <div class="ws-terminal">
      <div class="ws-bar">
        <div class="term-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <span class="term-title">sandikodev.github.io/workspace</span>
      </div>
      <div class="ws-preview">
        <div class="ws-sidebar">
          <div class="ws-item active">📁 Projects</div>
          <div class="ws-item">📝 Blog</div>
          <div class="ws-item">🔧 Skills</div>
          <div class="ws-item">📊 Stats</div>
        </div>
        <div class="ws-content">
          <div class="ws-panel">
            <div class="ws-panel-title">{"//"} Active Projects</div>
            <div class="ws-project">
              <span class="ws-dot green"></span>
              <span>margin-pro</span>
              <span class="ws-tag">SaaS</span>
            </div>
            <div class="ws-project">
              <span class="ws-dot green"></span>
              <span>aksesekolah.id</span>
              <span class="ws-tag">Education</span>
            </div>
            <div class="ws-project">
              <span class="ws-dot amber"></span>
              <span>pocat</span>
              <span class="ws-tag">AI Tool</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="ws-text">
      <span class="depth-tag dark"
        ><span class="teal">$</span> ./launch-workspace.sh</span
      >
      <h2>This Site Has a Workspace Mode</h2>
      <p>
        Built like a development environment, not a static portfolio. Command
        palette, keyboard shortcuts, and terminal-style navigation — the way I
        actually work, reflected in how I present my work.
      </p>
      <div class="ws-shortcuts">
        <kbd>Ctrl</kbd><span>+</span><kbd>K</kbd>
        <span class="shortcut-desc">— open Command Palette</span>
      </div>
      <a class="ws-btn" href="/workspace">
        Open Workspace Mode
        <svg
          fill="none"
          width="14"
          height="14"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- Latest Articles -->
<section class="articles-section">
  <div class="articles-container">
    <div class="articles-header">
      <div>
        <span class="depth-tag dark"
          ><span class="teal">$</span> tail -n3 blog/index.md</span
        >
        <h2>Latest Writing</h2>
      </div>
      <a class="view-all-link" href="/blog">All articles →</a>
    </div>
    <Posts posts={featuredPosts} />
  </div>
</section>

<!-- Footer CTA -->
<section class="footer-cta">
  <div class="fcta-container">
    <div class="fcta-inner">
      <div class="fcta-terminal">
        <span class="teal">$</span> ssh sandikodev@collaboration
      </div>
      <h2>Working on something interesting?</h2>
      <p>
        Open to discussions about system architecture, building SaaS from
        scratch, or reviewing infrastructure that's already in production.
      </p>
      <div class="fcta-actions">
        <a class="cta-main" href="/contact">Start a conversation →</a>
        <a class="cta-ghost" href="/portfolio">View Portfolio</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Global ─── */
  .teal {
    color: #4ecdc4;
  }

  /* ─── Boot Hero ─── */
  .hero-boot {
    position: relative;
    background: #0a0e1a;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .boot-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(78, 205, 196, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(78, 205, 196, 0.04) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(78, 205, 196, 0.15),
      transparent
    );
    animation: scan 8s linear infinite;
  }

  @keyframes scan {
    0% {
      top: -2px;
    }
    100% {
      top: 100%;
    }
  }

  .boot-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* Terminal */
  .terminal-panel {
    background: #0d1117;
    border: 1px solid rgba(78, 205, 196, 0.2);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 0 60px rgba(78, 205, 196, 0.06),
      0 24px 64px rgba(0, 0, 0, 0.6);
    font-family: "Fira Code", "SF Mono", monospace;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: #161b22;
    border-bottom: 1px solid rgba(78, 205, 196, 0.1);
  }

  .term-dots {
    display: flex;
    gap: 0.4rem;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot.red {
    background: #ff5f57;
  }
  .dot.yellow {
    background: #febc2e;
  }
  .dot.green {
    background: #28c840;
  }

  .term-title {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 auto;
  }

  .terminal-body {
    padding: 1.25rem 1.25rem 1.5rem;
    min-height: 260px;
  }

  .boot-line {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.8;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .boot-line.visible {
    opacity: 1;
  }
  .boot-line .ok {
    color: #28c840;
    font-weight: 700;
  }
  .highlight-line {
    color: rgba(255, 255, 255, 0.8);
    margin-top: 0.75rem;
  }
  .result-line {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
  }

  .boot-cursor-line {
    margin-top: 0.25rem;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .boot-cursor-line.visible {
    opacity: 1;
  }

  .boot-cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: #4ecdc4;
    animation: blink-cursor 1s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes blink-cursor {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* Hero Text */
  .hero-text {
    color: white;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(78, 205, 196, 0.3);
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4ecdc4;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ecdc4;
    animation: pulse-badge 2.5s infinite;
  }

  @keyframes pulse-badge {
    0% {
      box-shadow: 0 0 0 0 rgba(78, 205, 196, 0.5);
    }
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
    color: white;
  }

  .title-gradient {
    background: linear-gradient(135deg, #4ecdc4 0%, #667eea 60%, #f093fb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 2rem;
    max-width: 46ch;
  }

  .hero-desc strong {
    color: #4ecdc4;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 0.875rem;
    align-items: center;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .cta-main {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    background: #4ecdc4;
    color: #0a0e1a;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 20px rgba(78, 205, 196, 0.3);
  }

  .cta-main:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(78, 205, 196, 0.45);
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-ghost:hover {
    border-color: #4ecdc4;
    color: #4ecdc4;
    transform: translateY(-2px);
  }

  .hero-stats {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-n {
    font-size: 1.5rem;
    font-weight: 900;
    color: white;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-l {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 600;
    margin-top: 0.25rem;
  }

  .stat-div {
    width: 1px;
    height: 2rem;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ─── Depth Section ─── */
  .depth-section {
    background: #0d1117;
    padding: 5rem 0;
  }

  .depth-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .depth-header {
    margin-bottom: 2.5rem;
  }

  .depth-tag {
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
    display: block;
    margin-bottom: 0.75rem;
  }

  /* depth-tag on light/surface backgrounds */
  .depth-tag.dark {
    color: var(--color-text-muted);
  }

  .depth-header h2 {
    font-size: 2rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .depth-header p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .stack-layers {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .layer {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    transition: all 0.2s ease;
    cursor: default;
  }

  .layer:hover {
    background: rgba(78, 205, 196, 0.05);
    border-color: rgba(78, 205, 196, 0.2);
  }

  .active-layer {
    background: rgba(78, 205, 196, 0.06);
    border-color: rgba(78, 205, 196, 0.25);
  }

  .layer-num {
    font-family: "Fira Code", monospace;
    font-size: 0.68rem;
    font-weight: 800;
    color: #4ecdc4;
    text-align: center;
    background: rgba(78, 205, 196, 0.1);
    padding: 0.3rem 0.4rem;
    border-radius: 6px;
    letter-spacing: 0.03em;
  }

  .layer-content {
    flex: 1;
  }

  .layer-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.2rem;
  }

  .layer-desc {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.42);
    line-height: 1.5;
    margin-bottom: 0.4rem;
  }

  .layer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .layer-tags span {
    font-family: "Fira Code", monospace;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
