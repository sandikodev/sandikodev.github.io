---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Posts from "@/layouts/Posts.astro";
import { getAllPosts } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const posts = await getAllPosts();
const featuredPosts = posts.slice(0, 6);
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <h1>{config.metadata.meta_author}</h1>
    <p class="tagline">{config.metadata.tagline}</p>
    <p class="bio">
      Menulis tentang web development, infrastructure, dan continuous learning.
      10 tahun journey dari SMK ke DevOps.
    </p>
    <div class="hero-links">
      <a href="/blog" class="btn-primary">Read Blog</a>
      <a href="/now" class="btn-secondary">What I'm doing now →</a>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="posts-section">
    <div class="section-header">
      <h2>Latest Articles</h2>
      <a href="/blog" class="view-all">View all →</a>
    </div>
    <Posts posts={featuredPosts} />
  </section>

  <!-- About -->
  <section class="about-section">
    <p>
      Passionate tentang web technology dan open source. Percaya pada knowledge
      sharing dan building things that matter.
    </p>
    <div class="social-links">
      <a href={config.contactinfo.github} target="_blank">GitHub</a>
      <a href={config.contactinfo.linkedin} target="_blank">LinkedIn</a>
      <a href={`mailto:${config.contactinfo.email}`}>Email</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
    text-align: center;
  }

  .hero h1 {
    font-family: "Inter", sans-serif;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: #0a0a0a;
  }

  :global(.dark) .hero h1 {
    color: #fafafa;
  }

  .tagline {
    font-size: 1.25rem;
    color: #525252;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .tagline {
    color: #a3a3a3;
  }

  .bio {
    font-family: Georgia, serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: #525252;
    margin-bottom: 2rem;
  }

  :global(.dark) .bio {
    color: #a3a3a3;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    font-family: "Inter", sans-serif;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    background: #0a0a0a;
    color: #fafafa;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  :global(.dark) .btn-primary {
    background: #fafafa;
    color: #0a0a0a;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    font-family: "Inter", sans-serif;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    color: #525252;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  :global(.dark) .btn-secondary {
    color: #a3a3a3;
  }

  .btn-secondary:hover {
    color: #0a0a0a;
  }

  :global(.dark) .btn-secondary:hover {
    color: #fafafa;
  }

  .posts-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-family: "Inter", sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #0a0a0a;
    margin: 0;
  }

  :global(.dark) .section-header h2 {
    color: #fafafa;
  }

  .view-all {
    font-family: "Inter", sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #525252;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  :global(.dark) .view-all {
    color: #a3a3a3;
  }

  .view-all:hover {
    color: #0a0a0a;
  }

  :global(.dark) .view-all:hover {
    color: #fafafa;
  }

  .about-section {
    max-width: 680px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  :global(.dark) .about-section {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .about-section p {
    font-family: Georgia, serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: #525252;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .about-section p {
    color: #a3a3a3;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .social-links a {
    font-family: "Inter", sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #0a0a0a;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  :global(.dark) .social-links a {
    color: #fafafa;
  }

  .social-links a:hover {
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: 2.25rem;
    }
  }
</style>
