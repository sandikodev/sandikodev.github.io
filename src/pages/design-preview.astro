---
import Base from "@/layouts/Base.astro";
import "@/styles/design-system.css";
import "@/styles/preview.css";
---

<Base title="Design System Preview">
  <div class="container" style="max-width: 900px; padding: 4rem 1.5rem;">
    
    <div style="text-align: center; margin-bottom: 4rem;">
      <h1 style="margin-bottom: 1rem;">Design System Preview</h1>
      <p style="color: #6b7280;">Reader-First Blog Design System</p>
    </div>

    <section class="preview-section">
      <h2>Typography</h2>
      
      <div class="font-sample">
        <p class="font-label">Heading Font: Inter</p>
        <h3 style="margin-bottom: 0; font-family: Inter, sans-serif;">The quick brown fox jumps over the lazy dog</h3>
      </div>

      <div class="font-sample">
        <p class="font-label">Body Font: Georgia (Serif)</p>
        <p style="margin-bottom: 0; font-family: Georgia, serif;">
          The quick brown fox jumps over the lazy dog. This is how body text will look in articles. 
          Georgia provides excellent readability for long-form content.
        </p>
      </div>

      <div class="font-sample">
        <p class="font-label">Code Font: JetBrains Mono</p>
        <code style="font-family: monospace;">const greeting = "Hello, World!";</code>
      </div>

      <div style="margin-top: 2rem;">
        <h1>Heading 1</h1>
        <h2>Heading 2</h2>
        <h3>Heading 3</h3>
        <h4>Heading 4</h4>
        <h5>Heading 5</h5>
        <h6>Heading 6</h6>
      </div>
    </section>

    <section class="preview-section">
      <h2>Color Palette</h2>
      
      <h4 style="margin-top: 2rem; margin-bottom: 1rem;">Light Mode</h4>
      <div class="color-grid">
        <div class="color-box" style="background: #fafafa; color: #1a1a1a; border: 1px solid #e5e7eb;">
          <div>Background</div>
          <div>#FAFAFA</div>
        </div>
        <div class="color-box" style="background: #ffffff; color: #1a1a1a; border: 1px solid #e5e7eb;">
          <div>Surface</div>
          <div>#FFFFFF</div>
        </div>
        <div class="color-box" style="background: #1a1a1a; color: #ffffff;">
          <div>Text</div>
          <div>#1A1A1A</div>
        </div>
        <div class="color-box" style="background: #6b7280; color: #ffffff;">
          <div>Muted</div>
          <div>#6B7280</div>
        </div>
        <div class="color-box" style="background: #2563eb; color: #ffffff;">
          <div>Accent</div>
          <div>#2563EB</div>
        </div>
      </div>

      <h4 style="margin-top: 2rem; margin-bottom: 1rem;">Dark Mode</h4>
      <div class="color-grid">
        <div class="color-box" style="background: #0f0f0f; color: #e5e5e5;">
          <div>Background</div>
          <div>#0F0F0F</div>
        </div>
        <div class="color-box" style="background: #1a1a1a; color: #e5e5e5;">
          <div>Surface</div>
          <div>#1A1A1A</div>
        </div>
        <div class="color-box" style="background: #e5e5e5; color: #1a1a1a;">
          <div>Text</div>
          <div>#E5E5E5</div>
        </div>
        <div class="color-box" style="background: #9ca3af; color: #1a1a1a;">
          <div>Muted</div>
          <div>#9CA3AF</div>
        </div>
        <div class="color-box" style="background: #60a5fa; color: #1a1a1a;">
          <div>Accent</div>
          <div>#60A5FA</div>
        </div>
      </div>
    </section>

    <section class="preview-section">
      <h2>Content Elements</h2>
      
      <h3>Paragraph</h3>
      <p>
        This is a paragraph with <strong>bold text</strong>, <em>italic text</em>, and <a href="#">a link</a>. 
        The line height is set to 1.75 for comfortable reading.
      </p>

      <h3>Blockquote</h3>
      <blockquote>
        "The ADHD paradox: intensely focused on one thing, yet exploring every layer beneath it."
      </blockquote>

      <h3>Lists</h3>
      <ul>
        <li>Unordered list item one</li>
        <li>Unordered list item two</li>
        <li>Unordered list item three</li>
      </ul>

      <h3>Code</h3>
      <pre><code>const designSystem = &#123;
  typography: 'Inter + Georgia',
  colors: 'Soft & Comfortable'
&#125;;</code></pre>
    </section>

    <section class="preview-section">
      <h2>Spacing</h2>
      
      <div class="info-box">
        <p style="margin-bottom: 0;"><strong>Content Width:</strong> 680px optimal</p>
      </div>
      
      <div class="info-box">
        <p style="margin-bottom: 0;"><strong>Container:</strong> 1200px max</p>
      </div>
    </section>

    <section class="preview-section">
      <h2>Buttons</h2>
      
      <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem;">
        <a href="#" class="btn-demo btn-primary">Primary</a>
        <a href="#" class="btn-demo btn-secondary">Secondary</a>
      </div>
    </section>

    <section class="preview-section" style="border-bottom: none;">
      <h2>Dark Mode</h2>
      <p>Toggle dark mode di header untuk melihat perubahan warna.</p>
      
      <div class="info-box">
        <p style="margin-bottom: 0;">
          <strong>WCAG AA Compliant:</strong> Contrast ratio 4.5:1 minimum
        </p>
      </div>
    </section>

  </div>
</Base>
