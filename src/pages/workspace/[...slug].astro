---
import { getCollection, render } from "astro:content";

import Prompt from "@/components/terminal/svelte/Prompt.svelte";
import StatusLine from "@/components/terminal/svelte/StatusLine.svelte";
import TableOfContents from "@/components/terminal/svelte/TableOfContents.svelte";
import TerminalWindow from "@/components/terminal/svelte/TerminalWindow.svelte";
import WorkspaceNav from "@/components/terminal/svelte/WorkspaceNav.svelte";
import I3Layout from "@/layouts/I3Layout.astro";

export async function getStaticPaths() {
  try {
    const posts = await getCollection("posts");
    const templates = await getCollection("templates");
    const pages = await getCollection("pages");
    const about = await getCollection("about");

    const allPosts = [...posts, ...templates];

    const paths = [
      ...allPosts
        .filter((post) => !post.data.draft)
        .filter((post) => !["404", "about"].includes(post.id))
        .map((post) => ({
          params: { slug: `blog/${post.id.replace(/\.mdx?$/, "")}` },
          props: { entry: post, type: "post" },
        })),
      ...pages
        .filter((page) => !["404", "about"].includes(page.id))
        .map((page) => ({
          params: { slug: page.id.replace(/\.mdx?$/, "") },
          props: { entry: page, type: "page" },
        })),
      ...about
        .filter((entry) => entry.id !== "about")
        .map((entry) => ({
          params: { slug: entry.id.replace(/\.mdx?$/, "") },
          props: { entry, type: "about" },
        })),
    ];
    return paths;
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [];
  }
}

const { entry, type } = Astro.props;

let Content;
let headings: { depth: number; slug: string; text: string }[] = [];
try {
  const rendered = await render(entry);
  Content = rendered.Content;
  headings = rendered.headings;
} catch (error) {
  console.error("Error rendering content:", error);
  Content = () => "<p>Error loading content</p>";
}

const blogPath = Astro.url.pathname.replace("/workspace", "") || "/";
const canonicalUrl = `https://sandikodev.github.io${blogPath}`;
const title = entry.data.title;
---

<I3Layout title={`${title} | workspace`}>
  <link href={canonicalUrl} rel="canonical" slot="head" />
  <meta content={Astro.url.href} property="og:url" slot="head" />

  <div class="i3-split-h">
    <!-- TOC Column Wrapper -->
    <div class="i3-split-v column-outline">
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="outline"
      >
        <div slot="header" class="cli-header">
          <Prompt command="tree --outline" showCursor={true} />
        </div>
        <TableOfContents client:load headings={headings} />
      </TerminalWindow>
    </div>

    <!-- Main Content Column Wrapper -->
    <div class="i3-split-v column-main">
      <TerminalWindow
        client:load
        flush={true}
        focused={true}
        onClose={() =>
          (window.location.href =
            type === "post" ? "/workspace/blog" : "/workspace")}
        showCursor={true}
        title={`nvim — ${entry.id}.md`}
      >
        <div slot="header">
          <Prompt command={`nvim ${entry.id}.md`} showCursor={false} />
        </div>

        <article class="workspace-article">
          <header class="article-header">
            <h1>{title}</h1>
            {
              "date" in entry.data && entry.data.date && (
                <time class="article-date">
                  {new Date(entry.data.date).toLocaleDateString("en-US", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </time>
              )
            }
            {
              "categories" in entry.data && entry.data.categories && (
                <div class="article-tags">
                  {entry.data.categories.map((cat: string) => (
                    <span class="tag">{cat}</span>
                  ))}
                </div>
              )
            }
          </header>

          <div class="article-content">
            <Content />
          </div>
        </article>

        <StatusLine
          client:load
          filePath={`src/content/${type}s/${entry.id}.md`}
          fileType="markdown"
          mode="NORMAL"
          slot="footer"
        />
      </TerminalWindow>
    </div>

    <!-- Utils Column Wrapper -->
    <div class="i3-split-v column-utils">
      <TerminalWindow client:load showCursor={false} title="navigation">
        <div slot="header">
          <Prompt command="cat ~/.config/nav" showCursor={false} />
        </div>
        <WorkspaceNav client:load />
      </TerminalWindow>

      <TerminalWindow client:load showCursor={false} title="metadata">
        <div class="info-content">
          <div class="info-item">
            <span class="info-label">type:</span>
            <span class="info-value">{type}</span>
          </div>
          <div class="info-item">
            <span class="info-label">mode:</span>
            <span class="info-value">dev 💻</span>
          </div>
          <div class="info-item">
            <span class="info-label">id:</span>
            <span class="info-value">{entry.id}</span>
          </div>
          <div class="info-item">
            <span class="info-label">url:</span>
            <a class="info-link" href={blogPath}>{blogPath}</a>
          </div>
        </div>
      </TerminalWindow>
    </div>
  </div>
</I3Layout>

<style>
  /* Base Proportions - Precisely tuned to match user's visual reference */
  .column-outline {
    flex: 1.1 0 0%;
    min-width: 350px;
  }

  .column-main {
    flex: 2.7 0 0%;
    min-width: 400px;
  }

  .column-utils {
    flex: 0.75 0 0%;
    min-width: 220px;
  }

  /* Article Styling */
  .workspace-article {
    padding: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
  }

  .article-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--blue, #7aa2f7);
    margin: 0 0 0.75rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .article-date {
    display: block;
    font-size: 0.9rem;
    color: var(--text-muted, #565f89);
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }

  .article-tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .tag {
    background: rgba(122, 162, 247, 0.1);
    color: #7aa2f7;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    border: 1px solid rgba(122, 162, 247, 0.2);
    font-family: var(--font-mono);
  }

  .article-content {
    line-height: 1.8;
    font-size: 1.05rem;
    color: var(--text-primary, #a9b1d6);
  }

  .article-content :global(h2) {
    color: var(--blue);
    margin-top: 3.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.6rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    font-weight: 700;
  }

  .article-content :global(h3) {
    color: var(--green);
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .article-content :global(p) {
    margin: 1.5rem 0;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--magenta);
    background: rgba(187, 154, 247, 0.05);
    margin: 2rem 0;
    padding: 1.5rem;
    color: var(--text-secondary);
    font-style: italic;
    border-radius: 0 8px 8px 0;
  }

  .article-content :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: all 0.2s;
  }

  .article-content :global(a:hover) {
    color: var(--cyan);
    text-shadow: 0 0 8px rgba(122, 162, 247, 0.3);
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .info-content {
    padding: 12px 16px;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
  }

  .info-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .info-label {
    opacity: 0.6;
    color: var(--text-muted);
  }

  .info-value {
    color: var(--green);
    text-align: right;
  }

  .info-link {
    color: var(--blue);
    text-decoration: none;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: right;
  }

  .info-link:hover {
    text-decoration: underline;
    color: var(--cyan);
  }

  .cli-header {
    margin-bottom: 4px;
    padding-left: 2px;
  }
</style>
