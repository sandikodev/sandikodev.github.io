---
import Prompt from "@/components/terminal/svelte/Prompt.svelte";
import TerminalWindow from "@/components/terminal/svelte/TerminalWindow.svelte";
import I3Layout from "@/layouts/I3Layout.astro";

const canonicalUrl = "https://sandikodev.github.io/workspace/about";
---

<I3Layout title="about | dev@sandikodev">
  <link href={canonicalUrl} rel="canonical" slot="head" />

  <div class="i3-split-h">
    <!-- Left Column: Main Info -->
    <div class="i3-split-v" style="flex: 2;">
      <!-- Whoami Section -->
      <TerminalWindow client:load focused={true} title="whoami — sandikodev">
        <div slot="header">
          <Prompt command="whoami" showCursor={false} />
        </div>

        <div class="info-section">
          <div class="ascii-avatar">
            <pre>
    .-""""""-.
  .'          '.
 /   O      O   \
:                :
|                |
:    \______/    :
 \              /
  '-.__  __.-'
       `"`
            </pre>
          </div>

          <div class="bio">
            <h2>Sandiko <span class="tag">@sandikodev</span></h2>
            <p class="role">Full-Stack Engineer • Solutions Architect</p>

            <div class="quick-facts">
              <div class="fact">
                <span class="key">Location:</span>
                <span class="value">🇮🇩 Indonesia</span>
              </div>
              <div class="fact">
                <span class="key">Email:</span>
                <span class="value">
                  <a href="mailto:androxoss@hotmail.com"
                    >androxoss@hotmail.com</a
                  >
                </span>
              </div>
              <div class="fact">
                <span class="key">GitHub:</span>
                <span class="value">
                  <a
                    href="https://github.com/sandikodev"
                    rel="noopener"
                    target="_blank"
                  >
                    github.com/sandikodev
                  </a>
                </span>
              </div>
              <div class="fact">
                <span class="key">Experience:</span>
                <span class="value">8+ years (2016—now)</span>
              </div>
            </div>
          </div>
        </div>
      </TerminalWindow>

      <!-- Tech Stack Details -->
      <TerminalWindow client:load showCursor={false} title="tech-stack.json">
        <Prompt command="cat ~/.config/tech-stack.json" showCursor={false} />

        <div class="json-output">
          <pre><code class="language-json">{`{
  "frontend": {
    "frameworks": ["React", "Svelte 5", "Next.js", "Astro", "Qwik"],
    "languages": ["TypeScript", "JavaScript"],
    "styling": ["Tailwind CSS", "Vanilla CSS", "CSS-in-JS"],
    "stateManagement": ["Zustand", "Svelte Stores", "TanStack Query"]
  },
  "backend": {
    "languages": ["Node.js", "Go", "Python"],
    "frameworks": ["Express", "Fastify", "Laravel", "FastAPI"],
    "apis": ["REST", "GraphQL", "gRPC", "WebSocket"]
  },
  "database": {
    "relational": ["PostgreSQL", "MySQL"],
    "nosql": ["MongoDB", "Redis"],
    "orm": ["Prisma", "Drizzle", "TypeORM"]
  },
  "devops": {
    "cloud": ["AWS (EC2, S3, RDS, Lambda)", "Tencent Cloud"],
    "containerization": ["Docker", "Docker Compose"],
    "ci_cd": ["GitHub Actions", "GitLab CI"],
    "monitoring": ["Grafana", "PM2", "CloudWatch"]
  },
  "tools": {
    "versionControl": ["Git", "GitHub", "GitLab"],
    "editors": ["VS Code", "Neovim"],
    "os": ["Linux (Arch, Ubuntu)", "macOS"],
    "terminal": ["zsh", "tmux", "i3wm"]
  }
}`}</code></pre>
        </div>
      </TerminalWindow>
    </div>

    <!-- Right Column: Journey & Current -->
    <div class="i3-split-v" style="flex: 1.2;">
      <!-- Career Timeline -->
      <TerminalWindow client:load showCursor={false} title="git log --oneline">
        <Prompt command="git log --all --graph --oneline" showCursor={false} />

        <div class="timeline">
          <div class="commit active">
            <span class="hash">2024-now</span>
            <span class="msg">Solutions Architect & Tech Lead</span>
          </div>
          <div class="commit">
            <span class="hash">2021-24</span>
            <span class="msg">Full-Stack Engineer + DevOps</span>
          </div>
          <div class="commit">
            <span class="hash">2018-21</span>
            <span class="msg">Frontend → Backend → Full-Stack</span>
          </div>
          <div class="commit">
            <span class="hash">2016-18</span>
            <span class="msg">IT Support → Network → SysAdmin</span>
          </div>
        </div>

        <div class="journey-story">
          <p>
            <strong>Layer by Layer:</strong> Dimulai dari rakit PC dan troubleshooting
            hardware, naik ke network configuration, kemudian Linux system administration.
            Dari situ ke web development, backend APIs, dan sekarang merancang full-stack
            solutions dengan cloud infrastructure.
          </p>
        </div>
      </TerminalWindow>

      <!-- Current Projects -->
      <TerminalWindow
        client:load
        showCursor={false}
        title="./current-projects.sh"
      >
        <Prompt command="./current-projects.sh --list" showCursor={false} />

        <div class="projects-list">
          <div class="project-item">
            <div class="project-header">
              <span class="icon">☁️</span>
              <strong>AwanKinton</strong>
              <span class="badge">Live</span>
            </div>
            <p>Cloud hosting platform (AWS/Tencent reseller)</p>
            <div class="tech-tags">
              <span>Laravel</span>
              <span>React</span>
              <span>AWS SDK</span>
            </div>
          </div>

          <div class="project-item">
            <div class="project-header">
              <span class="icon">🎓</span>
              <strong>Akses Sekolah Digital</strong>
              <span class="badge">Live</span>
            </div>
            <p>School management SaaS platform</p>
            <div class="tech-tags">
              <span>Next.js</span>
              <span>PostgreSQL</span>
              <span>Prisma</span>
            </div>
          </div>

          <div class="project-item">
            <div class="project-header">
              <span class="icon">🤖</span>
              <strong>We Will Shine EdTech</strong>
              <span class="badge">Dev</span>
            </div>
            <p>LLM proxy with Socratic learning method</p>
            <div class="tech-tags">
              <span>Node.js</span>
              <span>OpenAI</span>
              <span>Redis</span>
            </div>
          </div>
        </div>
      </TerminalWindow>

      <!-- Philosophy -->
      <TerminalWindow client:load showCursor={false} title="philosophy.md">
        <Prompt command="cat ~/philosophy.md" showCursor={false} />

        <div class="philosophy">
          <h3># How I Think About Code</h3>

          <div class="principle">
            <strong>🔍 Understand the Stack</strong>
            <p>
              From hardware to application layer. Better debugging, better
              architecture.
            </p>
          </div>

          <div class="principle">
            <strong>📐 Design First, Code Later</strong>
            <p>Solid architecture prevents technical debt.</p>
          </div>

          <div class="principle">
            <strong>🚀 Ship MVP, Iterate Fast</strong>
            <p>Real feedback beats perfect code.</p>
          </div>

          <div class="principle">
            <strong>📖 Document Everything</strong>
            <p>Future you (and your team) will thank you.</p>
          </div>
        </div>
      </TerminalWindow>
    </div>
  </div>
</I3Layout>

<style>
  /* Info Section */
  .info-section {
    display: flex;
    gap: 2rem;
    margin: 1rem 0;
  }

  .ascii-avatar {
    flex-shrink: 0;
  }

  .ascii-avatar pre {
    font-size: 0.7rem;
    line-height: 1.2;
    color: var(--accent, #7aa2f7);
    margin: 0;
  }

  .bio h2 {
    font-size: 1.5rem;
    margin: 0 0 0.25rem;
    color: var(--text-primary);
  }

  .tag {
    font-size: 0.9rem;
    opacity: 0.7;
    font-weight: normal;
  }

  .role {
    color: var(--accent, #7aa2f7);
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
  }

  .quick-facts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fact {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .fact .key {
    color: var(--text-muted);
    min-width: 90px;
  }

  .fact .value {
    color: var(--text-primary);
  }

  .fact a {
    color: var(--accent, #7aa2f7);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .fact a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* JSON Output */
  .json-output {
    margin: 1rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .json-output pre {
    margin: 0;
  }

  .json-output code {
    color: var(--text-primary);
  }

  /* Timeline */
  .timeline {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .commit {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
    padding: 0.5rem;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .commit:hover {
    background: rgba(122, 162, 247, 0.1);
  }

  .commit.active {
    background: rgba(122, 162, 247, 0.15);
  }

  .commit .hash {
    color: var(--yellow, #e0af68);
    font-weight: 600;
    min-width: 70px;
  }

  .commit .msg {
    color: var(--text-primary);
  }

  .journey-story {
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(122, 162, 247, 0.05);
    border-left: 3px solid var(--accent, #7aa2f7);
    border-radius: 4px;
  }

  .journey-story p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .journey-story strong {
    color: var(--accent, #7aa2f7);
  }

  /* Projects List */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1rem 0;
  }

  .project-item {
    padding: 1rem;
    background: rgba(122, 162, 247, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(122, 162, 247, 0.2);
    transition: all 0.2s;
  }

  .project-item:hover {
    background: rgba(122, 162, 247, 0.1);
    border-color: rgba(122, 162, 247, 0.4);
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .project-header .icon {
    font-size: 1.2rem;
  }

  .project-header strong {
    flex: 1;
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .badge {
    background: var(--green, #9ece6a);
    color: var(--bg, #1a1b26);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .badge:not(:first-of-type) {
    background: var(--orange, #ff9e64);
  }

  .project-item p {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tags span {
    background: rgba(122, 162, 247, 0.15);
    color: var(--accent, #7aa2f7);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  /* Philosophy */
  .philosophy h3 {
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
    color: var(--accent, #7aa2f7);
  }

  .principle {
    margin-bottom: 1.25rem;
  }

  .principle strong {
    display: block;
    color: var(--text-primary);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .principle p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .info-section {
      flex-direction: column;
      gap: 1rem;
    }

    .ascii-avatar pre {
      font-size: 0.6rem;
    }

    .fact {
      flex-direction: column;
      gap: 0.25rem;
    }

    .fact .key {
      min-width: auto;
      font-weight: 600;
    }
  }
</style>
