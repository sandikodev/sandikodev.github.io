---
import AsciiHero from "@/components/terminal/AsciiHero.astro";
import Prompt from "@/components/terminal/svelte/Prompt.svelte";
import TerminalWindow from "@/components/terminal/svelte/TerminalWindow.svelte";
import WorkspaceNav from "@/components/terminal/svelte/WorkspaceNav.svelte";
import I3Layout from "@/layouts/I3Layout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const posts = await getSinglePage("posts");
const recentPosts = posts
  .filter((post: any) => !post.data.draft)
  .sort(
    (a: any, b: any) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 5);

const skills = {
  backend: [
    { focus: "Architecture", name: "Node.js", proficiency: "Expert" },
    { focus: "API Design", name: "FastAPI", proficiency: "Advanced" },
    { focus: "Optimization", name: "PostgreSQL", proficiency: "Expert" },
    { focus: "Caching", name: "Redis", proficiency: "Advanced" },
  ],
  frontend: [
    { focus: "UI Architecture", name: "React", proficiency: "Expert" },
    { focus: "SSR/Static", name: "Next.js", proficiency: "Expert" },
    { focus: "Type Safety", name: "TypeScript", proficiency: "Expert" },
    { focus: "Design Systems", name: "Tailwind", proficiency: "Expert" },
  ],
  infrastructure: [
    { focus: "Containerization", name: "Docker", proficiency: "Expert" },
    { focus: "Orchestration", name: "K8s", proficiency: "Advanced" },
    { focus: "Cloud Services", name: "AWS", proficiency: "Intermediate" },
    { focus: "Administration", name: "Linux", proficiency: "Expert" },
  ],
  tools: [
    { focus: "Development Workflow", name: "NeoVim", proficiency: "Expert" },
    { focus: "Productivity", name: "i3wm", proficiency: "Expert" },
    { focus: "Version Control", name: "Git", proficiency: "Expert" },
  ],
};
---

<I3Layout title="dev@enigma | i3wm">
  <div class="i3-split-h">
    <!-- Left: Main + Skills (65%) -->
    <div class="i3-split-v" style="flex: 1.8;">
      <!-- Main terminal -->
      <TerminalWindow
        client:load
        flush={true}
        focused={true}
        showCursor={true}
        title="alacritty — dev@enigma:~"
      >
        <div class="terminal-scrollback">
          <Prompt command="neofetch" showCursor={false} />
          <AsciiHero />

          <div class="motd">
            <Prompt command="cat /etc/motd" showCursor={false} />
            <div class="motd-box">
              <p class="motd-title">👋 Welcome to my digital workspace</p>
              <p class="motd-text">
                Full-stack developer passionate about clean code, terminal
                workflows, and building things that matter.
              </p>
              <p class="motd-quote">
                "First, solve the problem. Then, write the code." — John Johnson
              </p>
            </div>
          </div>

          <Prompt command="htop" showCursor={false} />
          <div class="htop-bar">
            <div class="htop-item">
              <span class="htop-label">CPU</span>
              <div class="htop-progress">
                <div class="htop-fill cpu" style="width: 23%"></div>
              </div>
              <span class="htop-value">23%</span>
            </div>
            <div class="htop-item">
              <span class="htop-label">MEM</span>
              <div class="htop-progress">
                <div class="htop-fill mem" style="width: 45%"></div>
              </div>
              <span class="htop-value">4.2G/8G</span>
            </div>
            <div class="htop-item">
              <span class="htop-label">SWP</span>
              <div class="htop-progress">
                <div class="htop-fill swp" style="width: 5%"></div>
              </div>
              <span class="htop-value">0.2G/4G</span>
            </div>
          </div>
        </div>
      </TerminalWindow>

      <!-- Skills window -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="cat ~/.config/skills.json | jq"
      >
        <div class="skills-scroll-container">
          <div class="skills-grid">
            {
              Object.entries(skills).map(([category, items]) => (
                <div class="skill-category">
                  <div class="category-line">
                    <>
                      <span class="skill-key">"{category}"</span>
                      <span class="skill-colon">:</span>
                    </>{" "}
                    <span class="skill-bracket">[</span>
                  </div>
                  <div class="items-block" style="padding-left: 1.5rem;">
                    {items.map((item, i) => (
                      <div class="item-line">
                        <span class="skill-bracket">{"{"}</span>
                        <span class="skill-key">"name"</span>:{" "}
                        <span class="skill-value">"{item.name}"</span>,
                        <span class="skill-key">"proficiency"</span>:{" "}
                        <span class="skill-value">"{item.proficiency}"</span>,
                        <span class="skill-key">"focus"</span>:{" "}
                        <span class="skill-value">"{item.focus}"</span>
                        <span class="skill-bracket">{"}"}</span>
                        {i < items.length - 1 ? (
                          <span class="skill-comma">,</span>
                        ) : (
                          ""
                        )}
                      </div>
                    ))}
                  </div>
                  <>
                    <span class="skill-bracket">]</span>
                    <span class="skill-comma">,</span>
                  </>
                </div>
              ))
            }
          </div>
        </div>
      </TerminalWindow>
    </div>

    <!-- Right: Posts + Links + Clock (35%) -->
    <div class="i3-split-v" style="flex: 1;">
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="navigation"
      >
        <div slot="header">
          <Prompt command="cat ~/.config/nav" showCursor={false} />
        </div>
        <WorkspaceNav client:load />
      </TerminalWindow>

      <!-- Recent posts -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="ranger — ~/blog/posts"
      >
        <div class="ranger">
          <div class="ranger-header">
            <span class="ranger-path">~/blog/posts</span>
            <span class="ranger-info">
              {recentPosts.length} items
            </span>
          </div>
          <div class="ranger-list">
            {
              recentPosts.map((post: any, i: number) => (
                <a
                  class={`ranger-item ${i === 0 ? "selected" : ""}`}
                  href={`/workspace/blog/${post.id}`}
                >
                  <span class="ranger-icon">📄</span>
                  <span class="ranger-name">{post.id}.md</span>
                  <span class="ranger-date">
                    {post.data.date?.toISOString().split("T")[0]}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </TerminalWindow>

      <!-- Links -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="cat ~/.local/share/bookmarks"
      >
        <div class="bookmarks">
          <a
            class="bookmark"
            href="https://github.com/sandikodev"
            target="_blank"
          >
            <span class="bm-icon">📦</span>
            <span class="bm-name">GitHub</span>
            <span class="bm-url">github.com/sandikodev</span>
          </a>
          <a
            class="bookmark"
            href="https://linkedin.com/in/sandikodev"
            target="_blank"
          >
            <span class="bm-icon">💼</span>
            <span class="bm-name">LinkedIn</span>
            <span class="bm-url">linkedin.com/in/sandikodev</span>
          </a>
          <a class="bookmark" href="mailto:androxoss@hotmail.com">
            <span class="bm-icon">📧</span>
            <span class="bm-name">Email</span>
            <span class="bm-url">androxoss@hotmail.com</span>
          </a>
        </div>
      </TerminalWindow>

      <!-- Clock widget -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="tty-clock -c"
      >
        <div class="clock-widget">
          <div class="clock-time" id="clock-time">00:00:00</div>
          <div class="clock-date" id="clock-date">Monday, January 1, 2025</div>
          <div class="clock-uptime">
            uptime:
            <span id="uptime">0d 0h 0m</span>
          </div>
        </div>
      </TerminalWindow>
    </div>

    <!-- Scratchpad -->
    <div class="i3-scratchpad" id="scratchpad">
      <div class="sp-window">
        <div class="sp-title">📋 scratchpad — mod+shift+minus to hide</div>
        <textarea
          class="sp-input"
          placeholder="# Quick notes
 
Type anything here..."></textarea>
      </div>
    </div>
  </div>
</I3Layout>

<style>
  .terminal-scrollback {
    padding: 16px;
  }

  .skills-scroll-container {
    padding: 16px;
  }

  /* MOTD */
  .motd-box {
    background: linear-gradient(
      135deg,
      rgba(122, 162, 247, 0.1),
      rgba(187, 154, 247, 0.1)
    );
    border-left: 3px solid var(--blue, #7aa2f7);
    padding: 12px 16px;
    margin: 8px 0;
  }
  .motd-title {
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .motd-text {
    color: var(--text-secondary);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .motd-quote {
    color: var(--magenta, #bb9af7);
    font-style: italic;
    font-size: 12px;
  }

  /* htop bars */
  .htop-bar {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 0;
  }
  .htop-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .htop-label {
    color: var(--cyan, #7dcfff);
    width: 32px;
  }
  .htop-progress {
    flex: 1;
    height: 10px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
  }
  .htop-fill {
    height: 100%;
    transition: width 0.3s;
  }
  .htop-fill.cpu {
    background: linear-gradient(90deg, #9ece6a, #e0af68);
  }
  .htop-fill.mem {
    background: linear-gradient(90deg, #7aa2f7, #7dcfff);
  }
  .htop-fill.swp {
    background: #bb9af7;
  }
  .htop-value {
    color: var(--text-muted);
    width: 70px;
    text-align: right;
    font-size: 11px;
  }

  /* Skills */
  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
    font-family: var(--font-mono);
    line-height: 1.4;
  }
  .skill-category {
    display: flex;
    flex-direction: column;
  }
  .item-line {
    padding: 2px 0;
    white-space: nowrap;
  }
  .skill-key {
    color: #7aa2f7;
  }
  .skill-colon {
    color: var(--text-muted);
  }
  .skill-bracket {
    color: #e0af68;
  }
  .skill-value {
    color: #9ece6a;
  }
  .skill-comma {
    color: var(--text-muted);
  }

  /* Ranger file manager */
  .ranger {
    font-size: 12px;
    padding: 12px;
  }
  .ranger-header {
    display: flex;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 8px;
  }
  .ranger-path {
    color: #7aa2f7;
    font-weight: 500;
  }
  .ranger-info {
    color: var(--text-muted);
  }
  .ranger-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ranger-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 4px;
  }
  .ranger-item:hover,
  .ranger-item.selected {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }
  .ranger-item.selected {
    border-left: 2px solid #7aa2f7;
  }
  .ranger-icon {
    font-size: 14px;
  }
  .ranger-name {
    flex: 1;
    color: #7dcfff;
  }
  .ranger-item:hover .ranger-name {
    text-decoration: underline;
  }
  .ranger-date {
    color: var(--text-muted);
    font-size: 11px;
  }

  /* Bookmarks */
  .bookmarks {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
  }
  .bookmark {
    display: grid;
    grid-template-columns: 24px 70px 1fr;
    align-items: center;
    gap: 8px;
    padding: 8px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 4px;
    font-size: 12px;
  }
  .bookmark:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }
  .bm-icon {
    font-size: 14px;
  }
  .bm-name {
    color: #9ece6a;
    font-weight: 500;
  }
  .bm-url {
    color: var(--text-muted);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Clock */
  .clock-widget {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 8px;
    padding: 16px;
  }
  .clock-time {
    font-size: 2.5rem;
    font-weight: 700;
    color: #7dcfff;
    font-variant-numeric: tabular-nums;
    letter-spacing: 2px;
  }
  .clock-date {
    color: var(--text-secondary);
    font-size: 13px;
  }
  .clock-uptime {
    color: var(--text-muted);
    font-size: 11px;
  }

  /* Scratchpad */
  .sp-window {
    background: #1a1b26;
    border: 2px solid #364a82;
    width: 550px;
    height: 350px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .sp-title {
    padding: 6px 12px;
    background: #364a82;
    color: #a9b1d6;
    font-size: 12px;
    font-weight: 600;
  }
  .sp-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    resize: none;
    padding: 16px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .ranger-date {
      display: none;
    }
    .bm-url {
      display: none;
    }
    .bookmark {
      grid-template-columns: 24px 1fr;
    }
    .clock-time {
      font-size: 1.8rem;
    }
  }
</style>

<script>
  // Live clock
  function updateClock() {
    const now = new Date();
    const time = now.toLocaleTimeString("en-US", { hour12: false });
    const date = now.toLocaleDateString("en-US", {
      day: "numeric",
      month: "long",
      weekday: "long",
      year: "numeric",
    });

    const timeEl = document.getElementById("clock-time");
    const dateEl = document.getElementById("clock-date");
    if (timeEl) timeEl.textContent = time;
    if (dateEl) dateEl.textContent = date;
  }

  // Fake uptime
  let uptimeMinutes = Math.floor(Math.random() * 1000) + 100;
  function updateUptime() {
    uptimeMinutes++;
    const days = Math.floor(uptimeMinutes / 1440);
    const hours = Math.floor((uptimeMinutes % 1440) / 60);
    const mins = uptimeMinutes % 60;
    const el = document.getElementById("uptime");
    if (el) el.textContent = `${days}d ${hours}h ${mins}m`;
  }

  updateClock();
  updateUptime();
  setInterval(updateClock, 1000);
  setInterval(updateUptime, 60000);
</script>
