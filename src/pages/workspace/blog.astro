---
import BlogList from "@/components/terminal/svelte/BlogList.svelte";
import BlogPreview from "@/components/terminal/svelte/BlogPreview.svelte";
import CategoryTree from "@/components/terminal/svelte/CategoryTree.svelte";
import Prompt from "@/components/terminal/svelte/Prompt.svelte";
import TagCloud from "@/components/terminal/svelte/TagCloud.svelte";
import TerminalWindow from "@/components/terminal/svelte/TerminalWindow.svelte";
import WorkspaceNav from "@/components/terminal/svelte/WorkspaceNav.svelte";
import I3Layout from "@/layouts/I3Layout.astro";
import { getAllPosts } from "@/lib/contentParser.astro";

const allPosts = await getAllPosts();

const categoriesData = [
  ...new Set(allPosts.flatMap((p: any) => p.data.categories || [])),
].map((cat) => ({
  count: allPosts.filter((p: any) => p.data.categories?.includes(cat)).length,
  name: cat,
}));

const tags = [...new Set(allPosts.flatMap((p: any) => p.data.tags || []))];
---

<I3Layout title="Blog | dev@enigma">
  <div class="i3-split-h blog-layout">
    <!-- Left Sidebar: Categories & Tags (20%) -->
    <div class="i3-split-v sidebar" style="flex: 0.6; min-width: 0;">
      <!-- Navigation -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="navigation"
      >
        <div slot="header">
          <Prompt command="cat ~/.config/nav" showCursor={false} />
        </div>
        <WorkspaceNav client:load />
      </TerminalWindow>

      <!-- Categories -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="ls ~/blog/categories"
      >
        <div class="inner-content">
          <CategoryTree categories={categoriesData} client:load />
        </div>
      </TerminalWindow>

      <!-- Tags -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="cat ~/.tags"
      >
        <div class="inner-content">
          <TagCloud client:load tags={tags} />
        </div>
      </TerminalWindow>
    </div>

    <!-- Main: Blog Posts (43%) -->
    <div class="i3-split-v main-content" style="flex: 1.3; min-width: 0;">
      <TerminalWindow
        client:load
        flush={true}
        focused={true}
        showCursor={false}
        title="ranger ~/blog/posts"
      >
        <div class="blog-header" slot="header">
          <Prompt
            command="find ~/blog -type f -name '*.md' | wc -l"
            showCursor={false}
          />
          <div class="post-count">
            {allPosts.length} posts found
          </div>
        </div>

        <!-- Blog List -->
        <BlogList client:load posts={allPosts} />

        <!-- Fallback for non-JS users -->
        <noscript>
          <div class="post-list">
            {
              allPosts.slice(0, 10).map((post: any, i: number) => (
                <article class={`post-card ${i === 0 ? "selected" : ""}`}>
                  <a class="post-link" href={`/workspace/blog/${post.id}`}>
                    <div class="post-header">
                      <span class="post-icon">📄</span>
                      <h3 class="post-title">{post.data.title}</h3>
                    </div>

                    <div class="post-meta">
                      <span class="post-date">
                        📅{" "}
                        {post.data.date?.toLocaleDateString("en-US", {
                          day: "numeric",
                          month: "short",
                          year: "numeric",
                        })}
                      </span>
                      {post.data.authors && (
                        <span class="post-author">
                          👤 {post.data.authors[0]}
                        </span>
                      )}
                    </div>

                    {post.data.description && (
                      <p class="post-desc">{post.data.description}</p>
                    )}

                    <div class="post-footer">
                      <div class="post-tags">
                        {post.data.tags?.slice(0, 3).map((tag: string) => (
                          <span class="tag">#{tag}</span>
                        ))}
                      </div>
                      <span class="post-arrow">→</span>
                    </div>
                  </a>
                </article>
              ))
            }
          </div>
        </noscript>
      </TerminalWindow>
    </div>

    <!-- Right Sidebar: Stats & Info (37%) -->
    <div class="i3-split-v sidebar-right" style="flex: 1.1; min-width: 0;">
      <!-- Post Preview (Ranger style) -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="Preview — post_content.md"
      >
        <BlogPreview client:load />
      </TerminalWindow>

      <!-- Stats -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="cat ~/.blog_stats"
      >
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-icon">📝</div>
            <div class="stat-value">{allPosts.length}</div>
            <div class="stat-label">Posts</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">📁</div>
            <div class="stat-value">{categoriesData.length}</div>
            <div class="stat-label">Categories</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">🏷️</div>
            <div class="stat-value">{tags.length}</div>
            <div class="stat-label">Tags</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">👁️</div>
            <div class="stat-value">
              {Math.floor(Math.random() * 10000 + 5000).toLocaleString()}
            </div>
            <div class="stat-label">Views</div>
          </div>
        </div>
      </TerminalWindow>

      <!-- Recent Activity -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="tail -f ~/.blog_activity"
      >
        <div class="activity-feed">
          {
            allPosts.slice(0, 5).map((post: any) => (
              <div class="activity-item">
                <span class="activity-time">
                  {new Date(post.data.date).toLocaleDateString("en-US", {
                    day: "numeric",
                    month: "short",
                  })}
                </span>
                <span class="activity-text">
                  Published:{" "}
                  <a href={`/workspace/blog/${post.id}`}>{post.data.title}</a>
                </span>
              </div>
            ))
          }
        </div>
      </TerminalWindow>

      <!-- Quick Links -->
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="cat ~/.quicklinks"
      >
        <div class="quick-links">
          <a class="quick-link" href="/">
            <span class="ql-icon">🏠</span>
            <span class="ql-text">Home</span>
          </a>
          <a class="quick-link" href="/about">
            <span class="ql-icon">👤</span>
            <span class="ql-text">About</span>
          </a>
          <a class="quick-link" href="/workspace/terminal">
            <span class="ql-icon">💻</span>
            <span class="ql-text">Terminal</span>
          </a>
        </div>
      </TerminalWindow>
    </div>
  </div>
</I3Layout>

<style>
  /* Global Content Spacing Fix */
  .inner-content {
    padding: 12px 16px;
  }

  /* Virtual Scroll Styles */
  .post-list-virtual {
    flex: 1;
    overflow: hidden;
  }

  .post-list-virtual .virtual-item-content {
    padding: 0;
  }

  /* Navigation Sidebar */
  .nav-content,
  .info-content {
    padding: 1rem;
    font-size: 0.8125rem;
  }

  .workspace-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .workspace-nav a {
    color: var(--text-secondary);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .workspace-nav a:hover,
  .workspace-nav a.active {
    background: var(--bg-tertiary);
    color: var(--accent, var(--blue));
  }

  /* Blog Layout */
  .blog-layout {
    flex: 1;
    overflow: hidden;
  }

  /* Tree View Style */
  :global(.tree-view) {
    padding: 0 !important;
  }

  /* Blog Header */
  .blog-header {
    margin-bottom: 0;
    padding: 12px 16px 8px 16px;
    border-bottom: 1px solid var(--border);
  }

  .post-count {
    color: var(--green);
    font-size: 0.875rem;
    margin-top: 4px;
  }

  /* Post List Fallback Styles */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  .post-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 16px;
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-header {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 8px;
  }

  .post-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-desc {
    margin: 8px 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 16px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px;
    background: var(--bg-tertiary);
    border-radius: 6px;
    text-align: center;
  }

  .stat-icon {
    font-size: 1.5rem;
    margin-bottom: 6px;
  }
  .stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cyan);
  }
  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Activity Feed */
  .activity-feed {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
  }

  .activity-item {
    display: flex;
    gap: 8px;
    padding: 8px;
    background: var(--bg-tertiary);
    border-radius: 4px;
    font-size: 0.8125rem;
  }

  .activity-time {
    color: var(--text-muted);
    font-size: 0.75rem;
    min-width: 50px;
  }
  .activity-text a {
    color: var(--blue);
    text-decoration: none;
  }

  /* Quick Links */
  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .quick-link:hover {
    background: var(--blue);
    color: var(--i3-bg);
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .sidebar-right {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .blog-layout {
      flex-direction: column !important;
      overflow-y: auto;
    }
    .sidebar,
    .main-content {
      flex: 1 !important;
    }
  }
</style>
