---
import AsciiHero from "@/components/terminal/AsciiHero.astro";
import SkillsWebUI from "@/components/terminal/SkillsWebUI.astro";
import BrowserWindow from "@/components/terminal/svelte/BrowserWindow.svelte";
import Prompt from "@/components/terminal/svelte/Prompt.svelte";
import ShortcutVisualizer from "@/components/terminal/svelte/ShortcutVisualizer.svelte";
import TerminalWindow from "@/components/terminal/svelte/TerminalWindow.svelte";
import TypingAnimation from "@/components/terminal/svelte/TypingAnimation.svelte";
import WorkspaceNav from "@/components/terminal/svelte/WorkspaceNav.svelte";
import I3Layout from "@/layouts/I3Layout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const posts = await getSinglePage("posts");
const recentPosts = posts
  .filter((post: any) => !post.data.draft)
  .sort(
    (a: any, b: any) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 5);

const canonicalUrl = "https://sandikodev.github.io/";

const appShortcuts = [
  { action: "scroll down/up", category: "Navigation", key: "j/k" },
  { action: "go top/bottom", category: "Navigation", key: "gg/G" },
  { action: "toggle theme", category: "Appearance", key: "t" },
  { action: "show help", category: "Help", key: "?" },
  { action: "command palette", category: "System", key: "Alt+D" },
];
---

<I3Layout title="workspace | dev@sandikodev">
  <link href={canonicalUrl} rel="canonical" slot="head" />

  <div class="i3-split-h">
    <!-- Left: Main terminal (65%) -->
    <div class="i3-split-v" style="flex: 1.8;">
      <TerminalWindow
        client:load
        flush={true}
        focused={true}
        showCursor={true}
        title="alacritty — dev@sandikodev:~"
      >
        <!-- Unified Terminal Scrollback -->
        <div class="terminal-scrollback">
          <Prompt command="neofetch" showCursor={false} />
          <AsciiHero />

          <div class="motd">
            <Prompt command="cat /etc/motd" showCursor={false} />
            <div class="motd-box">
              <p class="motd-title">
                <TypingAnimation
                  client:load
                  delay={1000}
                  speed={80}
                  text="👋 Welcome to Dev Mode"
                />
              </p>
              <p class="motd-text">
                <TypingAnimation
                  client:load
                  cursor={false}
                  delay={3000}
                  speed={40}
                  text="Experience the blog in i3wm-style terminal interface."
                />
              </p>
              <p class="motd-quote">
                <TypingAnimation
                  client:load
                  cursor={false}
                  delay={5000}
                  speed={60}
                  text={'"The terminal is not just a tool, it\'s a lifestyle."'}
                />
              </p>
            </div>
          </div>

          <Prompt command="ls ~/blog" showCursor={false} />
          <div class="file-list">
            {
              recentPosts.map((post: any) => (
                <a class="file-item" href={`/workspace/blog/${post.id}`}>
                  <span class="file-icon">📄</span>
                  <span class="file-name">{post.data.title}</span>
                </a>
              ))
            }
          </div>
        </div>
      </TerminalWindow>

      <!-- Skills Browser Window -->
      <BrowserWindow
        client:load
        focused={false}
        title="Skills & Expertise"
        url="localhost:3000/skills"
      >
        <SkillsWebUI />
      </BrowserWindow>
    </div>

    <!-- Right: Navigation (35%) -->
    <div class="i3-split-v" style="flex: 1;">
      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="navigation"
      >
        <div slot="header">
          <Prompt command="cat ~/.config/nav" showCursor={false} />
        </div>
        <WorkspaceNav client:load />
      </TerminalWindow>

      <TerminalWindow
        client:load
        flush={true}
        showCursor={false}
        title="shortcuts — ?"
      >
        <ShortcutVisualizer client:load shortcuts={appShortcuts} />
      </TerminalWindow>
    </div>
  </div>
</I3Layout>

<style>
  .terminal-scrollback {
    padding: 16px;
  }

  .motd-box {
    margin: 0.5rem 0 1rem;
    padding: 0.75rem;
    border-left: 3px solid var(--accent, var(--color-terminal-accent));
    background: rgba(255, 255, 255, 0.03);
  }

  .motd-title {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .motd-text {
    opacity: 0.8;
    margin-bottom: 0.25rem;
  }

  .motd-quote {
    font-style: italic;
    opacity: 0.6;
    font-size: 0.85rem;
  }

  .file-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.5rem 0;
  }

  .file-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    color: var(--text-primary, var(--color-terminal-text));
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .file-item:hover {
    background: rgba(122, 162, 247, 0.1);
  }

  .file-icon {
    opacity: 0.7;
  }
</style>
