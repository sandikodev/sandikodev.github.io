---
import BrowserWindow from "@/components/terminal/svelte/BrowserWindow.svelte";
import Prompt from "@/components/terminal/svelte/Prompt.svelte";

import TerminalWindow from "@/components/terminal/svelte/TerminalWindow.svelte";
import TypingAnimation from "@/components/terminal/svelte/TypingAnimation.svelte";
import WorkspaceNav from "@/components/terminal/svelte/WorkspaceNav.svelte";
import TerminalLoader from "@/components/terminal/TerminalLoader.astro";
import I3Layout from "@/layouts/I3Layout.astro";

const currentPath = Astro.url.pathname;
---

<I3Layout title="404 - Target Not Found | dev@enigma">
  <div class="i3-split-h error-page">
    <!-- Main Error Window (Browser now) -->
    <div class="i3-split-v" style="flex: 2;">
      <div class="browser-report-container" style="flex: 1;">
        <BrowserWindow
          background="#ffffff"
          client:load
          focused={true}
          _minimal={true}
          title="localhost:3000/error"
        >
          <div class="web-ui-error">
            <div class="web-status-header">
              <span class="web-status-label">STATUS</span>
              <h2 class="web-status-code">404</h2>
            </div>
            <p class="web-error-desc">
              The requested resource could not be mapped to any existing node in
              the workspace tree.
            </p>
            <div class="web-trace-section">
              <div class="web-trace-header">DUMP_STACK_TRACE // FAILURE</div>
              <div class="web-trace-lines">
                <div class="web-trace-item">
                  [0x00404] koda::router::match_failed
                </div>
                <div class="web-trace-item"></div>
                <div class="web-trace-item">
                  [0x00404] i3wm::layout::mount_fallback
                </div>
                <div class="web-trace-item">
                  [0x00404] system::interrupt::page_fault
                </div>
              </div>
            </div>
          </div>
        </BrowserWindow>
      </div>
    </div>

    <!-- Sidebar Info (Terminal now) -->
    <div class="i3-split-v" style="flex: 1;">
      <TerminalWindow client:load showCursor={false} title="navigation">
        <div slot="header">
          <Prompt command="cat ~/.config/nav" showCursor={false} />
        </div>
        <WorkspaceNav client:load />
      </TerminalWindow>

      <TerminalWindow
        client:load
        focused={false}
        showCursor={true}
        title="zsh — loader.sh"
      >
        <div class="prompt-typing-container" slot="header">
          <Prompt showCursor={false} />
          <div class="typing-command-wrapper">
            <TypingAnimation
              client:load
              delay={500}
              speed={60}
              text={`./load_page "${currentPath}"`}
            />
          </div>
        </div>

        <TerminalLoader />

        <div class="bash-error">
          <span class="error-prefix">zsh:</span> no such file or directory: {
            currentPath
          }
        </div>

        <div class="suggestions">
          <Prompt command="ls /workspace" showCursor={false} />
          <div class="suggestion-grid">
            <a class="sugg-item" href="/workspace">
              <span class="sugg-icon">🏠</span>
              <span class="sugg-name">~/home</span>
            </a>
            <a class="sugg-item" href="/workspace/blog">
              <span class="sugg-icon">📝</span>
              <span class="sugg-name">~/blog</span>
            </a>
            <a class="sugg-item" href="/workspace/about">
              <span class="sugg-icon">👤</span>
              <span class="sugg-name">~/about</span>
            </a>
            <a class="sugg-item" href="/workspace/skills">
              <span class="sugg-icon">📊</span>
              <span class="sugg-name">~/skills</span>
            </a>
          </div>
        </div>
      </TerminalWindow>
    </div>
  </div>
</I3Layout>

<style>
  .error-page {
    height: calc(100vh - 28px);
  }

  .prompt-typing-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .typing-command-wrapper {
    flex: 1;
  }

  .bash-error {
    color: var(--text-primary);
    background: rgba(247, 118, 142, 0.1);
    border-left: 3px solid var(--red, #f7768e);
    padding: 12px 16px;
    font-size: 0.9rem;
    margin: 1rem 0;
  }

  .error-prefix {
    color: var(--red, #f7768e);
    font-weight: 700;
  }

  .suggestion-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 10px;
  }

  .sugg-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .sugg-item:hover {
    border-color: var(--blue, #7aa2f7);
    background: rgba(122, 162, 247, 0.05);
    transform: translateY(-2px);
  }

  .sugg-icon {
    font-size: 1.25rem;
  }

  .sugg-name {
    color: var(--cyan, #7dcfff);
    font-weight: 600;
    font-size: 0.875rem;
  }

  /* Browser Minimal UI Content Styling */
  .browser-report-container {
    flex: 1.5;
    min-height: 0;
    display: flex;
    padding: 2px;
  }

  .web-ui-error {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1rem;
    color: #333;
    font-family: var(--font-sans);
  }

  .web-status-header {
    border-bottom: 2px solid #f0f0f0;
    padding-bottom: 10px;
  }

  .web-status-label {
    font-size: 10px;
    font-weight: 800;
    color: #999;
    letter-spacing: 1px;
  }

  .web-status-code {
    font-size: 48px;
    margin: 0;
    color: #ef4444;
    font-weight: 900;
  }

  .web-error-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #555;
    margin: 0;
  }

  .web-trace-section {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 15px;
    border: 1px solid #eee;
  }

  .web-trace-header {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: #ef4444;
    margin-bottom: 10px;
  }

  .web-trace-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .web-trace-item {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #666;
  }

  @media (max-width: 768px) {
    .suggestion-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
