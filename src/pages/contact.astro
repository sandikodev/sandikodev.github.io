---
import {
  FaAddressCard,
  FaEnvelope,
  FaPhoneAlt,
  FaClock,
  FaGlobe,
} from "react-icons/fa";

import ContactForm from "@/components/ui/ContactForm";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";

const { address, email, phone } = config.contactinfo;
---

<Base
  description={`Hire ${config.metadata.meta_author} for your next web development project. Specializing in high-performance Full Stack solutions, React, and Node.js.`}
  image="/images/og-image.png"
  meta_title={`Hire ${config.metadata.meta_author} - Professional Full Stack Developer`}
  title={`Contact | ${config.metadata.meta_author}`}
>
  <!-- Hero Section -->
  <section class="contact-hero">
    <div class="container mx-auto px-4">
      <div class="header-wrap">
        <div class="status-badge">
          <span class="pulse"></span>
          Available for Hire (Available Now)
        </div>
        <h1 class="hero-title">
          Bring Your <span class="accent">Vision</span> To Life
        </h1>
        <p class="hero-sub">
          Looking for a technical partner to build your next big idea? Let's
          discuss your project requirement and create a high-impact solution.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-dashboard">
    <div class="container mx-auto px-4">
      <div class="dashboard-grid">
        <!-- Info Cards -->
        <div class="info-sidebar">
          <div class="connect-card">
            <div class="card-icon blue">
              <FaGlobe size={18} />
            </div>
            <div class="card-body">
              <span class="label">Location</span>
              <p class="value">Remote / {address}</p>
            </div>
          </div>

          <div class="connect-card">
            <div class="card-icon green">
              <FaEnvelope size={18} />
            </div>
            <div class="card-body">
              <span class="label">Professional Email</span>
              <a href={`mailto:${email}`} class="value link">{email}</a>
            </div>
          </div>

          <div class="connect-card">
            <div class="card-icon purple">
              <FaPhoneAlt size={18} />
            </div>
            <div class="card-body">
              <span class="label">Work WhatsApp</span>
              <a
                href="https://wa.me/6289649246450"
                target="_blank"
                class="value link"
              >
                +62 896 •••• 6450
              </a>
            </div>
          </div>

          <div class="connect-card">
            <div class="card-icon orange">
              <FaClock size={18} />
            </div>
            <div class="card-body">
              <span class="label">Working Hours</span>
              <p class="value">09:00 - 21:00 (GMT+7)</p>
            </div>
          </div>

          <!-- Socials -->
          <div class="social-bento">
            <span class="bento-label">Professional Networks</span>
            <div class="social-icons">
              <a
                href={config.contactinfo.github}
                target="_blank"
                class="social-link gh"
                aria-label="Github Profile"
              >
                <svg fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"
                  ><path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                  ></path></svg
                >
              </a>
              <a
                href={config.contactinfo.linkedin}
                target="_blank"
                class="social-link li"
                aria-label="LinkedIn Profile"
              >
                <svg fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"
                  ><path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  ></path></svg
                >
              </a>
              <a
                href={config.contactinfo.twitter}
                target="_blank"
                class="social-link tw"
                aria-label="Twitter Profile"
              >
                <svg fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"
                  ><path
                    d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
                  ></path></svg
                >
              </a>
            </div>
          </div>
        </div>

        <!-- Main Form Card -->
        <div class="form-container">
          <div class="form-header">
            <h2 class="form-title">Start Your Project</h2>
            <p class="form-desc">
              Share your requirements below and receive a response within 24
              hours.
            </p>
          </div>
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Premium Dashboard Variables Overlays */
  .contact-hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    background: radial-gradient(
      circle at 0% 0%,
      var(--color-primary-alpha-5) 0%,
      transparent 50%
    );
  }

  .header-wrap {
    max-width: 800px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 99px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pulse {
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 var(--color-primary-alpha-30);
    }
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
    color: var(--color-text-main);
  }

  .accent {
    color: transparent;
    -webkit-text-stroke: 1px var(--color-text-main);
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-text-body);
    max-width: 45ch;
  }

  /* Grid Layout */
  .contact-dashboard {
    padding: 4rem 0 8rem;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Sidebar Cards */
  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .connect-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .connect-card:hover {
    transform: translateX(8px);
    border-color: var(--color-primary-alpha-30);
  }

  .card-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-icon.blue {
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
  }
  .card-icon.green {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }
  .card-icon.purple {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }

  .label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .value.link {
    transition: color 0.2s;
  }
  .value.link:hover {
    color: var(--color-primary);
  }

  /* Social Bento */
  .social-bento {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .bento-label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .social-icons {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .social-link:hover {
    transform: scale(1.1);
  }
  .social-link.gh {
    background: #181717;
  }
  .social-link.li {
    background: #0a66c2;
  }
  .social-link.tw {
    background: #000000;
  }

  /* Form Container */
  .form-container {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    padding: 3.5rem;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.1);
  }

  .form-header {
    margin-bottom: 3rem;
  }

  .form-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
  }

  .form-desc {
    color: var(--color-text-body);
    font-size: var(--text-base);
    opacity: 0.7;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
    .info-sidebar {
      order: 2;
    }
    .form-container {
      order: 1;
      padding: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .contact-hero {
      padding: 4rem 0 3rem;
    }
    .form-container {
      padding: 1.5rem;
    }
    .connect-card:hover {
      transform: none;
    }
  }
</style>
