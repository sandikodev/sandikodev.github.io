---
import I3Layout from "@/layouts/I3Layout.astro";
import I3Window from "@/components/terminal/I3Window.astro";
import Prompt from "@/components/terminal/Prompt.astro";
import ThemeSwitcher from "@/components/terminal/ThemeSwitcher.astro";
import KeyboardHandler from "@/components/terminal/KeyboardHandler.astro";
import HelpModal from "@/components/terminal/HelpModal.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const posts = await getSinglePage("posts");
const allPosts = posts
  .filter((post: any) => !post.data.draft)
  .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = [...new Set(allPosts.flatMap((p: any) => p.data.categories || []))];
const tags = [...new Set(allPosts.flatMap((p: any) => p.data.tags || []))];
---

<I3Layout title="Blog | dev@enigma">
  
  <!-- Enhanced Polybar with theme switcher -->
  <div class="enhanced-bar">
    <div class="bar-left">
      <span class="bar-hint">Press <kbd>?</kbd> for help</span>
    </div>
    <div class="bar-right">
      <ThemeSwitcher />
    </div>
  </div>

  <div class="i3-split-h blog-layout">
    
    <!-- Left Sidebar: Categories & Tags (20%) -->
    <div class="i3-split-v sidebar" style="flex: 0.6;">
      
      <!-- Categories -->
      <I3Window title="ls ~/blog/categories">
        <div class="tree-view">
          <div class="tree-header">
            <Prompt command="tree -L 1" showCursor={false} />
          </div>
          <div class="tree-list">
            {categories.map((cat, i) => (
              <a href={`/categories/${cat}`} class="tree-item">
                <span class="tree-icon">{i === categories.length - 1 ? '└──' : '├──'}</span>
                <span class="tree-name">📁 {cat}</span>
                <span class="tree-count">
                  {allPosts.filter((p: any) => p.data.categories?.includes(cat)).length}
                </span>
              </a>
            ))}
          </div>
        </div>
      </I3Window>
      
      <!-- Tags -->
      <I3Window title="cat ~/.tags">
        <div class="tag-cloud">
          {tags.slice(0, 15).map(tag => (
            <a href={`/tags/${tag}`} class="tag-item">
              #{tag}
            </a>
          ))}
        </div>
      </I3Window>
      
    </div>
    
    <!-- Main: Blog Posts (55%) -->
    <div class="i3-split-v main-content" style="flex: 1.6;">
      
      <I3Window title="ranger ~/blog/posts" focused={true}>
        <div class="blog-header">
          <Prompt command="find ~/blog -type f -name '*.md' | wc -l" showCursor={false} />
          <div class="post-count">{allPosts.length} posts found</div>
        </div>
        
        <div class="post-list">
          {allPosts.map((post: any, i: number) => (
            <article class={`post-card ${i === 0 ? 'selected' : ''}`}>
              <a href={`/${post.slug}`} class="post-link">
                <div class="post-header">
                  <span class="post-icon">📄</span>
                  <h3 class="post-title">{post.data.title}</h3>
                </div>
                
                <div class="post-meta">
                  <span class="post-date">
                    📅 {post.data.date?.toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'short', 
                      day: 'numeric' 
                    })}
                  </span>
                  {post.data.authors && (
                    <span class="post-author">
                      👤 {post.data.authors[0]}
                    </span>
                  )}
                </div>
                
                {post.data.description && (
                  <p class="post-desc">{post.data.description}</p>
                )}
                
                <div class="post-footer">
                  <div class="post-tags">
                    {post.data.tags?.slice(0, 3).map((tag: string) => (
                      <span class="post-tag">#{tag}</span>
                    ))}
                  </div>
                  <span class="post-arrow">→</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </I3Window>
      
    </div>
    
    <!-- Right Sidebar: Stats & Info (25%) -->
    <div class="i3-split-v sidebar-right" style="flex: 0.8;">
      
      <!-- Stats -->
      <I3Window title="cat ~/.blog_stats">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-icon">📝</div>
            <div class="stat-value">{allPosts.length}</div>
            <div class="stat-label">Posts</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">📁</div>
            <div class="stat-value">{categories.length}</div>
            <div class="stat-label">Categories</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">🏷️</div>
            <div class="stat-value">{tags.length}</div>
            <div class="stat-label">Tags</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">👁️</div>
            <div class="stat-value">
              {Math.floor(Math.random() * 10000 + 5000).toLocaleString()}
            </div>
            <div class="stat-label">Views</div>
          </div>
        </div>
      </I3Window>
      
      <!-- Recent Activity -->
      <I3Window title="tail -f ~/.blog_activity">
        <div class="activity-feed">
          {allPosts.slice(0, 5).map((post: any) => (
            <div class="activity-item">
              <span class="activity-time">
                {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </span>
              <span class="activity-text">
                Published: <a href={`/${post.slug}`}>{post.data.title}</a>
              </span>
            </div>
          ))}
        </div>
      </I3Window>
      
      <!-- Quick Links -->
      <I3Window title="cat ~/.quicklinks">
        <div class="quick-links">
          <a href="/" class="quick-link">
            <span class="ql-icon">🏠</span>
            <span class="ql-text">Home</span>
          </a>
          <a href="/about" class="quick-link">
            <span class="ql-icon">👤</span>
            <span class="ql-text">About</span>
          </a>
          <a href="/terminal" class="quick-link">
            <span class="ql-icon">💻</span>
            <span class="ql-text">Terminal</span>
          </a>
        </div>
      </I3Window>
      
    </div>
  </div>
  
  <!-- Keyboard Handler -->
  <KeyboardHandler />
  
  <!-- Help Modal -->
  <HelpModal />
  
</I3Layout>

<style>
  /* Enhanced Bar */
  .enhanced-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
  }

  .bar-hint {
    color: var(--text-muted);
  }

  .bar-hint kbd {
    padding: 2px 6px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  /* Blog Layout */
  .blog-layout {
    height: calc(100vh - 28px - 32px);
    overflow: hidden;
  }

  /* Tree View */
  .tree-view {
    font-size: 0.8125rem;
  }

  .tree-header {
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .tree-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tree-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.15s;
  }

  .tree-item:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .tree-icon {
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .tree-name {
    flex: 1;
    font-size: 0.8125rem;
  }

  .tree-count {
    color: var(--text-muted);
    font-size: 0.75rem;
    background: var(--bg-tertiary);
    padding: 2px 6px;
    border-radius: 3px;
  }

  /* Tag Cloud */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-item {
    padding: 4px 10px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--cyan);
    text-decoration: none;
    font-size: 0.75rem;
    transition: all 0.15s;
  }

  .tag-item:hover {
    background: var(--cyan);
    color: var(--i3-bg);
    border-color: var(--cyan);
  }

  /* Blog Header */
  .blog-header {
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .post-count {
    color: var(--green);
    font-size: 0.875rem;
    margin-top: 4px;
  }

  /* Post List */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
    padding-right: 8px;
  }

  .post-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 16px;
    transition: all 0.2s;
  }

  .post-card:hover,
  .post-card.selected {
    background: var(--bg-tertiary);
    border-color: var(--blue);
    box-shadow: 0 0 0 1px var(--blue);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-header {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 8px;
  }

  .post-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .post-title {
    margin: 0;
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .post-title::before {
    content: '';
  }

  .post-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-desc {
    margin: 8px 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .post-tag {
    color: var(--cyan);
    font-size: 0.75rem;
  }

  .post-arrow {
    color: var(--blue);
    font-size: 1.25rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .post-card:hover .post-arrow {
    opacity: 1;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px;
    background: var(--bg-tertiary);
    border-radius: 6px;
    text-align: center;
  }

  .stat-icon {
    font-size: 1.5rem;
    margin-bottom: 6px;
  }

  .stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cyan);
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Activity Feed */
  .activity-feed {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.8125rem;
  }

  .activity-item {
    display: flex;
    gap: 8px;
    padding: 6px 8px;
    background: var(--bg-tertiary);
    border-radius: 4px;
  }

  .activity-time {
    color: var(--text-muted);
    font-size: 0.75rem;
    min-width: 50px;
  }

  .activity-text {
    color: var(--text-secondary);
    flex: 1;
  }

  .activity-text a {
    color: var(--blue);
    text-decoration: none;
  }

  .activity-text a:hover {
    text-decoration: underline;
  }

  /* Quick Links */
  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.15s;
  }

  .quick-link:hover {
    background: var(--blue);
    color: var(--i3-bg);
    border-color: var(--blue);
  }

  .ql-icon {
    font-size: 1.125rem;
  }

  .ql-text {
    font-size: 0.875rem;
  }

  /* Scrollbar */
  .post-list::-webkit-scrollbar {
    width: 6px;
  }

  .post-list::-webkit-scrollbar-track {
    background: var(--bg-primary);
  }

  .post-list::-webkit-scrollbar-thumb {
    background: var(--bg-tertiary);
    border-radius: 3px;
  }

  .post-list::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .sidebar-right {
      display: none;
    }
    
    .main-content {
      flex: 2 !important;
    }
  }

  @media (max-width: 768px) {
    .blog-layout {
      flex-direction: column !important;
      height: auto;
    }

    .sidebar,
    .main-content,
    .sidebar-right {
      flex: 1 !important;
      min-height: 300px;
    }

    .sidebar {
      order: 2;
    }

    .main-content {
      order: 1;
    }

    .post-list {
      max-height: 500px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .enhanced-bar {
      flex-direction: column;
      gap: 8px;
      padding: 8px;
    }

    .bar-hint {
      font-size: 0.7rem;
    }

    .post-meta {
      flex-direction: column;
      gap: 4px;
    }

    .post-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (max-width: 480px) {
    .post-card {
      padding: 12px;
    }

    .post-title {
      font-size: 0.9375rem;
    }

    .tree-count {
      display: none;
    }

    .activity-time {
      display: none;
    }
  }
</style>
