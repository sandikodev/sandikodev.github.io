---
import Base from "@/layouts/Base.astro";
import Default from "@/layouts/Default.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  try {
    const posts = await getCollection("posts");
    const templates = await getCollection("templates");
    const pages = await getCollection("pages");
    const allPages = [...pages, ...posts, ...templates];

    const excludedSlugs = ['404', 'contact'];
    const paths = allPages
      .filter((page) => !excludedSlugs.includes(page.id))
      .map((page) => ({
        params: {
          regular: page.id,
        },
        props: { page },
      }));
    return paths;
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [];
  }
}

const { page } = Astro.props;
const { title, meta_title, description, image } = page.data;

// Check if this is a post by looking at both collections
const posts = await getCollection("posts");
const templates = await getCollection("templates");
const isPost = posts.some(post => post.id === page.id) || templates.some(template => template.id === page.id);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  {
    isPost ? (
      <PostSingle post={page} />
    ) : (
      <Default data={page} />
    )
  }
</Base>
