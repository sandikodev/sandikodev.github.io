---
import { getCollection } from "astro:content";

import Base from "@/layouts/Base.astro";
import Default from "@/layouts/Default.astro";
import PostSingle from "@/layouts/PostSingle.astro";

export async function getStaticPaths() {
  try {
    const posts = await getCollection("posts");
    const templates = await getCollection("templates");
    const pages = await getCollection("pages");
    const allPages = [...pages, ...posts, ...templates];

    const excludedSlugs = [
      "404",
      "contact",
      "now",
      "categories",
      "tags",
      "search",
    ];
    const paths = allPages
      .filter((page) => !excludedSlugs.includes(page.id))
      .map((page) => ({
        params: {
          regular: page.id,
        },
        props: { page },
      }));
    return paths;
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [];
  }
}

const { page } = Astro.props;
const { description, image, meta_title, title } = page.data;

// Check if this is a post by looking at both collections
const posts = await getCollection("posts");
const templates = await getCollection("templates");
const isPost =
  posts.some((post) => post.id === page.id) ||
  templates.some((template) => template.id === page.id);
---

<Base
  description={description}
  image={image}
  meta_title={meta_title}
  title={title}
>
  {isPost ? <PostSingle post={page} /> : <Default data={page} />}
</Base>
