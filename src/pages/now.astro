---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";

const lastUpdated = "December 9, 2025";
---

<Base
  description="What I'm currently working on and learning"
  hideFooter={true}
  title={`Now - ${config.metadata.meta_author}`}
>
  <article class="now-workspace">
    <!-- Subtle Background Elements -->
    <div class="grain-overlay"></div>
    <div class="ambient-glow"></div>

    <header class="now-dashboard-header">
      <div class="header-main">
        <div class="status-indicator">
          <span class="pulse-dot"></span>
          <span class="status-text">Available for collaborations</span>
        </div>
        <div class="header-content">
          <h1 class="split-text">N<span>o</span>w</h1>
          <p class="hero-sub">
            Powered by the <a
              href="https://github.com/sandikodev/trackme"
              target="_blank"
              class="text-link">TrackMe</a
            > & Wisenesday™ methodology. A real-time snapshot of my focus and current
            orbit.
          </p>
        </div>
      </div>

      <div class="header-vitals">
        <div class="vitals-grid">
          <div class="vital-item">
            <span class="label">Location</span>
            <span class="value">🇮🇩 Indonesia, WIB</span>
          </div>
          <div class="vital-item">
            <span class="label">Local Time</span>
            <span class="value" id="local-time">--:--:--</span>
          </div>
          <div class="vital-item">
            <span class="label">Last Sync</span>
            <span class="value">{lastUpdated}</span>
          </div>
        </div>
      </div>
    </header>

    <main class="bento-grid">
      <!-- Section: Obsessions -->
      <section class="bento-card span-2 obsessions">
        <span class="card-idx" style="bottom: -2.5rem; left: -0.5rem;">01</span>
        <div class="card-header">
          <h2 class="card-title">Manifesto & Ecosystem Focus</h2>
        </div>
        <div class="journal-entries">
          <!-- ShowMyGear -->
          <div class="journal-entry">
            <div class="entry-content">
              <h3>ShowMyGear (Somager)</h3>
              <p>
                An open autopsy of my mental models, raw engineering setup, and
                disciplined CLI-first workflows. Total transparency to face the
                BCI era. Every dotfile, script, and alias is meticulously
                documented to bridge the gap between human intent and machine
                execution, transforming the developer into a true pilot of their
                ecosystem.
              </p>
              <div class="progress-wrapper">
                <a
                  href="https://github.com/sandikodev/showmygear"
                  target="_blank"
                  class="repo-link"
                >
                  <svg
                    fill="none"
                    height="16"
                    stroke="currentColor"
                    stroke-width="2"
                    width="16"
                    viewBox="0 0 24 24"
                    ><path
                      d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                    ></path></svg
                  >
                  Engine & Mindset
                </a>
              </div>
            </div>
            <div class="entry-image">
              <img
                src="/images/now/showmygear.png"
                alt="ShowMyGear Architecture Dashboard"
              />
            </div>
          </div>

          <!-- Hyperfocus -->
          <div class="journal-entry">
            <div class="entry-content">
              <h3>HyperFocus</h3>
              <p>
                A 10-year gift to the community. Distilling web technology
                education from zero to DevOps. Driven by passion, not profit.
                This initiative breaks down complex architectural decisions into
                digestible, principled lessons, ensuring the next generation of
                engineers focuses on fundamental mastery rather than chasing
                fleeting hype.
              </p>
              <div class="progress-wrapper">
                <a
                  href="https://sandikodev.github.io/hyperfocus"
                  target="_blank"
                  class="repo-link outline-link"
                >
                  <svg
                    fill="none"
                    height="16"
                    stroke="currentColor"
                    stroke-width="2"
                    width="16"
                    viewBox="0 0 24 24"
                    ><path
                      d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                    ></path></svg
                  >
                  Read Journey
                </a>
              </div>
            </div>
            <div class="entry-image">
              <img
                src="/images/now/hyperfocus.png"
                alt="HyperFocus Digital Brain"
              />
            </div>
          </div>

          <!-- TrackMe -->
          <div class="journal-entry trackme-featured">
            <div class="entry-content">
              <h3>TrackMe Live</h3>
              <p>
                Live, unfiltered visibility into my professional integrity,
                daily commitments, and weekly Wisenesday™ evaluations. By
                publicly sharing real-time metrics, blockers, and cognitive
                focus shifts, it enforces radical accountability and proves that
                consistent, measured discipline scales better than raw
                motivation.
              </p>
              <div class="progress-wrapper">
                <a
                  href="https://github.com/sandikodev/trackme"
                  target="_blank"
                  class="repo-link outline-link"
                >
                  <svg
                    fill="none"
                    height="16"
                    stroke="currentColor"
                    stroke-width="2"
                    width="16"
                    viewBox="0 0 24 24"
                    ><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg
                  >
                  Live Tracking
                </a>
              </div>
            </div>
            <div class="entry-image">
              <img
                src="/images/now/trackme.png"
                alt="TrackMe Analytics Dashboard"
              />
            </div>
          </div>
        </div>

        <div class="carousel-indicators">
          <span class="indicator active"></span>
          <span class="indicator"></span>
          <span class="indicator"></span>
        </div>
      </section>

      <!-- Section: The Stack -->
      <section class="bento-card stack-box">
        <span class="card-idx" style="bottom: -3.5rem; right: -1.5rem;">02</span
        >
        <div class="card-header">
          <h2 class="card-title">Core Arsenal</h2>
        </div>
        <div class="stack-mini-list">
          {
            [
              {
                tech: "Astro + Svelte 5",
                role: "Primary UI & SSG Architecture",
              },
              { tech: "TypeScript", role: "Type-safe Business Logic" },
              { tech: "Postgres / SQL", role: "Relational Persistence" },
              { tech: "Zsh / Tmux", role: "CLI/TUI Workflows" },
              { tech: "Bun & Node.js", role: "Backend Runtimes" },
            ].map((item) => (
              <div class="stack-tag">
                <div class="stack-tag-header">
                  <span class="tag-dot" />
                  <span class="stack-tech">{item.tech}</span>
                </div>
                <span class="stack-role">{item.role}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Reading -->
      <section class="bento-card span-full shelf-box">
        <span
          class="card-idx"
          style="top: 50%; right: -1.5rem; transform: translateY(-50%);"
          >03</span
        >
        <div class="card-header">
          <h2 class="card-title">On the Shelf (Active Learning)</h2>
        </div>
        <div class="book-grid">
          <div class="book-mini-card">
            <span class="book-cat">Theory & Architecture</span>
            <h4>Designing Data-Intensive Applications</h4>
            <div class="book-meta">
              <p>Martin Kleppmann</p>
              <span class="book-status">Focus: Distributed Systems</span>
            </div>
          </div>
          <div class="book-mini-card highlight">
            <span class="book-cat">Philosophy & Discipline</span>
            <h4>The Pragmatic Programmer</h4>
            <div class="book-meta">
              <p>David Thomas & Andrew Hunt</p>
              <span class="book-status">Focus: Engineering Mentality</span>
            </div>
          </div>
          <div class="book-mini-card">
            <span class="book-cat">Systematic Lifestyle</span>
            <h4>Building a Second Brain</h4>
            <div class="book-meta">
              <p>Tiago Forte</p>
              <span class="book-status">Focus: Personal Knowledge Mgmt</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section: Curiosity -->
      <section class="bento-card curiosity-highlight">
        <span class="card-idx" style="top: -3rem; right: -1.5rem;">04</span>
        <div class="card-header">
          <h2 class="card-title">Curiosity & R&D</h2>
        </div>
        <div class="curiosity-content">
          <blockquote class="compact-quote">
            "The best way to predict the future is to invent it."
          </blockquote>
          <p class="curiosity-meta">
            Currently deep-diving into AI Agent architectures, autonomous
            systems, and exploring how Human-Computer Interaction is evolving
            toward BCI (Brain-Computer Interfaces).
          </p>

          <div class="lab-tags">
            <span class="lab-tag">Agentic Coding</span>
            <span class="lab-tag">LLM Tool Calling</span>
            <span class="lab-tag">Local Models</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="now-footer">
      <div class="footer-line"></div>
      <div class="footer-wrap">
        <p>
          This is a <a href="https://nownownow.com/about" target="_blank"
            >/now</a
          > page. No tracking, no ads, just focus. Powered by <a
            href="https://github.com/sandikodev/trackme"
            target="_blank">TrackMe</a
          >.
        </p>
        <span class="footer-tag">v2.0 / 2026</span>
      </div>
    </footer>
  </article>

  <script>
    const initNowPage = () => {
      function updateTime() {
        const timeEl = document.getElementById("local-time");
        if (!timeEl) return;
        const now = new Date();
        timeEl.textContent = now.toLocaleTimeString("en-US", {
          hour12: false,
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
        });
      }
      setInterval(updateTime, 1000);
      updateTime();

      document.addEventListener("mousemove", (e) => {
        const glow = document.querySelector(".ambient-glow") as HTMLElement;
        if (!glow) return;
        glow.style.transform = `translate(${e.clientX - 250}px, ${e.clientY - 250}px)`;
      });

      // Intersection Observer for Staggered Fade-in
      const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("animate-in");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Apply observer to header and cards
      const animElements = document.querySelectorAll(
        ".header-main, .header-vitals, .bento-card",
      );
      animElements.forEach((el, index) => {
        (el as HTMLElement).style.setProperty(
          "--anim-delay",
          `${index * 0.1}s`,
        );
        el.classList.add("prepare-anim");
        observer.observe(el);
      });

      // 3D Tilt Effect for Bento Cards
      document.querySelectorAll(".bento-card").forEach((card) => {
        card.addEventListener("mousemove", (e: any) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;

          // Calculate rotation based on cursor position (max 3 degrees for subtlety)
          const rotateX = ((y - centerY) / centerY) * -3;
          const rotateY = ((x - centerX) / centerX) * 3;

          (card as HTMLElement).style.transform =
            `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
          (card as HTMLElement).style.transition = "none";
        });

        card.addEventListener("mouseleave", () => {
          (card as HTMLElement).style.transform =
            `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
          (card as HTMLElement).style.transition =
            "transform 0.5s cubic-bezier(0.23, 1, 0.32, 1)";
        });
      });

      // Carousel Logic
      const carouselContainer = document.querySelector(".journal-entries");
      const indicators = document.querySelectorAll(".indicator");

      if (carouselContainer && indicators.length) {
        carouselContainer.addEventListener("scroll", () => {
          const scrollPosition = carouselContainer.scrollLeft;
          const itemWidth = carouselContainer.clientWidth;

          const activeIndex = Math.round(scrollPosition / itemWidth);

          indicators.forEach((ind, index) => {
            if (index === activeIndex) {
              ind.classList.add("active");
            } else {
              ind.classList.remove("active");
            }
          });
        });

        // Make indicators clickable
        indicators.forEach((ind, index) => {
          (ind as HTMLElement).style.cursor = "pointer";
          ind.addEventListener("click", () => {
            const itemWidth = carouselContainer.clientWidth;
            carouselContainer.scrollTo({
              left: index * itemWidth,
              behavior: "smooth",
            });
          });
        });
      }
    };

    document.addEventListener("DOMContentLoaded", initNowPage);
    document.addEventListener("astro:page-load", initNowPage);
  </script>
</Base>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Orbitron:wght@900&display=swap");

  .now-workspace {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem var(--spacing-6);
    position: relative;
    min-height: 100vh;
  }

  /* Improved Selection States */
  ::selection {
    background: var(--color-primary);
    color: white;
  }

  /* Specialized selection for dark cards for maximum contrast */
  .highlight ::selection {
    background: var(--color-bg);
    color: var(--color-text-main);
  }

  .grain-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 50;
    opacity: 0.02;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .ambient-glow {
    position: fixed;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      var(--color-primary-alpha-10) 0%,
      transparent 70%
    );
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: -1;
    mix-blend-mode: plus-lighter;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Header / Vitals Dashboard */
  .now-dashboard-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    margin-bottom: 2rem;
    align-items: flex-end;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 var(--color-primary-alpha-30);
    }
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .status-text {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .header-content h1 {
    font-size: clamp(5rem, 12vw, 8rem);
    line-height: 0.85;
    margin: 0;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-main);
  }

  .header-content h1 span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-text-main);
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--color-text-body);
    margin-top: 1.5rem;
    max-width: 35ch;
    line-height: 1.4;
  }

  .header-vitals {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    backdrop-filter: blur(10px);
  }

  .vitals-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .vital-item .label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .vital-item .value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  /* Bento Grid Layout */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 1.25rem;
  }

  .bento-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .bento-card:hover {
    border-color: var(--color-primary-alpha-30);
    box-shadow: 0 15px 35px -10px var(--color-primary-alpha-10);
    z-index: 10;
  }

  /* Fade-In Logic */
  .prepare-anim {
    opacity: 0;
    transform: translateY(30px);
  }

  .animate-in {
    animation: fadeInUp 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    animation-delay: var(--anim-delay, 0s);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .span-2 {
    grid-column: span 2;
  }
  .span-full {
    grid-column: span 3;
  }

  .card-header {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 2.5rem;
    position: relative;
    z-index: 10;
  }

  .card-idx {
    position: absolute;
    font-family: "Orbitron", var(--font-mono), monospace;
    font-size: 14rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.12; /* Increased visibility */
    z-index: 0;
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.05em;
  }

  .card-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .obsessions {
    padding-left: 0;
    padding-right: 0;
  }

  .obsessions .card-header {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* Obsessions / Focus Grid (Carousel) */
  .journal-entries {
    position: relative;
    z-index: 10;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 2rem;
    padding-bottom: 3rem; /* tight space for indicators */
    padding-left: 2rem;
    padding-right: 2rem;
    scrollbar-width: none; /* Firefox */
  }

  .journal-entries::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .journal-entry {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .entry-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .entry-content h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-main);
  }

  .entry-content p {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
  }

  .entry-image {
    width: 100%;
    min-height: 220px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .entry-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .journal-entry:hover .entry-image img {
    transform: scale(1.03);
  }

  .progress-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .carousel-indicators {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border);
    transition: all 0.3s ease;
  }

  .indicator.active {
    background: var(--color-primary);
    transform: scale(1.5);
  }

  .progress-track {
    flex: 1;
    height: 4px;
    background: var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: 2px;
  }

  .progress-meta {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-bg);
    background: var(--color-text-main);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .repo-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.15);
  }

  .outline-link {
    background: transparent;
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
  }

  .outline-link:hover {
    background: var(--color-bg-secondary);
    box-shadow: none;
    border-color: var(--color-primary-alpha-30);
  }

  .text-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px dotted var(--color-primary);
  }

  .text-link:hover {
    color: var(--color-text-main);
    border-bottom-color: var(--color-text-main);
  }

  /* Stack Box */
  .stack-mini-list {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stack-tag {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: var(--color-bg-secondary);
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .stack-tag:hover {
    transform: translateX(5px);
