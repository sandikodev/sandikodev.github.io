---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";

const lastUpdated = "December 9, 2025";
---

<Base
  description="What I'm currently working on and learning"
  hideFooter={true}
  title={`Now - ${config.metadata.meta_author}`}
>
  <article class="now-workspace">
    <!-- Subtle Background Elements -->
    <div class="grain-overlay"></div>
    <div class="ambient-glow"></div>

    <header class="now-dashboard-header">
      <div class="header-main">
        <div class="status-indicator">
          <span class="pulse-dot"></span>
          <span class="status-text">Available for collaborations</span>
        </div>
        <div class="header-content">
          <h1 class="split-text">N<span>o</span>w</h1>
          <p class="hero-sub">
            A real-time snapshot of my focus, tools, and current orbit.
          </p>
        </div>
      </div>

      <div class="header-vitals">
        <div class="vitals-grid">
          <div class="vital-item">
            <span class="label">Location</span>
            <span class="value">🇮🇩 Indonesia, WIB</span>
          </div>
          <div class="vital-item">
            <span class="label">Local Time</span>
            <span class="value" id="local-time">--:--:--</span>
          </div>
          <div class="vital-item">
            <span class="label">Last Sync</span>
            <span class="value">{lastUpdated}</span>
          </div>
        </div>
      </div>
    </header>

    <main class="bento-grid">
      <!-- Section: Obsessions -->
      <section class="bento-card span-2 obsessions">
        <div class="card-header">
          <span class="card-idx">01</span>
          <h2 class="card-title">Current Obsessions</h2>
        </div>
        <div class="journal-entries">
          <div class="journal-entry">
            <h3>HyperFocus Documentation</h3>
            <p>
              Distilling a decade of web development experience into a
              definitive guide for the next generation.
            </p>
            <div class="progress-wrapper">
              <div class="progress-track">
                <div class="progress-fill" style="width: 65%;"></div>
              </div>
              <span class="progress-meta">65% Complete</span>
            </div>
          </div>
          <div class="journal-entry">
            <h3>Editorial Redesign</h3>
            <p>
              Elevating this digital garden into a premium "atelier" that
              prioritizes human connection.
            </p>
          </div>
        </div>
      </section>

      <!-- Section: The Stack -->
      <section class="bento-card stack-box">
        <div class="card-header">
          <span class="card-idx">02</span>
          <h2 class="card-title">The Stack</h2>
        </div>
        <div class="stack-mini-list">
          {
            [
              "Astro + Svelte",
              "TypeScript",
              "Postgres / SQL",
              "Low-level Infra",
            ].map((item, i) => (
              <div class="stack-tag">
                <span class="tag-dot" />
                {item}
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section: Reading -->
      <section class="bento-card span-full shelf-box">
        <div class="card-header">
          <span class="card-idx">03</span>
          <h2 class="card-title">On the Shelf</h2>
        </div>
        <div class="book-grid">
          <div class="book-mini-card">
            <span class="book-cat">Theory</span>
            <h4>Designing Data-Intensive Applications</h4>
            <p>Martin Kleppmann</p>
          </div>
          <div class="book-mini-card highlight">
            <span class="book-cat">Philosophy</span>
            <h4>The Pragmatic Programmer</h4>
            <p>David Thomas & Andrew Hunt</p>
          </div>
          <div class="book-mini-card">
            <span class="book-cat">Lifestyle</span>
            <h4>Building a Second Brain</h4>
            <p>Tiago Forte</p>
          </div>
        </div>
      </section>

      <!-- Section: Curiosity -->
      <section class="bento-card curiosity-highlight">
        <div class="card-header">
          <span class="card-idx">04</span>
          <h2 class="card-title">Curiosity</h2>
        </div>
        <div class="curiosity-content">
          <blockquote class="compact-quote">
            "The best way to predict the future is to invent it."
          </blockquote>
          <p class="curiosity-meta">
            Deep-diving into AI Agent architectures and Human-Computer
            Interaction.
          </p>
        </div>
      </section>
    </main>

    <footer class="now-footer">
      <div class="footer-line"></div>
      <div class="footer-wrap">
        <p>
          This is a <a href="https://nownownow.com/about" target="_blank"
            >/now</a
          > page. No tracking, no ads, just life.
        </p>
        <span class="footer-tag">v2.0 / 2026</span>
      </div>
    </footer>
  </article>

  <script is:inline>
    function updateTime() {
      const timeEl = document.getElementById("local-time");
      if (!timeEl) return;
      const now = new Date();
      timeEl.textContent = now.toLocaleTimeString("en-US", {
        hour12: false,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });
    }
    setInterval(updateTime, 1000);
    updateTime();

    document.addEventListener("mousemove", (e) => {
      const glow = document.querySelector(".ambient-glow");
      if (!glow) return;
      glow.style.transform = `translate(${e.clientX - 250}px, ${e.clientY - 250}px)`;
    });
  </script>
</Base>

<style>
  .now-workspace {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem var(--spacing-6);
    position: relative;
    min-height: 100vh;
  }

  /* Improved Selection States */
  ::selection {
    background: var(--color-primary);
    color: white;
  }

  /* Specialized selection for dark cards for maximum contrast */
  .highlight ::selection {
    background: var(--color-bg);
    color: var(--color-text-main);
  }

  .grain-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 50;
    opacity: 0.02;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .ambient-glow {
    position: fixed;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      var(--color-primary-alpha-10) 0%,
      transparent 70%
    );
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: -1;
    mix-blend-mode: plus-lighter;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Header / Vitals Dashboard */
  .now-dashboard-header {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    margin-bottom: 4rem;
    align-items: flex-end;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 var(--color-primary-alpha-30);
    }
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .status-text {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .header-content h1 {
    font-size: clamp(5rem, 12vw, 8rem);
    line-height: 0.85;
    margin: 0;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-main);
  }

  .header-content h1 span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-text-main);
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--color-text-body);
    margin-top: 1.5rem;
    max-width: 35ch;
    line-height: 1.4;
  }

  .header-vitals {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    backdrop-filter: blur(10px);
  }

  .vitals-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .vital-item .label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .vital-item .value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  /* Bento Grid Layout */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 1.5rem;
  }

  .bento-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .bento-card:hover {
    border-color: var(--color-primary-alpha-30);
  }

  .span-2 {
    grid-column: span 2;
  }
  .span-full {
    grid-column: span 3;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .card-idx {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-primary);
    opacity: 0.6;
  }

  .card-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Obsessions */
  .journal-entries {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .journal-entry h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-main);
  }

  .journal-entry p {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .progress-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .progress-track {
    flex: 1;
    height: 4px;
    background: var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: 2px;
  }

  .progress-meta {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  /* Stack Box */
  .stack-mini-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stack-tag {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-bg-secondary);
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  .stack-tag:hover {
    transform: translateX(5px);
    background: var(--color-primary-alpha-5);
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
  }

  /* Book Grid */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .book-mini-card {
    background: var(--color-bg-secondary);
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid transparent;
  }

  .book-mini-card.highlight {
    background: var(--color-text-main);
    color: var(--color-bg);
  }

  .book-mini-card.highlight .book-cat {
    color: var(--color-bg);
    opacity: 0.55;
  }

  .book-mini-card.highlight h4 {
    color: var(--color-bg);
  }

  .book-mini-card.highlight p {
    color: var(--color-bg);
    opacity: 0.75;
  }

  .book-cat {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  .book-mini-card h4 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .book-mini-card p {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  /* Curiosity */
  .curiosity-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .compact-quote {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-primary);
    margin: 0;
  }

  .curiosity-meta {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.5;
  }

  /* Footer */
  .now-footer {
    margin-top: 6rem;
  }

  .footer-line {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 2rem;
  }

  .footer-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .footer-wrap a {
    color: var(--color-text-main);
    text-decoration: underline;
  }

  .footer-tag {
    font-family: var(--font-mono);
    opacity: 0.5;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .now-dashboard-header {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .header-vitals {
      width: 100%;
    }
    .vitals-grid {
      flex-direction: row;
      justify-content: space-between;
    }
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .span-2,
    .span-full {
      grid-column: span 1;
    }
    .journal-entries {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .book-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .now-workspace {
      padding: 4rem var(--spacing-4);
    }
    .header-content h1 {
      font-size: 4rem;
    }
    .vitals-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .vital-item:last-child {
      grid-column: span 2;
    }
    .bento-card {
      padding: 1.75rem;
    }
    .footer-wrap {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
