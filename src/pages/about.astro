---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
---

<Base
  description={config.metadata.meta_description}
  image="/images/profile.jpg"
  meta_title={`About ${config.metadata.meta_author} - Full-Stack Developer`}
  title={`About ${config.metadata.meta_author}`}
>
  <!-- Fira Code Font -->
  <link href="https://fonts.googleapis.com" rel="preconnect" slot="head" />
  <link
    crossorigin
    href="https://fonts.gstatic.com"
    rel="preconnect"
    slot="head"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&display=swap"
    rel="stylesheet"
    slot="head"
  />
  <!-- Hero -->
  <section class="hero">
    <!-- Code Rain Background -->
    <div aria-hidden="true" class="code-rain">
      <div class="code-column">
        <span>const</span>
        <span>async</span>
        <span>await</span>
        <span> import </span>
        <span>export</span>
        <span>return</span>
        <span>function</span>
        <span> class </span>
      </div>
      <div class="code-column">
        <span>docker</span>
        <span>nginx</span>
        <span>redis</span>
        <span> postgres </span>
        <span>linux</span>
        <span>ssh</span>
        <span>git</span>
        <span>npm</span>
      </div>
      <div class="code-column">
        <span>{"=>"}</span>
        <span>{"{}"}</span>
        <span>[]</span>
        <span> () </span>
        <span>&&</span>
        <span>||</span>
        <span>===</span>
        <span> !== </span>
      </div>
      <div class="code-column">
        <span>SELECT</span>
        <span>FROM</span>
        <span>WHERE</span>
        <span> JOIN </span>
        <span>INSERT</span>
        <span>UPDATE</span>
        <span>CREATE</span>
        <span> INDEX </span>
      </div>
      <div class="code-column">
        <span>React</span>
        <span>Svelte</span>
        <span>Node</span>
        <span> Go </span>
        <span>Python</span>
        <span>TypeScript</span>
        <span>AWS</span>
        <span> API </span>
      </div>
    </div>

    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <p class="hero-label">
            <span class="prompt">$</span>
            {" "}
            whoami
          </p>
          <h1>
            Building Solutions,
            <br />
            <span class="highlight"> Layer by Layer </span>
          </h1>
          <p class="subtitle">
            <span class="typing-text">
              Engineer yang mulai dari rakit PC dan konfigurasi jaringan,
              sekarang membangun aplikasi web dan cloud infrastructure.
            </span>
            <span class="cursor">|</span>
          </p>
          <div class="hero-cta">
            <a class="btn-primary" href="/contact">
              <span>Let's Build Something</span>
              <svg
                class="btn-arrow"
                fill="none"
                height="16"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
                width="16"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a class="btn-ghost" href="/now">
              <span>Current Projects</span>
              <svg
                class="btn-arrow"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
              >
                <path d="M7 17l9.2-9.2M17 17V7H7"></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="hero-stats">
          <div class="stat-card">
            <span class="stat-num">2016</span>
            <span class="stat-label">Started</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">5</span>
            <span class="stat-label">Layers Deep</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">3</span>
            <span class="stat-label">Products Live</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Code Snippets -->
    <div aria-hidden="true" class="floating-code">
      <code class="snippet snippet-1">npm run build</code>
      <code class="snippet snippet-2">git push origin main</code>
      <code class="snippet snippet-3">docker-compose up -d</code>
      <code class="snippet snippet-4">ssh deploy@server</code>
    </div>
  </section>

  <!-- What I Build - Bento Grid -->
  <section class="skills">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">
          <span class="prompt">$</span>
          {" "}
          ls skills/
        </span>
        <h2>What I Build</h2>
      </div>
      <div class="bento-grid">
        <div class="bento-card bento-lg">
          <div class="bento-icon">🎨</div>
          <h3>Frontend</h3>
          <p>
            Component-based UI, state management, SSR/SSG, dan optimasi bundle
            size
          </p>
          <code class="tech-code">React • Svelte • TypeScript • Astro</code>
        </div>
        <div class="bento-card">
          <div class="bento-icon">⚙️</div>
          <h3>Backend</h3>
          <p>REST/GraphQL APIs, authentication, queue systems</p>
          <code class="tech-code">Node.js • Go • Python</code>
        </div>
        <div class="bento-card">
          <div class="bento-icon">🗄️</div>
          <h3>Database</h3>
          <p>Schema design, indexing, query optimization</p>
          <code class="tech-code">PostgreSQL • Redis • MongoDB</code>
        </div>
        <div class="bento-card">
          <div class="bento-icon">🚀</div>
          <h3>Full-Stack Frameworks</h3>
          <p>MVC, API routes, ORM, middleware</p>
          <code class="tech-code">Laravel • Next.js • SvelteKit • Qwik</code>
        </div>
        <div class="bento-card bento-lg">
          <div class="bento-icon">☁️</div>
          <h3>Infrastructure & DevOps</h3>
          <p>
            Containerization, CI/CD pipelines, server provisioning, monitoring &
            logging
          </p>
          <code class="tech-code">
            AWS • Docker • Linux • Nginx • GitHub Actions
          </code>
        </div>
        <div class="bento-card">
          <div class="bento-icon">📱</div>
          <h3>Mobile</h3>
          <p>Cross-platform, native modules, OTA updates</p>
          <code class="tech-code">React Native • Expo • PWA</code>
        </div>
        <div class="bento-card">
          <div class="bento-icon">🔗</div>
          <h3>Integration</h3>
          <p>Third-party APIs, webhooks, data sync</p>
          <code class="tech-code">REST • GraphQL • Webhooks</code>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="projects">
    <div class="container">
      <div class="section-header light">
        <span class="section-tag">
          <span class="prompt">$</span>
          {" "}
          cat projects.json
        </span>
        <h2>Featured Projects</h2>
      </div>
      <div class="projects-grid">
        <a class="project-card" href="/portfolio">
          <div class="project-meta">
            <span class="project-tag">Cloud Platform</span>
            <span class="project-arrow">↗</span>
          </div>
          <h3>AwanKinton</h3>
          <p>Vercel-like hosting & VPS reseller platform (AWS/Tencent)</p>
          <span class="project-company">Koneksi Cloud</span>
        </a>
        <a
          class="project-card"
          href="https://aksesekolah.id"
          rel="noopener"
          target="_blank"
        >
          <div class="project-meta">
            <span class="project-tag">SaaS</span>
            <span class="project-arrow">↗</span>
          </div>
          <h3>Akses Sekolah Digital</h3>
          <p>Platform Sistem Administrasi & Akademik untuk sekolah</p>
          <span class="project-company">aksesekolah.id</span>
        </a>
        <a class="project-card" href="/portfolio">
          <div class="project-meta">
            <span class="project-tag">AI / EdTech</span>
            <span class="project-arrow">↗</span>
          </div>
          <h3>We Will Shine</h3>
          <p>2USE LLM — Proxy dengan Socratic method untuk pembelajaran</p>
          <span class="project-company">Education AI</span>
        </a>
      </div>
      <div class="projects-cta">
        <a class="btn-outline" href="/portfolio">View All Projects →</a>
      </div>
    </div>
  </section>

  <!-- How I Work -->
  <section class="process">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">
          <span class="prompt">$</span>
          {" "}
          ./workflow.sh
        </span>
        <h2>How I Work</h2>
      </div>
      <div class="process-grid">
        <div class="process-step">
          <div class="step-num">01</div>
          <div class="step-content">
            <h3>Understand</h3>
            <p>Deep dive ke business needs, constraints, dan goals</p>
          </div>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="step-num">02</div>
          <div class="step-content">
            <h3>Design</h3>
            <p>Architecture yang scales dengan pertumbuhan bisnis</p>
          </div>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="step-num">03</div>
          <div class="step-content">
            <h3>Build</h3>
            <p>Iterative development dengan continuous feedback</p>
          </div>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="step-num">04</div>
          <div class="step-content">
            <h3>Deploy</h3>
            <p>Production-ready dengan monitoring & maintenance</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="experience">
    <div class="container">
      <div class="section-header light">
        <span class="section-tag">
          <span class="prompt">$</span>
          {" "}
          git log --oneline
        </span>
        <h2>Experience</h2>
      </div>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-date">2016 — 2018</div>
          <div class="timeline-content">
            <h3>Foundation</h3>
            <p>IT Support → Network Operations → System Administration</p>
            <code class="timeline-tech">
              Hardware • Networks • Linux • Troubleshooting
            </code>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-date">2018 — 2021</div>
          <div class="timeline-content">
            <h3>Development</h3>
            <p>Frontend Developer → Backend Developer → Full-Stack</p>
            <code class="timeline-tech">
              JavaScript • React • Node.js • Databases
            </code>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot active"></div>
          <div class="timeline-date">2021 — Now</div>
          <div class="timeline-content">
            <h3>Architecture & Leadership</h3>
            <p>Full-Stack Engineer → DevOps → Solutions Architect</p>
            <code class="timeline-tech">
              AWS • Docker • System Design • Team Lead
            </code>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Me -->
  <section class="value">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">
          <span class="prompt">$</span>
          {" "}
          man
          {config.site.logo_text.toLowerCase()}
        </span>
        <h2>How I Think About Problems</h2>
      </div>
      <div class="value-grid">
        <div class="value-card">
          <div class="value-icon">🏗️</div>
          <h4>Holistic Architecture</h4>
          <p>
            Saya tidak hanya membangun fitur; saya merancang sistem yang melihat
            hubungan antara UI, API, Database, hingga level Infrastruktur
            sebagai satu organisme yang utuh.
          </p>
        </div>
        <div class="value-card">
          <div class="value-icon">📉</div>
          <h4>Economic Engineering</h4>
          <p>
            Kedalaman teknis memungkinkan saya menulis kode yang sangat efisien.
            Hasilnya? Biaya operasional server yang lebih rendah dan performa
            yang lebih tinggi bagi klien.
          </p>
        </div>
        <div class="value-card">
          <div class="value-icon">🛡️</div>
          <h4>Defensive Foundation</h4>
          <p>
            Dengan background riset kerentanan, deteksi ancaman bukan "proyek
            tambahan", melainkan standar dasar dalam setiap baris kode yang saya
            tulis sejak hari pertama.
          </p>
        </div>
        <div class="value-card">
          <div class="value-icon">🛠️</div>
          <h4>Production Resilience</h4>
          <p>
            Sistem yang saya bangun dirancang untuk selamat di lingkungan
            produksi yang keras, lengkap dengan observabilitas dan skalabilitas
            yang matang.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta-mesh"></div>
    <div class="container">
      <div class="cta-wrapper animate-on-scroll">
        <div class="cta-status">
          <span class="status-dot"></span>
          <span class="status-text">Available for new opportunities</span>
        </div>
        <div class="cta-content">
          <span class="cta-label">
            <span class="prompt">></span> git checkout project
          </span>
          <h2>Ada Project Menarik?</h2>
          <p>
            Saya selalu terbuka untuk diskusi mengenai arsitektur sistem,
            pembangunan aplikasi dari nol, atau optimasi infrastruktur yang
            sudah ada.
          </p>
          <div class="cta-buttons">
            <a class="btn-cta-primary" href="/contact">
              <span>Mulai Diskusi</span>
              <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
                width="20"
              >
                <path
                  d="M5 12h14M12 5l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
            <a class="btn-cta-secondary" href="/portfolio">
              <svg
                fill="none"
                height="18"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="18"
              >
                <path
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span>Explore Portfolio</span>
            </a>
          </div>
        </div>

        <div class="cta-decoration" aria-hidden="true">
          <div class="decor-circle circle-1"></div>
          <div class="decor-circle circle-2"></div>
          <code class="decor-code">{'{ "ready": true }'}</code>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Base */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    margin-bottom: 3rem;
  }
  .section-header.light {
    color: white;
  }
  .section-header h2 {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0.5rem 0 0;
  }
  .section-header.light h2 {
    color: white;
  }
  .section-tag {
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0;
  }
  .section-tag .prompt {
    color: var(--color-dev-teal);
    margin-right: 0.4rem;
  }
  .section-header.light .section-tag {
    color: rgba(255, 255, 255, 0.7);
  }
  .section-header.light .section-tag .prompt {
    color: var(--color-dev-teal);
  }

  /* Hero */
  .hero {
    padding: 6rem 0;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    color: white;
    position: relative;
    overflow: hidden;
  }

  /* Code Rain Background */
  .code-rain {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-around;
    pointer-events: none;
    opacity: 0.15;
  }
  .code-column {
    display: flex;
    flex-direction: column;
    animation: rain 20s linear infinite;
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.75rem;
    color: var(--color-dev-teal);
  }
  .code-column span {
    padding: 0.5rem 0;
    opacity: 0.7;
  }
  .code-column:nth-child(1) {
    animation-duration: 15s;
  }
  .code-column:nth-child(2) {
    animation-duration: 18s;
    animation-delay: -5s;
  }
  .code-column:nth-child(3) {
    animation-duration: 12s;
    animation-delay: -3s;
  }
  .code-column:nth-child(4) {
    animation-duration: 20s;
    animation-delay: -8s;
  }
  .code-column:nth-child(5) {
    animation-duration: 16s;
    animation-delay: -2s;
  }

  @keyframes rain {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100vh);
    }
  }

  /* Floating Code Snippets */
  .floating-code {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .snippet {
    position: absolute;
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.7rem;
    background: rgba(78, 205, 196, 0.1);
    border: 1px solid rgba(78, 205, 196, 0.2);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    color: var(--color-dev-teal);
    animation: float 6s ease-in-out infinite;
  }
  .snippet-1 {
    top: 15%;
    left: 5%;
    animation-delay: 0s;
  }
  .snippet-2 {
    top: 70%;
    left: 8%;
    animation-delay: 1.5s;
  }
  .snippet-3 {
    top: 25%;
    right: 3%;
    animation-delay: 3s;
  }
  .snippet-4 {
    top: 80%;
    right: 5%;
    animation-delay: 4.5s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
      opacity: 0.6;
    }
    50% {
      transform: translateY(-15px) rotate(1deg);
      opacity: 0.9;
    }
  }

  /* Terminal Prompt */
  .prompt {
    color: var(--color-dev-teal);
    margin-right: 0.5rem;
  }

  /* Typing Cursor */
  .cursor {
    animation: blink 1s step-end infinite;
    color: var(--color-dev-teal);
    font-weight: 100;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .hero-label {
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.875rem;
    opacity: 0.9;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }
  .hero h1 {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: white; /* Ensure visibility on dark hero gradient */
  }
  .highlight {
    background: linear-gradient(
      90deg,
      var(--color-dev-gold),
      var(--color-dev-orange)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .subtitle {
    font-size: 1.125rem;
    opacity: 0.9;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 500px;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .hero-stats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .stat-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .stat-num {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    font-family: "SF Mono", "Fira Code", monospace;
  }
  .stat-label {
    font-size: 0.75rem;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Bento Grid */
  .skills {
    padding: 5rem 0;
    background: var(--color-surface);
  }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .bento-card {
    background: var(--color-bg);
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }
  .bento-card:hover {
    border-color: #667eea;
    box-shadow: 0 4px 20px rgba(102, 126, 234, 0.1);
    transform: translateY(-2px);
  }
  .bento-card.bento-lg {
    grid-column: span 2;
  }
  .bento-icon {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }
  .bento-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }
  .bento-card p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .tech-code {
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.75rem;
    color: var(--color-dev-teal);
    background: rgba(78, 205, 196, 0.1);
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    display: inline-block;
    border: 1px solid rgba(78, 205, 196, 0.2);
  }

  /* Projects */
  .projects {
    padding: 5rem 0;
    background: var(--color-surface);
    color: var(--color-text-main);
  }
