  .animate-on-scroll.visible {
    animation: fadeInUp 0.6s ease forwards;
  }

  .animate-on-scroll:nth-child(1) { animation-delay: 0s; }
  .animate-on-scroll:nth-child(2) { animation-delay: 0.1s; }
