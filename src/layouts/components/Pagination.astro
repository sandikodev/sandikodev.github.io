---
const { currentPage, section = "blog", totalPages } = Astro.props;

const hasPrevPage = currentPage > 1;
const hasNextPage = totalPages > currentPage;

// Generate page numbers to show
const getPageList = () => {
  const delta = 2;
  const range = [];
  const rangeWithDots = [];
  let l;

  range.push(1);
  for (let i = currentPage - delta; i <= currentPage + delta; i++) {
    if (i < totalPages && i > 1) {
      range.push(i);
    }
  }
  if (totalPages > 1) {
    range.push(totalPages);
  }

  for (let i of range) {
    if (l) {
      if (i - l === 2) {
        rangeWithDots.push(l + 1);
      } else if (i - l !== 1) {
        rangeWithDots.push("...");
      }
    }
    rangeWithDots.push(i);
    l = i;
  }

  return rangeWithDots;
};

const pageList = getPageList();

const getPageUrl = (pageIndex: number | string) => {
  if (pageIndex === 1) return `/${section}`;
  return `/${section}/page/${pageIndex}`;
};
---

{
  totalPages > 1 && (
    <nav aria-label="Pagination" class="pagination">
      {/* Previous Button */}
      {hasPrevPage ? (
        <a
          class="pagination-btn pagination-prev"
          href={getPageUrl(currentPage - 1)}
        >
          <svg
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
          >
            <path
              d="M15 18l-6-6 6-6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="sr-only">Previous</span>
        </a>
      ) : (
        <span class="pagination-btn pagination-disabled">
          <svg
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
          >
            <path
              d="M15 18l-6-6 6-6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      )}

      {/* Page Numbers */}
      <div class="pagination-numbers">
        {pageList.map((page) =>
          page === "..." ? (
            <span class="pagination-dots">...</span>
          ) : page === currentPage ? (
            <span aria-current="page" class="pagination-link active">
              {page}
            </span>
          ) : (
            <a class="pagination-link" href={getPageUrl(page)}>
              {page}
            </a>
          ),
        )}
      </div>

      {/* Next Button */}
      {hasNextPage ? (
        <a
          class="pagination-btn pagination-next"
          href={getPageUrl(currentPage + 1)}
        >
          <span class="sr-only">Next</span>
          <svg
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
          >
            <path
              d="M9 18l6-6-6-6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ) : (
        <span class="pagination-btn pagination-disabled">
          <svg
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
          >
            <path
              d="M9 18l6-6-6-6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem 0;
  }

  .pagination-numbers {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pagination-btn,
  .pagination-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: var(--transition-all);
    cursor: pointer;
  }

  .pagination-link.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
    cursor: default;
  }

  .pagination-link:not(.active):hover,
  .pagination-btn:not(.pagination-disabled):hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--color-shadow-sm);
  }

  .pagination-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--color-bg-tertiary);
  }

  .pagination-dots {
    color: var(--color-text-muted);
    padding: 0 0.25rem;
  }

  @media (max-width: 640px) {
    .pagination {
      gap: 0.5rem;
    }

    .pagination-btn,
    .pagination-link {
      min-width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>
