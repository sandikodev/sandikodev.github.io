---
import { Image } from "astro:assets";

import Comments from "@/components/blog/Comments.astro";
import PrevNext from "@/components/blog/PrevNext.astro";
import ReadingTime from "@/components/blog/ReadingTime.astro";
import RelatedPostsUnified from "@/components/blog/RelatedPostsUnified.astro";
import SocialShare from "@/components/blog/SocialShare.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import Breadcrumb from "@/components/layout/Breadcrumb.astro";
import CodeBlockEnhancer from "@/components/ui/CodeBlockEnhancer.astro";
import DevStats from "@/components/ui/DevStats.astro";
import FontSizeToggle from "@/components/ui/FontSizeToggle.astro";
import KeyboardShortcuts from "@/components/ui/KeyboardShortcuts.astro";
import ViewCounter from "@/components/ui/ViewCounter.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { calculateReadingTime } from "@/lib/utils/readingTime";
import { humanize, slugify } from "@/lib/utils/textConverter";

const allAuthors = await getSinglePage("authors");
const { post } = Astro.props;
import { render } from "astro:content";
const { Content, headings } = await render(post);
const { authors, categories, date, description, image, tags, title } =
  post.data;

// Calculate reading time using utility
const readingTime = calculateReadingTime(post.body);
---

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
    max-width: var(--max-width-container);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
  }
  .article-header {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    padding: var(--spacing-8) 0 0; /* Removed bottom padding */
  }

  .article-header-content {
    position: relative;
  }

  .article-sidebar :global(.font-size-toggle) {
    margin-bottom: var(--spacing-8);
    padding-bottom: var(--spacing-4);
    border-bottom: 1px solid var(--color-border);
    justify-content: flex-start;
  }

  .article-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin-bottom: var(--spacing-4);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .article-breadcrumb {
    margin-bottom: var(--spacing-4);
  }

  .article-subtitle {
    font-size: var(--text-xl);
    line-height: 1.6;
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-weight: 400;
    text-wrap: pretty;
    max-width: 80ch;
    padding-left: 1.25rem;
    border-left: 4px solid var(--color-primary);
  }
  .article-meta {
    display: flex;
    gap: var(--spacing-3);
    flex-wrap: wrap;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-8);
    font-family: inherit;
  }
  .article-meta span {
    display: flex;
    align-items: center;
  }
  .article-meta .separator {
    color: var(--color-border);
    font-size: 0.5rem;
    margin: 0 var(--spacing-1);
  }
  .article-meta a {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }
  .article-meta a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }
  .article-image {
    max-width: 1000px;
    margin: -1rem auto var(--spacing-12); /* Slightly increased gap */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .article-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-12);
    align-items: start;
  }
  .article-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-body);
  }

  /* Typography and code block styles moved to src/styles/main.css */

  .article-footer {
    max-width: var(--max-width-content);
    margin: var(--spacing-12) auto 0;
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--color-border);
  }
  .tags {
    display: flex;
    gap: var(--spacing-3);
    flex-wrap: wrap;
  }
  .tag {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-body);
    text-decoration: none;
    font-family: var(--font-primary);
    transition: var(--transition-all);
  }
  .tag:hover {
    background: var(--color-bg);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  @media (min-width: 1200px) {
    .article-main {
      display: grid;
      grid-template-columns: var(--max-width-content) 280px;
      max-width: var(--max-width-container);
      margin: 0 auto;
      padding: 0 var(--spacing-6);
      justify-content: center;
    }
    .article-content {
      margin: 0;
    }
  }

  .article-sidebar {
    display: none;
  }

  @media (min-width: 1200px) {
    .article-sidebar {
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 100px;
      height: fit-content;
    }
  }
</style>

<article class="article-layout">
  <header class="article-header">
    <div class="article-header-content">
      <h1 class="article-title">{title}</h1>

      <!-- Breadcrumb -->
      <div class="article-breadcrumb">
        <Breadcrumb />
      </div>

      <div class="article-meta">
        <span>
          <svg
            class="mr-1.5 opacity-70"
            fill="none"
            height="14"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
          >
            <rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          {dateFormat(date)}
        </span>

        <span class="separator">●</span>
        <ReadingTime content={post.body} />

        <span class="separator">●</span>
        <ViewCounter slug={post.id} />

        {
          authors.length > 0 && (
            <>
              <span class="separator">●</span>
              <span>
                <svg
                  class="mr-1.5 opacity-70"
                  fill="none"
                  height="14"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="14"
                >
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                {allAuthors
                  .filter((author) =>
                    authors
                      .map((a: string) => slugify(a))
                      .includes(slugify(author.data.title)),
                  )
                  .map((author, i) => (
                    <>
                      <a
                        class="transition-colors hover:text-primary"
                        href={`/authors/${slugify(author.id)}`}
                      >
                        {author.data.title}
                      </a>
                      {i < authors.length - 1 && ", "}
                    </>
                  ))}
              </span>
            </>
          )
        }

        {
          categories.length > 0 && (
            <>
              <span class="separator">●</span>
              <span>
                <svg
                  class="mr-1.5 opacity-70"
                  fill="none"
                  height="14"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="14"
                >
                  <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                </svg>
                {categories.map((cat: string, i: number) => (
                  <>
                    <a
                      class="transition-colors hover:text-primary"
                      href={`/categories/${slugify(cat)}`}
                    >
                      {humanize(cat)}
                    </a>
                    {i < categories.length - 1 && ", "}
                  </>
                ))}
              </span>
            </>
          )
        }
      </div>

      {description && <p class="article-subtitle">{description}</p>}
    </div>
  </header>

  {
    image && (
      <div class="article-image">
        <Image alt={title} height={500} src={image} width={1000} />
      </div>
    )
  }

  <div class="article-main">
    <div class="article-content scalable-content prose max-w-none">
      <Content />

      {
        tags && tags.length > 0 && (
          <footer class="article-footer">
            <div class="tags">
              {tags.map((tag: string) => (
                <a class="tag" href={`/tags/${slugify(tag)}`}>
                  #{humanize(tag)}
                </a>
              ))}
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-border pt-6 text-sm text-muted">
              <a
                class="flex items-center transition-colors hover:text-primary"
                href={`${config.contactinfo.github}/sandikodev.github.io/edit/main/${post.collection === "posts" ? "content/posts" : "src/content/templates"}/${post.id}.md`}
                rel="noopener noreferrer"
                target="_blank"
              >
                <svg
                  class="mr-2"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                >
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
                Edit on GitHub
              </a>

              <div class="flex items-center gap-4">
                <span>
                  Updated:
                  {dateFormat(date)}
                </span>
              </div>
            </div>
          </footer>
        )
      }

      <!-- Social Share -->
      <SocialShare title={title} />
    </div>

    <aside class="article-sidebar">
      <FontSizeToggle />
      <DevStats content={post.body} readingTime={readingTime} />
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <!-- Previous/Next Navigation -->
  <PrevNext currentSlug={post.id} />
</article>

<!-- Enhanced Related Posts -->
<RelatedPostsUnified
  algorithm="similarity"
  currentCategories={categories || []}
  currentSlug={post.id}
  currentTags={tags || []}
/>

{!Astro.url.pathname.startsWith("/workspace") && <Comments />}

<!-- Keyboard Shortcuts for article reading -->
<KeyboardShortcuts />

<CodeBlockEnhancer />
