---
import "@/styles/main.css";
import "@/styles/design-system.css";

export interface Props {
  meta_title?: string;
  description?: string;
}

const { meta_title, description } = Astro.props;

const title = meta_title ?? "sandikodev — Version History";
const desc =
  description ??
  "Archived versions of sandikodev's personal site — each major iteration preserved as a navigable snapshot.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      content="width=device-width, initial-scale=1, maximum-scale=5"
      name="viewport"
    />

    <!-- Inline theme init (dark mode only — v0 always dark) -->
    <script is:inline>
      document.documentElement.classList.add("dark");
    </script>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Fira+Code:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <link href="/logo.svg" rel="icon" type="image/svg+xml" />

    <!-- Meta -->
    <title>{title}</title>
    <meta content={desc} name="description" />
    <meta content="noindex, nofollow" name="robots" />
  </head>
  <body class="v0-body">
    <slot />

    <!-- Minimal back-to-top behaviour — no JS framework needed -->
  </body>
</html>

<style is:global>
  /* Force dark mode variables for all v0 pages */
  .v0-body {
    background: var(--color-bg);
    color: var(--color-text-main);
    font-family: "Inter", system-ui, sans-serif;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  /* Shared v0 banner — used by every archive page */
  .v0-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .v0-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .v0-breadcrumb a {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    transition: color 0.15s;
  }

  .v0-breadcrumb a:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  .v0-label {
    color: rgba(255, 255, 255, 0.3);
    flex: 1;
    font-size: 0.75rem;
  }

  .v0-link {
    font-weight: 600;
    font-size: 0.75rem;
    color: #4ecdc4;
    text-decoration: none;
    transition: opacity 0.2s;
    margin-left: auto;
  }

  .v0-link:hover {
    opacity: 0.75;
  }

  /* Retrospective Section — "Curator's Note" Aesthetic */
  .v0-retrospective {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  /* Atmospheric Lighting & Technical Patterns */
  .v0-retrospective::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      radial-gradient(
        circle at 20% 50%,
        rgba(78, 205, 196, 0.05) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 80%,
        rgba(78, 205, 196, 0.02) 0%,
        transparent 40%
      ),
      radial-gradient(rgba(78, 205, 196, 0.05) 1px, transparent 1px);
    background-size:
      100% 100%,
      100% 100%,
      24px 24px;
    opacity: 0.8;
    pointer-events: none;
  }

  /* Decorative Technical ID */
  .v0-retrospective::after {
    content: "ARCHIVE_LOG_TRACER :: 2026_REF";
    position: absolute;
    bottom: 1.5rem;
    right: 2rem;
    font-family: "Fira Code", monospace;
    font-size: 0.55rem;
    color: var(--color-text-muted);
    opacity: 0.2;
    letter-spacing: 0.3em;
  }

  .retro-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 1;
  }

  .retro-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .retro-tag {
    font-family: "Fira Code", monospace;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #4ecdc4;
    padding: 0.35rem 0.85rem;
    background: rgba(78, 205, 196, 0.08);
    border: 1px solid rgba(78, 205, 196, 0.2);
    border-radius: 4px;
    white-space: nowrap;
    box-shadow: 0 0 30px rgba(78, 205, 196, 0.1);
  }

  .retro-header h3 {
    font-size: 1.75rem;
    font-weight: 950;
    color: var(--color-text-main);
    letter-spacing: -0.05em;
    margin: 0;
    background: linear-gradient(
      90deg,
      var(--color-text-main),
      var(--color-text-body)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .v0-retrospective p {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.2rem;
    line-height: 1.9;
    color: var(--color-text-body);
    opacity: 0.95;
    margin: 0;
    font-style: italic;
    position: relative;
    padding: 0 3rem;
  }

  /* Large quote marks for a literary feel */
  .v0-retrospective p::before {
    content: "“";
    position: absolute;
    left: 0;
    top: -1.25rem;
    font-size: 5rem;
    color: #4ecdc4;
    opacity: 0.15;
    font-family: serif;
    line-height: 1;
  }

  .v0-retrospective p::after {
    content: "”";
    position: absolute;
    right: 0.5rem;
    bottom: -3rem;
    font-size: 5rem;
    color: #4ecdc4;
    opacity: 0.15;
    font-family: serif;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .v0-retrospective {
      padding: 4rem 0;
    }
    .retro-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .v0-retrospective p {
      font-size: 1.1rem;
      padding: 0 1.5rem;
    }
    .v0-retrospective::after {
      display: none;
    }
  }
</style>
