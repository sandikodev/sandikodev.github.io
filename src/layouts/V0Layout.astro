---
import "@/styles/main.css";
import "@/styles/design-system.css";

export interface Props {
  meta_title?: string;
  description?: string;
}

const { meta_title, description } = Astro.props;

const title = meta_title ?? "sandikodev — Version History";
const desc =
  description ??
  "Archived versions of sandikodev's personal site — each major iteration preserved as a navigable snapshot.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      content="width=device-width, initial-scale=1, maximum-scale=5"
      name="viewport"
    />

    <!-- Inline theme init (dark mode only — v0 always dark) -->
    <script is:inline>
      document.documentElement.classList.add("dark");
    </script>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Fira+Code:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <link href="/logo.svg" rel="icon" type="image/svg+xml" />

    <!-- Meta -->
    <title>{title}</title>
    <meta content={desc} name="description" />
    <meta content="noindex, nofollow" name="robots" />
  </head>
  <body class="v0-body">
    <slot />

    <!-- Minimal back-to-top behaviour — no JS framework needed -->
  </body>
</html>

<style is:global>
  /* Force dark mode variables for all v0 pages */
  .v0-body {
    background: var(--color-bg);
    color: var(--color-text-main);
    font-family: "Inter", system-ui, sans-serif;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  /* Shared v0 banner — used by every archive page */
  .v0-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .v0-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: "Fira Code", "SF Mono", monospace;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .v0-breadcrumb a {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    transition: color 0.15s;
  }

  .v0-breadcrumb a:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  .v0-label {
    color: rgba(255, 255, 255, 0.3);
    flex: 1;
    font-size: 0.75rem;
  }

  .v0-link {
    font-weight: 600;
    font-size: 0.75rem;
    color: #4ecdc4;
    text-decoration: none;
    transition: opacity 0.2s;
    margin-left: auto;
  }

  .v0-link:hover {
    opacity: 0.75;
  }

  /* Retrospective Note */
  .v0-retrospective {
    max-width: 680px;
    margin: 3rem auto 0;
    padding: 2.5rem;
    background: rgba(78, 205, 196, 0.04);
    border: 1px dashed rgba(78, 205, 196, 0.2);
    border-radius: 20px;
    line-height: 1.7;
  }

  .retro-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.25rem;
  }

  .retro-tag {
    font-family: "Fira Code", monospace;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4ecdc4;
    opacity: 0.7;
  }

  .retro-header h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .v0-retrospective p {
    font-size: 0.95rem;
    color: var(--color-text-body);
    opacity: 0.8;
    margin: 0;
  }

  @media (max-width: 720px) {
    .v0-retrospective {
      margin: 2rem 1.5rem 0;
      padding: 1.75rem;
    }
  }
</style>
