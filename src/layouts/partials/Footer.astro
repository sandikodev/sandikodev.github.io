---
import config from "@/config/config.json";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">{config.site.logo_text.toLowerCase()}</a>
      <p class="footer-tagline">Building things that matter.</p>
    </div>

    <div class="footer-links">
      <a href="/">Home</a>
      <a href="/blog">Blog</a>
      <a href="/now">Now</a>
      <a href="/about">About</a>
    </div>

    <div class="footer-social">
      <a
        href={config.contactinfo.github}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
      >
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
      </a>
      <a
        href={config.contactinfo.linkedin}
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
      >
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
      <a href={`mailto:${config.contactinfo.email}`} aria-label="Email">
        <svg
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
          ></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} {config.site.logo_text}. Built with Astro.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: #fafafa;
  }

  :global(.dark) .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: #0a0a0a;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    display: grid;
    gap: 2rem;
  }

  .footer-brand {
    text-align: center;
  }

  .footer-logo {
    font-family: "Inter", sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #0a0a0a;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  :global(.dark) .footer-logo {
    color: #fafafa;
  }

  .footer-tagline {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: #737373;
  }

  :global(.dark) .footer-tagline {
    color: #737373;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-family: "Inter", sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #525252;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  :global(.dark) .footer-links a {
    color: #a3a3a3;
  }

  .footer-links a:hover {
    color: #0a0a0a;
  }

  :global(.dark) .footer-links a:hover {
    color: #fafafa;
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #525252;
    border-radius: 10px;
    transition: all 0.15s ease;
  }

  :global(.dark) .footer-social a {
    color: #a3a3a3;
  }

  .footer-social a:hover {
    color: #0a0a0a;
    background: rgba(0, 0, 0, 0.06);
  }

  :global(.dark) .footer-social a:hover {
    color: #fafafa;
    background: rgba(255, 255, 255, 0.1);
  }

  .footer-bottom {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding: 1.5rem;
    text-align: center;
  }

  :global(.dark) .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-bottom p {
    font-size: 0.875rem;
    color: #a3a3a3;
    margin: 0;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .footer-brand {
      text-align: left;
    }

    .footer-social {
      justify-content: flex-end;
    }
  }
</style>
