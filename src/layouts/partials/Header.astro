---
import menu from "@/config/menu.json";

const { main } = menu;
const currentPath = Astro.url.pathname;
---

<header class="header" id="header">
  <nav class="nav">
    <a href="/" class="logo">
      <span class="logo-text">sandikodev</span>
    </a>
    
    <div class="nav-center">
      {main.map((item) => (
        <a 
          href={item.url}
          class:list={["nav-link", { active: currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url)) }]}
        >
          {item.name}
        </a>
      ))}
    </div>

    <div class="nav-end">
      <button class="icon-btn" id="search-btn" aria-label="Search" title="Search (/)">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="8" cy="8" r="6"/>
          <path d="M14 14l4 4"/>
        </svg>
      </button>
      
      <button class="icon-btn" id="theme-btn" aria-label="Toggle theme">
        <svg class="sun" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="9" r="4"/>
          <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.5 3.5l1.5 1.5M13 13l1.5 1.5M3.5 14.5l1.5-1.5M13 5l1.5-1.5"/>
        </svg>
        <svg class="moon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 12.5A7.5 7.5 0 115.5 1a5.5 5.5 0 0011.5 11.5z"/>
        </svg>
      </button>
      
      <button class="mobile-btn" id="mobile-btn" aria-label="Menu">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path class="line1" d="M4 6h12"/>
          <path class="line2" d="M4 10h12"/>
          <path class="line3" d="M4 14h12"/>
        </svg>
      </button>
    </div>
  </nav>
  
  <div class="mobile-menu" id="mobile-menu">
    {main.map((item) => (
      <a 
        href={item.url}
        class:list={["mobile-link", { active: currentPath === item.url }]}
      >
        {item.name}
      </a>
    ))}
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }
  
  :global(.dark) .header {
    background: rgba(10, 10, 10, 0.92);
  }
  
  .nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  
  .logo-text {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #0a0a0a;
    letter-spacing: -0.02em;
  }
  
  :global(.dark) .logo-text {
    color: #fafafa;
  }
  
  .nav-center {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  
  .nav-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #525252;
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 8px;
    transition: all 0.15s ease;
  }
  
  :global(.dark) .nav-link {
    color: #a3a3a3;
  }
  
  .nav-link:hover {
    color: #0a0a0a;
    background: rgba(0, 0, 0, 0.04);
  }
  
  :global(.dark) .nav-link:hover {
    color: #fafafa;
    background: rgba(255, 255, 255, 0.06);
  }
  
  .nav-link.active {
    color: #0a0a0a;
    background: rgba(0, 0, 0, 0.06);
  }
  
  :global(.dark) .nav-link.active {
    color: #fafafa;
    background: rgba(255, 255, 255, 0.1);
  }
  
  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: #525252;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  
  :global(.dark) .icon-btn {
    color: #a3a3a3;
  }
  
  .icon-btn:hover {
    background: rgba(0, 0, 0, 0.06);
    color: #0a0a0a;
  }
  
  :global(.dark) .icon-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fafafa;
  }
  
  #theme-btn .moon { display: none; }
  :global(.dark) #theme-btn .sun { display: none; }
  :global(.dark) #theme-btn .moon { display: block; }
  
  .mobile-btn {
    display: flex;
  }
  
  .mobile-btn svg path {
    transition: all 0.2s ease;
    transform-origin: center;
  }
  
  .mobile-menu {
    display: none;
    padding: 0.5rem 1rem 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  
  :global(.dark) .mobile-menu {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  
  .mobile-menu.open {
    display: block;
  }
  
  .mobile-link {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: #525252;
    text-decoration: none;
    padding: 0.75rem 0.5rem;
    border-radius: 8px;
    transition: all 0.15s ease;
  }
  
  :global(.dark) .mobile-link {
    color: #a3a3a3;
  }
  
  .mobile-link:hover,
  .mobile-link.active {
    color: #0a0a0a;
    background: rgba(0, 0, 0, 0.04);
  }
  
  :global(.dark) .mobile-link:hover,
  :global(.dark) .mobile-link.active {
    color: #fafafa;
    background: rgba(255, 255, 255, 0.06);
  }
  
  @media (min-width: 768px) {
    .nav-center {
      display: flex;
    }
    .mobile-btn {
      display: none;
    }
  }
</style>

<script>
  // Theme toggle
  const themeBtn = document.getElementById('theme-btn');
  const html = document.documentElement;
  
  // Check saved theme or system preference
  const savedTheme = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  
  if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
    html.classList.add('dark');
  }
  
  themeBtn?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });
  
  // Mobile menu
  const mobileBtn = document.getElementById('mobile-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('open');
  });
  
  // Search shortcut
  const searchBtn = document.getElementById('search-btn');
  searchBtn?.addEventListener('click', () => {
    // Trigger command palette
    const event = new KeyboardEvent('keydown', {
      key: 'k',
      metaKey: true,
      bubbles: true
    });
    document.dispatchEvent(event);
  });
  
  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
    });
  });
</script>

<style is:global>
  body {
    padding-top: 64px;
  }
</style>
