---
import menu from "@/config/menu.json";

const { main } = menu;
const currentPath = Astro.url.pathname;
---

<header class="header" id="header">
  <nav class="nav">
    <a class="logo" href="/">
      <span class="logo-text">sandikodev</span>
    </a>

    <div class="nav-center">
      {
        main.map((item) => (
          <a
            class:list={[
              "nav-link",
              {
                active:
                  currentPath === item.url ||
                  (item.url !== "/" && currentPath.startsWith(item.url)),
              },
            ]}
            href={item.url}
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="nav-end">
      <button
        aria-label="Search"
        class="icon-btn"
        id="search-btn"
        title="Search (/)"
      >
        <svg
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-width="2"
          width="18"
        >
          <circle cx="8" cy="8" r="6"></circle>
          <path d="M14 14l4 4"></path>
        </svg>
      </button>

      <button aria-label="Toggle theme" class="icon-btn" id="theme-btn">
        <svg
          class="sun"
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-width="2"
          width="18"
        >
          <circle cx="9" cy="9" r="4"></circle>
          <path
            d="M9 1v2M9 15v2M1 9h2M15 9h2M3.5 3.5l1.5 1.5M13 13l1.5 1.5M3.5 14.5l1.5-1.5M13 5l1.5-1.5"
          >
          </path>
        </svg>
        <svg
          class="moon"
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-width="2"
          width="18"
        >
          <path d="M17 12.5A7.5 7.5 0 115.5 1a5.5 5.5 0 0011.5 11.5z"></path>
        </svg>
      </button>

      <button aria-label="Menu" class="mobile-btn" id="mobile-btn">
        <svg
          fill="none"
          height="20"
          stroke="currentColor"
          stroke-width="2"
          width="20"
        >
          <path class="line1" d="M4 6h12"></path>
          <path class="line2" d="M4 10h12"></path>
          <path class="line3" d="M4 14h12"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu">
    {
      main.map((item) => (
        <a
          class:list={["mobile-link", { active: currentPath === item.url }]}
          href={item.url}
        >
          {item.name}
        </a>
      ))
    }
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  :global(.dark) .header {
    background: rgba(15, 23, 42, 0.75);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    max-width: var(--max-width-container);
    margin: 0 auto;
    padding: 0 var(--spacing-6);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .logo-text {
    font-family: var(--font-primary);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: -0.04em;
  }

  .nav-center {
    display: none;
    align-items: center;
    gap: var(--spacing-2);
  }

  .nav-link {
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    transition: var(--transition-all);
  }

  .nav-link:hover {
    color: var(--color-primary);
    background: rgba(37, 99, 235, 0.05);
  }

  :global(.dark) .nav-link:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.active {
    color: var(--color-primary);
    background: rgba(37, 99, 235, 0.08);
  }

  :global(.dark) .nav-link.active {
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    border-radius: 8px;
    cursor: pointer;
    transition: var(--transition-all);
  }

  :global(.dark) .icon-btn {
    color: var(--color-text-muted);
  }

  .icon-btn:hover {
    background: var(--color-bg-secondary);
    color: var(--color-text-main);
  }

  :global(.dark) .icon-btn:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text-main);
  }

  #theme-btn .moon {
    display: none;
  }
  :global(.dark) #theme-btn .sun {
    display: none;
  }
  :global(.dark) #theme-btn .moon {
    display: block;
  }

  .mobile-btn {
    display: flex;
  }

  .mobile-btn svg path {
    transition: all 0.2s ease;
    transform-origin: center;
  }

  .mobile-menu {
    display: block;
    max-height: 0;
    overflow: hidden;
    padding: 0 1rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    border-top: 1px solid transparent;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.dark) .mobile-menu {
    background: rgba(15, 23, 42, 0.95);
  }

  .mobile-menu.open {
    max-height: 400px;
    padding: 1rem;
    border-top-color: var(--color-border);
  }

  .mobile-link {
    display: block;
    font-family: var(--font-primary);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.75rem 0.5rem;
    border-radius: var(--radius-md);
    transition: var(--transition-all);
  }

  :global(.dark) .mobile-link {
    color: var(--color-text-muted);
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-text-main);
    background: var(--color-bg-secondary);
  }

  :global(.dark) .mobile-link:hover,
  :global(.dark) .mobile-link.active {
    background: var(--color-bg-tertiary);
  }

  @media (min-width: 768px) {
    .nav-center {
      display: flex;
    }
    .mobile-btn {
      display: none;
    }
  }

  /* Header Scroll Hide/Show */
  .header {
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.3s;
  }

  .header.scrolled-down {
    transform: translateY(-100%);
  }

  .header.scrolled-up {
    transform: translateY(0);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  :global(.dark) .header.scrolled-up {
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
  }
</style>

<script>
  // Theme toggle with smooth transition
  const themeBtn = document.getElementById("theme-btn");
  const html = document.documentElement;

  themeBtn?.addEventListener("click", () => {
    // Add transition class
    html.classList.add("theme-transition");

    html.classList.toggle("dark");
    const isDark = html.classList.contains("dark");

    // Save with the new key to avoid collision with Workspace themes
    localStorage.setItem("appearance", isDark ? "dark" : "light");

    // Dispatch event for other components to react
    html.dispatchEvent(
      new CustomEvent("theme-change", {
        detail: { theme: isDark ? "dark" : "light" },
      }),
    );

    // Remove transition class after animation completes
    setTimeout(() => {
      html.classList.remove("theme-transition");
    }, 300);
  });

  // Mobile menu
  const mobileBtn = document.getElementById("mobile-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("open");
  });

  // Search shortcut
  const searchBtn = document.getElementById("search-btn");
  searchBtn?.addEventListener("click", () => {
    // Trigger command palette
    const event = new KeyboardEvent("keydown", {
      bubbles: true,
      key: "k",
      metaKey: true,
    });
    document.dispatchEvent(event);
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("open");
    });
  });

  // Smart Header Scroll
  let lastScrollY = window.scrollY;
  const header = document.getElementById("header");

  window.addEventListener(
    "scroll",
    () => {
      const currentScrollY = window.scrollY;

      // Don't hide header if mobile menu is open
      if (mobileMenu?.classList.contains("open")) return;

      if (header) {
        if (currentScrollY > lastScrollY && currentScrollY > 100) {
          // Scrolling down
          header.classList.add("scrolled-down");
          header.classList.remove("scrolled-up");
        } else if (currentScrollY < lastScrollY || currentScrollY <= 100) {
          // Scrolling up or at top
          header.classList.remove("scrolled-down");
          if (currentScrollY > 20) {
            header.classList.add("scrolled-up");
          } else {
            header.classList.remove("scrolled-up");
          }
        }
      }
      lastScrollY = currentScrollY;
    },
    { passive: true },
  );
</script>

<style is:global>
  body {
    padding-top: 64px;
  }
</style>
