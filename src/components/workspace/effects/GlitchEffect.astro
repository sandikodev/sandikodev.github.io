---
// Glitch effects for terminal/dev mode
---

<div class="glitch-overlay" id="glitch-overlay">
  <div class="glitch-lines"></div>
</div>

<style>
  .glitch-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .glitch-overlay.active {
    opacity: 1;
  }

  .glitch-lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255, 0, 0, 0.03) 2px,
      rgba(255, 0, 0, 0.03) 4px,
      transparent 4px
    );
    animation: glitch-scan 0.1s linear infinite;
  }

  @keyframes glitch-scan {
    0% {
      transform: translateX(0);
    }
    10% {
      transform: translateX(-2px) scaleX(1.01);
    }
    20% {
      transform: translateX(2px);
    }
    30% {
      transform: translateX(-1px) scaleX(0.99);
    }
    40% {
      transform: translateX(1px);
    }
    50% {
      transform: translateX(-3px) scaleX(1.02);
    }
    60% {
      transform: translateX(0);
    }
    70% {
      transform: translateX(2px) scaleX(0.98);
    }
    80% {
      transform: translateX(-1px);
    }
    90% {
      transform: translateX(1px) scaleX(1.01);
    }
    100% {
      transform: translateX(0);
    }
  }

  .glitch-overlay::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 255, 0, 0.02) 50%,
      transparent 100%
    );
    animation: glitch-sweep 2s ease-in-out infinite;
  }

  @keyframes glitch-sweep {
    0%,
    100% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(100%);
    }
  }

  .glitch-overlay::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(
        circle at 20% 30%,
        rgba(255, 0, 0, 0.1) 1px,
        transparent 1px
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(0, 255, 0, 0.1) 1px,
        transparent 1px
      );
    background-size:
      50px 50px,
      30px 30px;
    animation: glitch-noise 0.5s steps(10) infinite;
  }

  @keyframes glitch-noise {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }
</style>

<script>
  class GlitchEffect {
    private isActive = false;
    private overlay: HTMLElement | null = null;

    constructor() {
      this.overlay = document.getElementById("glitch-overlay");
      this.init();
    }

    public trigger(duration = 200) {
      if (!this.overlay || this.isActive) return;

      this.isActive = true;
      this.overlay.classList.add("active");

      document.body.style.transform = "translateX(2px)";
      setTimeout(() => {
        document.body.style.transform = "translateX(-1px)";
      }, 50);
      setTimeout(() => {
        document.body.style.transform = "translateX(0)";
      }, 100);

      setTimeout(() => {
        if (this.overlay) {
          this.overlay.classList.remove("active");
        }
        this.isActive = false;
      }, duration);
    }

    private init() {
      this.startRandomGlitches();
      this.setupEventTriggers();
    }

    private setupEventTriggers() {
      document.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === "k") {
          this.trigger(150);
        }
      });

      /*
      document.addEventListener("astro:page-load", () => {
        this.trigger(200);
      });
      */
    }

    private startRandomGlitches() {
      const triggerGlitch = () => {
        if (Math.random() < 0.1) {
          this.trigger(100 + Math.random() * 200);
        }
        setTimeout(triggerGlitch, 5000 + Math.random() * 10000);
      };
      setTimeout(triggerGlitch, 3000);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const isDevMode =
      document.body.classList.contains("dev-mode") ||
      window.location.pathname.startsWith("/workspace");

    if (isDevMode) {
      new GlitchEffect();
    }
  });
</script>
