---
// View Counter for posts
const { slug } = Astro.props;
---

<div class="view-counter">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
    <circle cx="12" cy="12" r="3"/>
  </svg>
  <span id={`view-count-${slug}`} class="view-count">0</span>
  <span class="view-text">views</span>
</div>

<style>
  .view-counter {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .view-counter svg {
    width: 16px;
    height: 16px;
  }

  .view-count {
    font-weight: 500;
  }
</style>

<script define:vars={{ slug }}>
  class ViewCounter {
    constructor() {
      this.slug = slug;
      this.storageKey = 'post-views';
      this.init();
    }

    init() {
      if (!this.slug) return;
      
      // Increment view count
      this.incrementView();
      
      // Display current count
      this.displayCount();
    }

    incrementView() {
      const views = this.getViews();
      const currentCount = views[this.slug] || 0;
      
      // Only increment if not viewed in last hour (prevent spam)
      const lastViewed = localStorage.getItem(`last-viewed-${this.slug}`);
      const now = Date.now();
      const oneHour = 60 * 60 * 1000;
      
      if (!lastViewed || (now - parseInt(lastViewed)) > oneHour) {
        views[this.slug] = currentCount + 1;
        localStorage.setItem(this.storageKey, JSON.stringify(views));
        localStorage.setItem(`last-viewed-${this.slug}`, now.toString());
      }
    }

    displayCount() {
      const views = this.getViews();
      const count = views[this.slug] || 0;
      const element = document.getElementById(`view-count-${this.slug}`);
      
      if (element) {
        element.textContent = this.formatCount(count);
      }
    }

    getViews() {
      try {
        return JSON.parse(localStorage.getItem(this.storageKey) || '{}');
      } catch {
        return {};
      }
    }

    formatCount(count) {
      if (count >= 1000000) {
        return (count / 1000000).toFixed(1) + 'M';
      } else if (count >= 1000) {
        return (count / 1000).toFixed(1) + 'K';
      }
      return count.toString();
    }

    // Static method to get view count for other components
    static getViewCount(slug) {
      try {
        const views = JSON.parse(localStorage.getItem('post-views') || '{}');
        return views[slug] || 0;
      } catch {
        return 0;
      }
    }
  }

  // Initialize
  new ViewCounter();
</script>
