---
import { SEO } from "astro-seo";

import config from "@/config/config.json";

export interface Props {
  article?: {
    author: string;
    expirationTime?: string;
    modifiedTime?: string;
    publishedTime: string;
    section: string;
    tags: string[];
  };
  canonical?: string;
  description?: string;
  image?: string;
  meta_title?: string;
  noindex?: boolean;
  title?: string;
  type?: "article" | "website";
}

const {
  article,
  canonical,
  description,
  image,
  meta_title,
  noindex,
  title,
  type = "website",
} = Astro.props;

const make_title = meta_title ? meta_title : title ? title : config.site.title;
const make_description = description
  ? description
  : config.metadata.meta_description;
const make_image = image ? image : config.metadata.meta_image;

// Construct full URLs
const site_url =
  config.site.base_url || Astro.site?.href || "http://localhost:4321";
const full_image_url = make_image.startsWith("http")
  ? make_image
  : `${site_url}${make_image}`;
const canonical_url = canonical || `${site_url}${Astro.url.pathname}`;
---

<SEO
  canonical={canonical_url}
  description={make_description}
  extend={{
    link: [
      { href: "/favicon.ico", rel: "icon" },
      { href: "/sitemap-index.xml", rel: "sitemap" },
    ],
    meta: [
      { content: config.metadata.meta_author, name: "author" },
      { content: Astro.generator, name: "generator" },
      { content: "en_US", property: "og:locale" },
      { content: config.metadata.meta_author, name: "twitter:site" },
    ],
  }}
  noindex={noindex}
  openGraph={{
    basic: {
      image: full_image_url,
      title: make_title,
      type: type,
      url: canonical_url,
    },
    optional: {
      description: make_description,
      siteName: config.site.title,
    },
    ...(type === "article" && article
      ? {
          article: {
            authors: [article.author],
            expirationTime: article.expirationTime,
            modifiedTime: article.modifiedTime,
            publishedTime: article.publishedTime,
            section: article.section,
            tags: article.tags,
          },
        }
      : {}),
    image: {
      alt: make_title,
      url: full_image_url,
    },
  }}
  twitter={{
    card: "summary_large_image",
    creator: config.metadata.meta_author,
    description: make_description,
    image: full_image_url,
    imageAlt: make_title,
    site: config.metadata.meta_author,
    title: make_title,
  }}
/>

<!-- Structured Data -->
<script
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    author: {
      "@type": "Person",
      name: config.metadata.meta_author,
    },
    description: config.metadata.meta_description,
    name: config.site.title,
    potentialAction: {
      "@type": "SearchAction",
      "query-input": "required name=search_term_string",
      target: `${site_url}/search?q={search_term_string}`,
    },
    url: site_url,
  })}
  type="application/ld+json"
/>
