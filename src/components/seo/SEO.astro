---
interface Props {
  article?: {
    author: string;
    modifiedTime?: string;
    publishedTime: string;
    section: string;
    tags: string[];
  };
  description: string;
  image?: string;
  title: string;
  type?: "article" | "website";
}

const { article, description, image, title, type = "website" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = image
  ? new URL(image, Astro.site)
  : new URL("/og-image.png", Astro.site);

// Person Schema (Author)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  description:
    "Full Stack Developer passionate about web development, terminal workflows, and building things that matter",
  jobTitle: "Full Stack Developer",
  knowsAbout: [
    "JavaScript",
    "TypeScript",
    "React",
    "Node.js",
    "Python",
    "Astro",
    "Web Development",
  ],
  name: "Sandikodev",
  sameAs: [
    "https://github.com/sandikodev",
    "https://linkedin.com/in/sandikodev",
    "https://twitter.com/sandikodev",
  ],
  url: "https://sandikodev.github.io",
};

// Website Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  author: personSchema,
  description:
    "Full Stack Developer Blog - Web Development, Terminal Workflows, and Tech Insights",
  name: "Sandikodev",
  potentialAction: {
    "@type": "SearchAction",
    "query-input": "required name=search_term_string",
    target: "https://sandikodev.github.io/search?q={search_term_string}",
  },
  url: "https://sandikodev.github.io",
};

// Article Schema (for blog posts)
const articleSchema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      articleSection: article.section,
      author: personSchema,
      dateModified: article.modifiedTime || article.publishedTime,
      datePublished: article.publishedTime,
      description: description,
      headline: title,
      image: socialImage.href,
      keywords: article.tags.join(", "),
      mainEntityOfPage: {
        "@id": canonicalURL.href,
        "@type": "WebPage",
      },
      publisher: {
        "@type": "Organization",
        logo: {
          "@type": "ImageObject",
          url: "https://sandikodev.github.io/logo.svg",
        },
        name: "Sandikodev",
      },
    }
  : null;
---

<!-- Basic Meta Tags -->
<title>{title}</title>
<meta content={description} name="description" />
<meta
  content="cfYDKb0-jyIGlJbyf4rhGI6Dk0oENIcHK07E2xVRv8c"
  name="google-site-verification"
/>
<link href={canonicalURL} rel="canonical" />

<!-- Critical Resource Preloading -->
<link
  as="font"
  crossorigin
  href="/fonts/inter.woff2"
  rel="preload"
  type="font/woff2"
/>
<link
  as="font"
  crossorigin
  href="/fonts/fira-code.woff2"
  rel="preload"
  type="font/woff2"
/>
<link as="image" href="/logo.svg" rel="preload" />
<link href="//fonts.googleapis.com" rel="dns-prefetch" />
<link href="//fonts.gstatic.com" rel="dns-prefetch" />
<link href="//giscus.app" rel="dns-prefetch" />

<!-- Open Graph -->
<meta content={type} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={socialImage} property="og:image" />
<meta content="Sandikodev" property="og:site_name" />

<!-- Twitter Card -->
<meta content="summary_large_image" name="twitter:card" />
<meta content="@sandikodev" name="twitter:site" />
<meta content="@sandikodev" name="twitter:creator" />
<meta content={title} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={socialImage} name="twitter:image" />

<!-- Article specific -->
{
  article && (
    <>
      <meta content={article.publishedTime} property="article:published_time" />
      {article.modifiedTime && (
        <meta content={article.modifiedTime} property="article:modified_time" />
      )}
      <meta content={article.author} property="article:author" />
      <meta content={article.section} property="article:section" />
      {article.tags.map((tag) => (
        <meta content={tag} property="article:tag" />
      ))}
    </>
  )
}

<!-- Structured Data -->
<script
  is:inline
  set:html={JSON.stringify(websiteSchema)}
  type="application/ld+json"
/>
{
  articleSchema && (
    <script
      is:inline
      set:html={JSON.stringify(articleSchema)}
      type="application/ld+json"
    />
  )
}
<script
  is:inline
  set:html={JSON.stringify(personSchema)}
  type="application/ld+json"
/>
