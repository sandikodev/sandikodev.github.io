---
// Newsletter Signup for Blog Mode
---

<div class="newsletter-signup">
  <div class="newsletter-content">
    <h3>Stay Updated</h3>
    <p>Get the latest posts delivered right to your inbox.</p>
    
    <form class="newsletter-form" id="newsletter-form">
      <div class="form-group">
        <input 
          type="email" 
          id="newsletter-email"
          placeholder="Enter your email"
          required
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-btn">
          Subscribe
        </button>
      </div>
      <p class="newsletter-note">
        No spam, unsubscribe at any time.
      </p>
    </form>

    <div id="newsletter-success" class="newsletter-message success" style="display: none;">
      ✅ Thanks for subscribing! Check your email to confirm.
    </div>

    <div id="newsletter-error" class="newsletter-message error" style="display: none;">
      ❌ Something went wrong. Please try again.
    </div>
  </div>
</div>

<style>
  .newsletter-signup {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 2rem;
    margin: 2rem 0;
    text-align: center;
  }

  .newsletter-content h3 {
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
    font-family: var(--font-heading);
  }

  .newsletter-content p {
    margin: 0 0 1.5rem 0;
    color: var(--color-text-muted);
  }

  .form-group {
    display: flex;
    gap: 0.5rem;
    max-width: 400px;
    margin: 0 auto 1rem auto;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-size: 1rem;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .newsletter-btn {
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 0.375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .newsletter-btn:hover {
    background: var(--color-primary-hover);
  }

  .newsletter-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .newsletter-message {
    padding: 0.75rem;
    border-radius: 0.375rem;
    margin-top: 1rem;
  }

  .newsletter-message.success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .newsletter-message.error {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .form-group {
      flex-direction: column;
    }
    
    .newsletter-signup {
      padding: 1.5rem;
    }
  }
</style>

<script>
  class NewsletterSignup {
    constructor() {
      this.form = document.getElementById('newsletter-form');
      this.emailInput = document.getElementById('newsletter-email');
      this.successMsg = document.getElementById('newsletter-success');
      this.errorMsg = document.getElementById('newsletter-error');
      this.init();
    }

    init() {
      if (this.form) {
        this.form.addEventListener('submit', (e) => this.handleSubmit(e));
      }
    }

    async handleSubmit(e) {
      e.preventDefault();
      
      const email = this.emailInput.value.trim();
      if (!email) return;

      const submitBtn = this.form.querySelector('.newsletter-btn');
      const originalText = submitBtn.textContent;
      
      // Show loading state
      submitBtn.textContent = 'Subscribing...';
      submitBtn.disabled = true;
      
      try {
        // Simulate API call (replace with actual newsletter service)
        await this.subscribeEmail(email);
        this.showSuccess();
        this.form.reset();
      } catch (error) {
        this.showError();
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    }

    async subscribeEmail(email) {
      // Replace this with your actual newsletter service
      // Examples: ConvertKit, Mailchimp, Buttondown, etc.
      
      // For now, just simulate success
      return new Promise((resolve) => {
        setTimeout(() => {
          console.log('Newsletter signup:', email);
          resolve();
        }, 1000);
      });
      
      // Example with ConvertKit:
      // const response = await fetch('https://api.convertkit.com/v3/forms/YOUR_FORM_ID/subscribe', {
      //   method: 'POST',
      //   headers: { 'Content-Type': 'application/json' },
      //   body: JSON.stringify({
      //     api_key: 'YOUR_API_KEY',
      //     email: email
      //   })
      // });
      // 
      // if (!response.ok) throw new Error('Subscription failed');
    }

    showSuccess() {
      this.hideMessages();
      this.successMsg.style.display = 'block';
      setTimeout(() => this.hideMessages(), 5000);
    }

    showError() {
      this.hideMessages();
      this.errorMsg.style.display = 'block';
      setTimeout(() => this.hideMessages(), 5000);
    }

    hideMessages() {
      this.successMsg.style.display = 'none';
      this.errorMsg.style.display = 'none';
    }
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new NewsletterSignup());
  } else {
    new NewsletterSignup();
  }
</script>
