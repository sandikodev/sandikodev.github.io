---
import { calculateReadingTime } from "@/lib/utils/readingTime";

interface Props {
  variant?: 'simple' | 'enhanced';
  showTimeEstimate?: boolean;
  showPercentage?: boolean;
  content?: string;
}

const { 
  variant = 'simple', 
  showTimeEstimate = false, 
  showPercentage = false,
  content = ''
} = Astro.props;

const readingTimeMinutes = content ? calculateReadingTime(content) : 0;
---

<div 
  id="reading-progress" 
  class={`reading-progress ${variant}`}
  data-reading-time={readingTimeMinutes}
>
  <div class="progress-fill"></div>
  {variant === 'enhanced' && (
    <div class="progress-info">
      {showPercentage && <span id="progress-text">0%</span>}
      {showTimeEstimate && <span id="time-left">{readingTimeMinutes} min left</span>}
    </div>
  )}
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(0, 0, 0, 0.05);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .reading-progress.visible {
    opacity: 1;
  }
  
  .reading-progress.simple {
    top: 64px;
    height: 2px;
    background: rgba(0, 0, 0, 0.08);
  }
  
  :global(.dark) .reading-progress.simple {
    background: rgba(255, 255, 255, 0.1);
  }
  
  :global(.dark) .reading-progress {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .reading-progress.enhanced {
    height: 3px;
    background: rgba(0, 0, 0, 0.05);
  }
  
  :global(.dark) .reading-progress.enhanced {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #8b5cf6);
    width: 0%;
    transition: width 0.15s ease;
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.3);
  }
  
  :global(.dark) .progress-fill {
    background: linear-gradient(90deg, #7c3aed, #a855f7);
    box-shadow: 0 0 8px rgba(124, 58, 237, 0.4);
  }
  
  .progress-info {
    position: absolute;
    top: 8px;
    right: 1rem;
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-secondary, #6b7280);
    background: var(--bg-primary, #fff);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s ease;
  }
  
  .reading-progress.visible .progress-info {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const progressBar = document.getElementById('reading-progress');
  const progressFill = progressBar?.querySelector('.progress-fill') as HTMLElement;
  const progressText = document.getElementById('progress-text');
  const timeLeft = document.getElementById('time-left');
  
  const readingTime = parseInt(progressBar?.dataset.readingTime || '0');
  
  function updateProgress() {
    const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrolled = window.scrollY;
    const progress = Math.min((scrolled / scrollHeight) * 100, 100);
    
    if (progressFill) {
      progressFill.style.width = `${progress}%`;
    }
    
    if (progressText) {
      progressText.textContent = `${Math.round(progress)}%`;
    }
    
    if (timeLeft && readingTime > 0) {
      const remaining = Math.max(0, Math.ceil(readingTime * (1 - progress / 100)));
      timeLeft.textContent = `${remaining} min left`;
    }
    
    // Show/hide progress bar
    if (progressBar) {
      if (scrolled > 100) {
        progressBar.classList.add('visible');
      } else {
        progressBar.classList.remove('visible');
      }
    }
  }
  
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
