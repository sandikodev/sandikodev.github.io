---
// Enhance code blocks with macOS/IDE-style header bar, language badge, copy and bookmark buttons
---

<style is:global>
  .code-block-wrapper {
    position: relative;
    margin: 1.75rem 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.08);
  }
  .code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.75rem;
    user-select: none;
  }
  .code-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .window-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }
  .code-block-wrapper:hover .dot {
    opacity: 1;
  }
  .dot-red {
    background-color: #ff5f56;
  }
  .dot-yellow {
    background-color: #ffbd2e;
  }
  .dot-green {
    background-color: #27c93f;
  }
  .code-lang {
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .code-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .code-action-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    padding: 0.3rem 0.45rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .code-action-btn:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    color: var(--color-text-main);
  }
  .code-action-btn svg {
    display: block;
    width: 15px;
    height: 15px;
  }
</style>

<script>
  // Helper to determine friendly language badge
  function detectLanguage(pre: HTMLPreElement, code: HTMLElement): string {
    const rawAttr =
      pre.getAttribute("data-language") ||
      code.getAttribute("data-language") ||
      "";
    const classMatch =
      code.className.match(/language-([a-zA-Z0-9_\-#+]+)/)?.[1] ||
      pre.className.match(/language-([a-zA-Z0-9_\-#+]+)/)?.[1] ||
      "";

    let lang = (rawAttr || classMatch).toLowerCase().trim();
    const codeText = (code.textContent || "").trim();

    // Auto-detection heuristics if language is missing or generic text
    if (!lang || lang === "text" || lang === "plaintext") {
      if (
        codeText.startsWith("npm ") ||
        codeText.startsWith("pnpm ") ||
        codeText.startsWith("bun ") ||
        codeText.startsWith("yarn ") ||
        codeText.startsWith("git ") ||
        codeText.startsWith("curl ") ||
        codeText.startsWith("wget ") ||
        codeText.startsWith("sudo ") ||
        codeText.startsWith("cd ") ||
        codeText.startsWith("mkdir ") ||
        codeText.startsWith("docker ") ||
        codeText.startsWith("kubectl ") ||
        codeText.startsWith("chmod ") ||
        codeText.startsWith("chown ") ||
        codeText.startsWith("apt ") ||
        codeText.startsWith("brew ") ||
        codeText.startsWith("$ ")
      ) {
        lang = "bash";
      } else if (
        codeText.startsWith("Get-") ||
        codeText.startsWith("Set-") ||
        codeText.startsWith("Install-Module") ||
        codeText.startsWith("PS ") ||
        codeText.startsWith("pwsh")
      ) {
        lang = "powershell";
      } else if (
        codeText.startsWith("@echo") ||
        codeText.startsWith("REM ") ||
        codeText.startsWith("dir ") ||
        codeText.startsWith("cls")
      ) {
        lang = "cmd";
      } else if (
        codeText.startsWith("<!DOCTYPE") ||
        codeText.startsWith("<html") ||
        codeText.startsWith("<template") ||
        codeText.startsWith("<div")
      ) {
        lang = "html";
      } else if (
        (codeText.startsWith("{") && codeText.endsWith("}")) ||
        (codeText.startsWith("[") && codeText.endsWith("]"))
      ) {
        try {
          JSON.parse(codeText);
          lang = "json";
        } catch {
          // not valid json
        }
      } else if (
        codeText.startsWith("import ") ||
        codeText.startsWith("export ") ||
        codeText.startsWith("const ") ||
        codeText.startsWith("let ") ||
        codeText.startsWith("class ")
      ) {
        lang = "typescript";
      }
    }

    const friendlyNames: Record<string, string> = {
      ts: "TYPESCRIPT",
      typescript: "TYPESCRIPT",
      js: "JAVASCRIPT",
      javascript: "JAVASCRIPT",
      mjs: "JAVASCRIPT",
      cjs: "JAVASCRIPT",
      jsx: "REACT JSX",
      tsx: "REACT TSX",
      astro: "ASTRO",
      svelte: "SVELTE",
      vue: "VUE",
      html: "HTML",
      css: "CSS",
      scss: "SCSS",
      sass: "SASS",
      less: "LESS",
      bash: "BASH",
      sh: "SHELL",
      shell: "SHELL",
      zsh: "ZSH",
      powershell: "POWERSHELL",
      ps: "POWERSHELL",
      ps1: "POWERSHELL",
      pwsh: "POWERSHELL",
      cmd: "CMD",
      bat: "BATCH",
      batch: "BATCH",
      dos: "DOS",
      py: "PYTHON",
      python: "PYTHON",
      rs: "RUST",
      rust: "RUST",
      go: "GO",
      golang: "GO",
      java: "JAVA",
      cs: "C#",
      csharp: "C#",
      "c#": "C#",
      cpp: "C++",
      "c++": "C++",
      c: "C",
      json: "JSON",
      jsonc: "JSON",
      json5: "JSON5",
      yaml: "YAML",
      yml: "YAML",
      toml: "TOML",
      sql: "SQL",
      md: "MARKDOWN",
      markdown: "MARKDOWN",
      mdx: "MDX",
      docker: "DOCKER",
      dockerfile: "DOCKER",
      nginx: "NGINX",
      graphql: "GRAPHQL",
      gql: "GRAPHQL",
      angular: "ANGULAR",
      "angular-ts": "ANGULAR",
      "angular-html": "ANGULAR HTML",
      angularjs: "ANGULARJS",
      aurelia: "AURELIA",
      aureliajs: "AURELIA",
      "aurelia-ts": "AURELIA TS",
      "aurelia-html": "AURELIA HTML",
      xml: "XML",
      php: "PHP",
      ruby: "RUBY",
      rb: "RUBY",
      swift: "SWIFT",
      kt: "KOTLIN",
      kotlin: "KOTLIN",
      dts: "DEVICE TREE",
      diff: "DIFF",
      regex: "REGEX",
      text: "TEXT",
      plaintext: "TEXT",
    };

    return friendlyNames[lang] || (lang ? lang.toUpperCase() : "CODE");
  }

  // Check if block is diagram or math
  function isDiagramOrMath(pre: HTMLPreElement, code: HTMLElement): boolean {
    const rawAttr = (
      pre.getAttribute("data-language") ||
      code.getAttribute("data-language") ||
      ""
    ).toLowerCase();

    if (
      rawAttr === "mermaid" ||
      rawAttr === "math" ||
      rawAttr === "latex" ||
      rawAttr === "katex"
    ) {
      return true;
    }

    if (
      pre.classList.contains("mermaid") ||
      pre.classList.contains("language-mermaid") ||
      code.classList.contains("language-mermaid") ||
      pre.classList.contains("katex") ||
      pre.classList.contains("math")
    ) {
      return true;
    }

    const trimmed = (code.textContent || "").trim();
    if (
      trimmed.startsWith("graph ") ||
      trimmed.startsWith("flowchart ") ||
      trimmed.startsWith("sequenceDiagram") ||
      trimmed.startsWith("classDiagram") ||
      trimmed.startsWith("stateDiagram") ||
      trimmed.startsWith("erDiagram") ||
      trimmed.startsWith("gantt") ||
      trimmed.startsWith("pie") ||
      trimmed.startsWith("journey") ||
      trimmed.startsWith("mindmap") ||
      trimmed.startsWith("timeline") ||
      trimmed.startsWith("gitGraph") ||
      trimmed.startsWith("C4Context") ||
      trimmed.startsWith("xychart-beta")
    ) {
      return true;
    }

    return false;
  }

  // Enhance all code blocks
  function enhanceCodeBlocks() {
    const codeBlocks = document.querySelectorAll("pre");

    codeBlocks.forEach((pre) => {
      // Skip if already enhanced
      if (pre.parentElement?.classList.contains("code-block-wrapper")) {
        return;
      }

      const code = pre.querySelector("code");
      if (!code) return;

      // Skip diagram languages and diagram content
      if (isDiagramOrMath(pre, code)) {
        return;
      }

      const codeText = code.textContent || "";
      const displayLang = detectLanguage(pre, code);

      // Wrap in container
      const wrapper = document.createElement("div");
      wrapper.className = "code-block-wrapper";
      pre.parentNode?.insertBefore(wrapper, pre);

      // Create header bar
      const header = document.createElement("div");
      header.className = "code-header";

      const left = document.createElement("div");
      left.className = "code-header-left";
      left.innerHTML = `
        <div class="window-dots" aria-hidden="true">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <span class="code-lang">${displayLang}</span>
      `;

      // Copy button
      const copyBtn = document.createElement("button");
      copyBtn.className = "code-action-btn";
      copyBtn.title = "Copy code";
      copyBtn.innerHTML = `
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
      `;
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(codeText).then(() => {
          copyBtn.classList.add("active");
          copyBtn.innerHTML = `
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          `;

          // Add a temporary "Copied!" label
          const label = document.createElement("span");
          label.textContent = "Copied!";
          label.style.position = "absolute";
          label.style.right = "100%";
          label.style.marginRight = "8px";
          label.style.padding = "2px 6px";
          label.style.fontSize = "10px";
          label.style.backgroundColor = "var(--color-primary)";
          label.style.color = "white";
          label.style.borderRadius = "4px";
          label.style.whiteSpace = "nowrap";
          label.style.top = "50%";
          label.style.transform = "translateY(-50%)";
          copyBtn.appendChild(label);

          setTimeout(() => {
            copyBtn.classList.remove("active");
            label.remove();
            copyBtn.innerHTML = `
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
              </svg>
            `;
          }, 2000);
        });
      });

      // Bookmark button
      const bookmarkBtn = document.createElement("button");
      bookmarkBtn.className = "code-action-btn";
      bookmarkBtn.title = "Save snippet";
      bookmarkBtn.innerHTML = `
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
        </svg>
      `;
      bookmarkBtn.addEventListener("click", () => {
        if ((window as any).addSnippet) {
          (window as any).addSnippet(codeText, displayLang);
        }
        bookmarkBtn.innerHTML = `
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
          </svg>
        `;
        setTimeout(() => {
          bookmarkBtn.innerHTML = `
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
            </svg>
          `;
        }, 2000);
      });

      const actions = document.createElement("div");
      actions.className = "code-actions";
      actions.appendChild(copyBtn);
      actions.appendChild(bookmarkBtn);

      header.appendChild(left);
      header.appendChild(actions);

      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });
  }

  // Run on load and after view transitions
  document.addEventListener("astro:page-load", enhanceCodeBlocks);

  // also run immediately if ready (fallback)
  if (document.readyState !== "loading") {
    enhanceCodeBlocks();
  }
</script>
