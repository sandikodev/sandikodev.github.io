---
// Enhance code blocks with copy and bookmark buttons
---

<style is:global>
  .code-block-wrapper {
    position: relative;
  }
  .code-actions {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.5rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .code-block-wrapper:hover .code-actions {
    opacity: 1;
  }
  .code-action-btn {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    padding: 0.5rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s;
    backdrop-filter: blur(4px);
  }
  .code-action-btn:hover {
    background: var(--color-bg-tertiary);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }
  .code-action-btn svg {
    display: block;
    width: 16px;
    height: 16px;
  }
</style>

<script>
  // Enhance all code blocks
  function enhanceCodeBlocks() {
    const codeBlocks = document.querySelectorAll("pre");

    codeBlocks.forEach((pre) => {
      // Skip if already enhanced
      if (pre.parentElement?.classList.contains("code-block-wrapper")) {
        return;
      }

      const code = pre.querySelector("code");
      if (!code) return;

      const codeText = code.textContent || "";
      const language = code.className.match(/language-(\w+)/)?.[1] || "text";

      // Wrap in container
      const wrapper = document.createElement("div");
      wrapper.className = "code-block-wrapper";
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      // Create actions
      const actions = document.createElement("div");
      actions.className = "code-actions";

      // Copy button
      const copyBtn = document.createElement("button");
      copyBtn.className = "code-action-btn";
      copyBtn.title = "Copy code";
      copyBtn.innerHTML = `
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
      `;
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(codeText).then(() => {
          copyBtn.classList.add("active");
          copyBtn.innerHTML = `
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          `;

          // Add a temporary "Copied!" label
          const label = document.createElement("span");
          label.textContent = "Copied!";
          label.style.position = "absolute";
          label.style.right = "100%";
          label.style.marginRight = "8px";
          label.style.padding = "2px 6px";
          label.style.fontSize = "10px";
          label.style.backgroundColor = "var(--color-primary)";
          label.style.color = "white";
          label.style.borderRadius = "4px";
          label.style.whiteSpace = "nowrap";
          label.style.top = "50%";
          label.style.transform = "translateY(-50%)";
          copyBtn.appendChild(label);

          setTimeout(() => {
            copyBtn.classList.remove("active");
            label.remove();
            copyBtn.innerHTML = `
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
              </svg>
            `;
          }, 2000);
        });
      });

      // Bookmark button
      const bookmarkBtn = document.createElement("button");
      bookmarkBtn.className = "code-action-btn";
      bookmarkBtn.title = "Save snippet";
      bookmarkBtn.innerHTML = `
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
        </svg>
      `;
      bookmarkBtn.addEventListener("click", () => {
        (window as any).addSnippet(codeText, language);
        bookmarkBtn.innerHTML = `
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
          </svg>
        `;
        setTimeout(() => {
          bookmarkBtn.innerHTML = `
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
            </svg>
          `;
        }, 2000);
      });

      actions.appendChild(copyBtn);
      actions.appendChild(bookmarkBtn);
      wrapper.appendChild(actions);
    });
  }

  // Run on load and after view transitions
  document.addEventListener("astro:page-load", enhanceCodeBlocks);

  // also run immediately if ready (fallback)
  if (document.readyState !== "loading") {
    enhanceCodeBlocks();
  }
</script>
