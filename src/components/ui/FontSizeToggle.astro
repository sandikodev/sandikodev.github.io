---
// Font Size Toggle for Blog Mode (V1)
// A- A A+ accessibility feature
---

<div class="font-size-toggle">
  <button class="font-btn" data-size="small" title="Decrease font size">
    A-
  </button>
  <button class="font-btn" data-size="normal" title="Normal font size">
    A
  </button>
  <button class="font-btn" data-size="large" title="Increase font size">
    A+
  </button>
</div>

<style>
  .font-size-toggle {
    display: flex;
    gap: 0.125rem;
    align-items: center;
  }

  .font-btn {
    background: transparent;
    border: 1px solid var(--color-border-alpha);
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
    cursor: pointer;
    font-family: var(--font-primary, inherit);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    font-size: 0.75rem;
  }

  .font-btn:hover {
    background: var(--color-bg-tertiary);
    border-color: var(--color-border-alpha-hover);
    color: var(--color-text-main);
  }

  .font-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
  }

  /* Mobile/Floating fallback if absolutely positioned elsewhere */
  @media (max-width: 768px) {
    .font-size-toggle {
      background: var(--color-backdrop);
      backdrop-filter: blur(12px);
      border: 1px solid var(--color-border-alpha);
      padding: 0.25rem;
      border-radius: 0.5rem;
    }
  }
</style>

<script>
  class FontSizeToggle {
    constructor() {
      this.init();
    }

    init() {
      // Load saved font size
      const saved = localStorage.getItem("blog-font-size") || "normal";
      this.setFontSize(saved);
      this.updateActiveButton(saved);

      // Add event listeners
      document.querySelectorAll(".font-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const size = target.dataset.size || "normal";
          this.setFontSize(size);
          this.updateActiveButton(size);
          localStorage.setItem("blog-font-size", size);
        });
      });
    }

    setFontSize(size: string) {
      const root = document.documentElement;

      switch (size) {
        case "large":
          root.style.setProperty("--font-scale", "1.15");
          break;
        case "small":
          root.style.setProperty("--font-scale", "0.9");
          break;
        default: // normal
          root.style.setProperty("--font-scale", "1");
      }
    }

    updateActiveButton(size: string) {
      document.querySelectorAll(".font-btn").forEach((btn) => {
        const button = btn as HTMLButtonElement;
        button.classList.toggle("active", button.dataset.size === size);
      });
    }
  }

  // Initialize when DOM is ready
  const init = () => {
    if (document.querySelector(".font-size-toggle")) {
      new FontSizeToggle();
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // Re-init on view transitions
  document.addEventListener("astro:after-swap", init);
</script>
