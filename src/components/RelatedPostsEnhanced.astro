---
import { getCollection } from "astro:content";
import { slugify } from "@/lib/utils/textConverter";
import dateFormat from "@/lib/utils/dateFormat";

interface Props {
  currentSlug: string;
  currentTags: string[];
  currentCategories: string[];
  limit?: number;
}

const { currentSlug, currentTags = [], currentCategories = [], limit = 3 } = Astro.props;

// Get all posts
const posts = await getCollection("posts");
const publishedPosts = posts.filter(post => !post.data.draft);

// Calculate similarity score
function calculateSimilarity(post: any) {
  let score = 0;
  
  // Tag similarity (higher weight)
  const postTags = post.data.tags || [];
  const commonTags = postTags.filter((tag: string) => 
    currentTags.some(currentTag => slugify(currentTag) === slugify(tag))
  );
  score += commonTags.length * 3;
  
  // Category similarity
  const postCategories = post.data.categories || [];
  const commonCategories = postCategories.filter((cat: string) => 
    currentCategories.some(currentCat => slugify(currentCat) === slugify(cat))
  );
  score += commonCategories.length * 2;
  
  // Recency bonus (newer posts get slight boost)
  const daysSincePublished = Math.floor(
    (Date.now() - new Date(post.data.date).getTime()) / (1000 * 60 * 60 * 24)
  );
  score += Math.max(0, 30 - daysSincePublished) * 0.1;
  
  return score;
}

// Get related posts
const relatedPosts = publishedPosts
  .filter(post => post.slug !== currentSlug)
  .map(post => ({
    ...post,
    similarity: calculateSimilarity(post)
  }))
  .filter(post => post.similarity > 0)
  .sort((a, b) => b.similarity - a.similarity)
  .slice(0, limit);

// Determine base path (blog or workspace)
const isWorkspace = Astro.url.pathname.startsWith('/workspace');
const basePath = isWorkspace ? '/workspace/blog' : '/blog';
---

{relatedPosts.length > 0 && (
  <section class="related-posts">
    <h3 class="related-posts-title">Related Posts</h3>
    <div class="related-posts-grid">
      {relatedPosts.map((post) => (
        <article class="related-post-card">
          <a href={`${basePath}/${post.slug}`} class="related-post-link">
            <div class="related-post-content">
              <h4 class="related-post-title">{post.data.title}</h4>
              <p class="related-post-excerpt">
                {post.data.description || post.body.slice(0, 120) + '...'}
              </p>
              <div class="related-post-meta">
                <time class="related-post-date">
                  {dateFormat(post.data.date)}
                </time>
                {post.data.categories && post.data.categories.length > 0 && (
                  <span class="related-post-category">
                    {post.data.categories[0]}
                  </span>
                )}
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="related-post-tags">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="related-post-tag">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts {
    margin: 3rem 0;
    padding: 2rem 0;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  
  .related-posts-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--text-primary, #1f2937);
  }
  
  .related-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  
  .related-post-card {
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
    background: var(--bg-primary, #fff);
  }
  
  .related-post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    border-color: var(--accent, #3b82f6);
  }
  
  .related-post-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  
  .related-post-content {
    padding: 1.5rem;
  }
  
  .related-post-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.75rem;
    color: var(--text-primary, #1f2937);
  }
  
  .related-post-excerpt {
    color: var(--text-secondary, #6b7280);
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  
  .related-post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  
  .related-post-date {
    color: var(--text-secondary, #6b7280);
  }
  
  .related-post-category {
    background: var(--accent, #3b82f6);
    color: white;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  
  .related-post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .related-post-tag {
    background: var(--bg-secondary, #f3f4f6);
    color: var(--text-secondary, #6b7280);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }
  
  /* Dev Mode styling */
  [data-theme-mode="terminal"] .related-posts {
    border-top-color: #414868;
  }
  
  [data-theme-mode="terminal"] .related-posts-title {
    color: #c0caf5;
  }
  
  [data-theme-mode="terminal"] .related-post-card {
    background: rgba(26, 27, 38, 0.5);
    border-color: #414868;
  }
  
  [data-theme-mode="terminal"] .related-post-card:hover {
    border-color: #7aa2f7;
    background: rgba(26, 27, 38, 0.8);
  }
  
  [data-theme-mode="terminal"] .related-post-title {
    color: #c0caf5;
  }
  
  [data-theme-mode="terminal"] .related-post-excerpt {
    color: #a9b1d6;
  }
  
  [data-theme-mode="terminal"] .related-post-date {
    color: #7aa2f7;
  }
  
  [data-theme-mode="terminal"] .related-post-category {
    background: #7aa2f7;
  }
  
  [data-theme-mode="terminal"] .related-post-tag {
    background: rgba(65, 72, 104, 0.5);
    color: #a9b1d6;
  }
  
  @media (max-width: 768px) {
    .related-posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
