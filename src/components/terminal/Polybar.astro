---
const currentPath = Astro.url.pathname;

const workspaces = [
  { id: 1, name: "home", href: "/", icon: "●" },
  { id: 2, name: "blog", href: "/blog-tiling", icon: "●" },
  { id: 3, name: "about", href: "/about", icon: "●" },
  { id: 4, name: "term", href: "/workspace/terminal", icon: "●" },
];

const isActive = (href: string) => currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<header class="polybar">
  <div class="polybar-left">
    <!-- Mode indicator -->
    <span class="bar-mode" id="bar-mode">NORMAL</span>
    
    <!-- Workspaces -->
    <nav class="workspaces">
      {workspaces.map(ws => (
        <a 
          href={ws.href} 
          class={`workspace ${isActive(ws.href) ? 'active' : ''}`}
          data-ws={ws.id}
        >
          {ws.id}:{ws.name}
        </a>
      ))}
    </nav>
  </div>
  
  <div class="polybar-center">
    <span class="bar-title" id="bar-title">dev@enigma</span>
  </div>
  
  <div class="polybar-right">
    <!-- CPU -->
    <span class="bar-module" title="CPU">
      <span class="module-icon">⚡</span>
      <span class="module-value" id="cpu-usage">12%</span>
    </span>
    
    <span class="bar-sep">│</span>
    
    <!-- Memory -->
    <span class="bar-module" title="Memory">
      <span class="module-icon">💾</span>
      <span class="module-value" id="mem-usage">4.2G</span>
    </span>
    
    <span class="bar-sep">│</span>
    
    <!-- Network -->
    <span class="bar-module" title="Network">
      <span class="module-icon">📶</span>
      <span class="module-value">eth0</span>
    </span>
    
    <span class="bar-sep">│</span>
    
    <!-- Time -->
    <span class="bar-module">
      <span class="module-icon">🕐</span>
      <span class="module-value" id="bar-time">00:00</span>
    </span>
    
    <span class="bar-sep">│</span>
    
    <!-- Date -->
    <span class="bar-module">
      <span class="module-icon">📅</span>
      <span class="module-value" id="bar-date">Mon 01</span>
    </span>
  </div>
</header>

<style>
  .polybar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 28px;
    padding: 0 8px;
    background: var(--bar-bg);
    border-bottom: 1px solid var(--i3-border-unfocused);
    font-family: var(--font-mono);
    font-size: 12px;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .polybar-left, .polybar-center, .polybar-right {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .polybar-left { flex: 1; }
  .polybar-center { flex: 0; }
  .polybar-right { flex: 1; justify-content: flex-end; }

  .bar-mode {
    padding: 2px 8px;
    background: var(--blue);
    color: var(--i3-bg);
    font-weight: 600;
    font-size: 10px;
    margin-right: 8px;
  }

  .bar-mode[data-mode="resize"] { background: var(--yellow); }
  .bar-mode[data-mode="move"] { background: var(--magenta); }

  .workspaces {
    display: flex;
    gap: 2px;
  }

  .workspace {
    padding: 4px 10px;
    background: transparent;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 11px;
    transition: all 0.1s;
  }

  .workspace:hover {
    background: var(--i3-title-bg);
    color: var(--bar-fg);
  }

  .workspace.active {
    background: var(--bar-accent);
    color: var(--i3-bg);
    font-weight: 600;
  }

  .workspace.urgent {
    background: var(--i3-border-urgent);
    color: var(--i3-bg);
    animation: urgent-pulse 1s infinite;
  }

  @keyframes urgent-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .bar-title {
    color: var(--bar-fg);
    font-weight: 500;
  }

  .bar-module {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--bar-fg);
  }

  .module-icon {
    font-size: 10px;
  }

  .module-value {
    color: var(--text-secondary);
  }

  .bar-sep {
    color: var(--i3-border-unfocused);
    margin: 0 4px;
  }

  @media (max-width: 768px) {
    .polybar-center { display: none; }
    .bar-module:nth-child(n+3):nth-child(-n+6) { display: none; }
    .bar-sep:nth-child(n+4):nth-child(-n+7) { display: none; }
  }
</style>

<script>
  // Update time
  function updateTime() {
    const now = new Date();
    const time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
    const date = now.toLocaleDateString('en-US', { weekday: 'short', day: '2-digit' });
    
    const timeEl = document.getElementById('bar-time');
    const dateEl = document.getElementById('bar-date');
    if (timeEl) timeEl.textContent = time;
    if (dateEl) dateEl.textContent = date;
  }
  
  // Mock CPU/Memory updates
  function updateStats() {
    const cpu = Math.floor(Math.random() * 30 + 5);
    const mem = (Math.random() * 4 + 2).toFixed(1);
    
    const cpuEl = document.getElementById('cpu-usage');
    const memEl = document.getElementById('mem-usage');
    if (cpuEl) cpuEl.textContent = cpu + '%';
    if (memEl) memEl.textContent = mem + 'G';
  }
  
  updateTime();
  updateStats();
  setInterval(updateTime, 1000);
  setInterval(updateStats, 5000);
</script>
