---
// dmenu style launcher - triggered by mod+d (Alt+d or Ctrl+d)
import config from "@/config/config.json";
---

<div class="dmenu-overlay hidden" id="dmenu">
  <div class="dmenu">
    <span class="dmenu-prompt">run:</span>
    <input
      autocomplete="off"
      class="dmenu-input"
      id="dmenu-input"
      placeholder=""
      type="text"
    />
    <div class="dmenu-items" id="dmenu-items">
      <a class="dmenu-item" data-cat="nav" href="/">🏠 home</a>
      <a class="dmenu-item" data-cat="nav" href="/blog">📝 blog</a>
      <a class="dmenu-item" data-cat="nav" href="/about">👤 about</a>
      <a class="dmenu-item" data-cat="nav" href="/workspace/terminal">
        💻 terminal
      </a>
      <a class="dmenu-item" data-cat="nav" href="/terminal-features">
        ⚡ features
      </a>
      <button class="dmenu-item" data-action="theme" data-cat="action">
        🎨 theme
      </button>
      <button class="dmenu-item" data-action="scratchpad" data-cat="action">
        📋 scratchpad
      </button>
      <a
        class="dmenu-item"
        data-cat="link"
        href={config.contactinfo.github}
        target="_blank"
      >
        🔗 github
      </a>
    </div>
  </div>
</div>

<!-- Notification toast -->
<div class="i3-notify hidden" id="i3-notify">
  <span id="notify-text"></span>
</div>

<style>
  .dmenu-overlay {
    position: fixed;
    top: 28px;
    left: 0;
    right: 0;
    z-index: 200;
    display: flex;
    justify-content: center;
    padding: 8px;
  }

  .dmenu-overlay.hidden {
    display: none;
  }

  .dmenu {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 700px;
    height: 28px;
    background: var(--i3-bg);
    border: 2px solid var(--i3-border-focused);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .dmenu-prompt {
    padding: 0 12px;
    background: var(--bar-accent);
    color: var(--i3-bg);
    font-weight: 600;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .dmenu-input {
    flex: 0 0 150px;
    padding: 0 12px;
    background: transparent;
    border: none;
    border-right: 1px solid var(--i3-border-unfocused);
    outline: none;
    color: var(--text-primary);
    font-family: inherit;
    font-size: inherit;
    height: 100%;
  }

  .dmenu-items {
    display: flex;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .dmenu-items::-webkit-scrollbar {
    display: none;
  }

  .dmenu-item {
    padding: 0 12px;
    color: var(--text-secondary);
    text-decoration: none;
    height: 28px;
    display: flex;
    align-items: center;
    white-space: nowrap;
    background: transparent;
    border: none;
    border-left: 1px solid var(--i3-border-unfocused);
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
  }

  .dmenu-item:first-child {
    border-left: none;
  }

  .dmenu-item:hover,
  .dmenu-item.selected {
    background: var(--bar-accent);
    color: var(--i3-bg);
  }

  .dmenu-item.hidden {
    display: none;
  }

  /* Notification */
  .i3-notify {
    position: fixed;
    bottom: 40px;
    right: 16px;
    padding: 12px 20px;
    background: var(--i3-title-bg);
    border: 2px solid var(--i3-border-focused);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    z-index: 300;
    animation: notify-in 0.2s ease;
  }

  .i3-notify.hidden {
    display: none;
  }

  @keyframes notify-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const dmenu = document.getElementById("dmenu");
  const input = document.getElementById("dmenu-input") as HTMLInputElement;
  const items = document.querySelectorAll(".dmenu-item");
  const notify = document.getElementById("i3-notify");
  const notifyText = document.getElementById("notify-text");
  let selectedIndex = 0;

  function showNotify(msg: string) {
    if (notifyText) notifyText.textContent = msg;
    notify?.classList.remove("hidden");
    setTimeout(() => notify?.classList.add("hidden"), 2000);
  }

  // Open with mod+d
  document.addEventListener("keydown", (e) => {
    if ((e.altKey || e.ctrlKey) && e.key === "d") {
      e.preventDefault();
      const isHidden = dmenu?.classList.contains("hidden");
      dmenu?.classList.toggle("hidden");
      if (isHidden) {
        input?.focus();
        input!.value = "";
        filterItems("");
        selectedIndex = 0;
        updateSelection();
      }
    }

    if (e.key === "Escape") {
      dmenu?.classList.add("hidden");
    }
  });

  // Filter
  input?.addEventListener("input", () => {
    filterItems(input.value.toLowerCase());
    selectedIndex = 0;
    updateSelection();
  });

  function filterItems(q: string) {
    items.forEach((item) => {
      const text = item.textContent?.toLowerCase() || "";
      item.classList.toggle("hidden", !text.includes(q) && q !== "");
    });
  }

  // Keyboard nav
  input?.addEventListener("keydown", (e) => {
    const visible = Array.from(items).filter(
      (i) => !i.classList.contains("hidden"),
    );

    if (e.key === "Tab" || e.key === "ArrowRight") {
      e.preventDefault();
      selectedIndex = (selectedIndex + 1) % visible.length;
      updateSelection();
    }

    if (e.key === "ArrowLeft") {
      e.preventDefault();
      selectedIndex = (selectedIndex - 1 + visible.length) % visible.length;
      updateSelection();
    }

    if (e.key === "Enter") {
      e.preventDefault();
      const selected = visible[selectedIndex] as HTMLElement;
      if (selected) {
        selected.click();
        dmenu?.classList.add("hidden");
      }
    }
  });

  function updateSelection() {
    const visible = Array.from(items).filter(
      (i) => !i.classList.contains("hidden"),
    );
    items.forEach((i) => i.classList.remove("selected"));
    visible[selectedIndex]?.classList.add("selected");
    visible[selectedIndex]?.scrollIntoView({
      block: "nearest",
      inline: "center",
    });
  }

  // Actions
  items.forEach((item) => {
    item.addEventListener("click", () => {
      const action = item.getAttribute("data-action");

      if (action === "theme") {
        const themes = ["tokyo-night", "dracula", "gruvbox", "nord", "matrix"];
        const current =
          document.documentElement.getAttribute("data-theme") || "tokyo-night";
        const next = themes[(themes.indexOf(current) + 1) % themes.length];
        document.documentElement.setAttribute("data-theme", next);
        showNotify(`Theme: ${next}`);
      }

      if (action === "scratchpad") {
        const sp = document.getElementById("scratchpad");
        sp?.classList.toggle("visible");
        showNotify(
          sp?.classList.contains("visible")
            ? "Scratchpad shown"
            : "Scratchpad hidden",
        );
      }

      dmenu?.classList.add("hidden");
    });
  });
</script>
