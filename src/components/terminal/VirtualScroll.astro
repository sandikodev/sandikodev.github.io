---
// Virtual Scrolling - Performance optimization for large lists
interface Props {
  items: any[];
  itemHeight: number;
  containerHeight: number;
  renderItem: (item: any, index: number) => string;
  className?: string;
}

const { items, itemHeight, containerHeight, renderItem, className = '' } = Astro.props;
---

<div class={`virtual-scroll-container ${className}`} data-item-height={itemHeight} data-container-height={containerHeight}>
  <div class="virtual-scroll-viewport">
    <div class="virtual-scroll-spacer-before"></div>
    <div class="virtual-scroll-content"></div>
    <div class="virtual-scroll-spacer-after"></div>
  </div>
</div>

<style>
.virtual-scroll-container {
  position: relative;
  overflow: hidden;
}

.virtual-scroll-viewport {
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
}

.virtual-scroll-content {
  position: relative;
}

.virtual-scroll-spacer-before,
.virtual-scroll-spacer-after {
  height: 0;
}

/* Custom scrollbar */
.virtual-scroll-viewport::-webkit-scrollbar {
  width: 8px;
}

.virtual-scroll-viewport::-webkit-scrollbar-track {
  background: var(--bg-secondary);
}

.virtual-scroll-viewport::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 4px;
}

.virtual-scroll-viewport::-webkit-scrollbar-thumb:hover {
  background: var(--accent-color);
}

/* Virtual scroll items */
.virtual-item {
  position: relative;
  transition: all 0.2s ease;
}

.virtual-item:hover {
  background: var(--bg-secondary);
}

/* Loading state */
.virtual-scroll-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  color: var(--text-muted);
  font-family: 'Fira Code', monospace;
}

.virtual-scroll-loading::after {
  content: '';
  width: 16px;
  height: 16px;
  border: 2px solid var(--border-color);
  border-top: 2px solid var(--accent-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-left: 8px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Performance optimizations */
.virtual-scroll-container * {
  will-change: transform;
}

.virtual-scroll-viewport {
  contain: layout style paint;
}
</style>

<script define:vars={{ items, itemHeight, containerHeight, renderItem }}>
class VirtualScroll {
  constructor(container, options) {
    this.container = container;
    this.viewport = container.querySelector('.virtual-scroll-viewport');
    this.content = container.querySelector('.virtual-scroll-content');
    this.spacerBefore = container.querySelector('.virtual-scroll-spacer-before');
    this.spacerAfter = container.querySelector('.virtual-scroll-spacer-after');
    
    this.items = options.items || [];
    this.itemHeight = options.itemHeight || 50;
    this.containerHeight = options.containerHeight || 400;
    this.renderItem = options.renderItem || ((item, index) => `<div>${item}</div>`);
    this.buffer = 5; // Extra items to render outside viewport
    
    this.startIndex = 0;
    this.endIndex = 0;
    this.visibleItems = [];
    
    this.init();
  }
  
  init() {
    this.viewport.style.height = `${this.containerHeight}px`;
    this.calculateVisibleRange();
    this.render();
    this.bindEvents();
  }
  
  calculateVisibleRange() {
    const scrollTop = this.viewport.scrollTop;
    const visibleCount = Math.ceil(this.containerHeight / this.itemHeight);
    
    this.startIndex = Math.max(0, Math.floor(scrollTop / this.itemHeight) - this.buffer);
    this.endIndex = Math.min(this.items.length - 1, this.startIndex + visibleCount + this.buffer * 2);
    
    this.visibleItems = this.items.slice(this.startIndex, this.endIndex + 1);
  }
  
  render() {
    // Update spacers
    const beforeHeight = this.startIndex * this.itemHeight;
    const afterHeight = (this.items.length - this.endIndex - 1) * this.itemHeight;
    
    this.spacerBefore.style.height = `${beforeHeight}px`;
    this.spacerAfter.style.height = `${afterHeight}px`;
    
    // Render visible items
    this.content.innerHTML = this.visibleItems
      .map((item, index) => {
        const actualIndex = this.startIndex + index;
        return `<div class="virtual-item" data-index="${actualIndex}" style="height: ${this.itemHeight}px;">
          ${this.renderItem(item, actualIndex)}
        </div>`;
      })
      .join('');
  }
  
  bindEvents() {
    let ticking = false;
    
    this.viewport.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          this.calculateVisibleRange();
          this.render();
          ticking = false;
        });
        ticking = true;
      }
    });
  }
  
  updateItems(newItems) {
    this.items = newItems;
    this.calculateVisibleRange();
    this.render();
  }
  
  scrollToIndex(index) {
    const scrollTop = index * this.itemHeight;
    this.viewport.scrollTop = scrollTop;
  }
  
  scrollToTop() {
    this.viewport.scrollTop = 0;
  }
  
  scrollToBottom() {
    this.viewport.scrollTop = this.viewport.scrollHeight;
  }
}

// Initialize virtual scroll when DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  const containers = document.querySelectorAll('.virtual-scroll-container');
  
  containers.forEach(container => {
    const itemHeight = parseInt(container.dataset.itemHeight) || 50;
    const containerHeight = parseInt(container.dataset.containerHeight) || 400;
    
    // Get items from data attribute or use provided items
    let itemsData = items;
    if (container.dataset.items) {
      try {
        itemsData = JSON.parse(container.dataset.items);
      } catch (e) {
        console.warn('Failed to parse items data:', e);
      }
    }
    
    const virtualScroll = new VirtualScroll(container, {
      items: itemsData,
      itemHeight,
      containerHeight,
      renderItem: (item, index) => {
        // Default render function - can be customized
        if (typeof item === 'object') {
          return `
            <div class="virtual-item-content">
              <div class="item-title">${item.title || item.name || `Item ${index}`}</div>
              ${item.description ? `<div class="item-description">${item.description}</div>` : ''}
              ${item.date ? `<div class="item-date">${item.date}</div>` : ''}
            </div>
          `;
        }
        return `<div class="virtual-item-content">${item}</div>`;
      }
    });
    
    // Store instance for external access
    container._virtualScroll = virtualScroll;
  });
});

// Export for external use
window.VirtualScroll = VirtualScroll;
</script>

<style>
/* Item content styling */
.virtual-item-content {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-color);
  font-family: 'Fira Code', monospace;
}

.item-title {
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.item-description {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 4px;
  line-height: 1.4;
}

.item-date {
  font-size: 10px;
  color: var(--text-muted);
}

/* Hover effects */
.virtual-item:hover .item-title {
  color: var(--accent-color);
}

/* Selection state */
.virtual-item.selected {
  background: var(--accent-color);
  color: var(--bg-primary);
}

.virtual-item.selected .item-title,
.virtual-item.selected .item-description,
.virtual-item.selected .item-date {
  color: var(--bg-primary);
}

/* Performance hints */
.virtual-scroll-container {
  transform: translateZ(0); /* Force GPU acceleration */
}

/* Mobile optimizations */
@media (max-width: 768px) {
  .virtual-item-content {
    padding: 8px 12px;
  }
  
  .item-title {
    font-size: 14px;
  }
  
  .item-description {
    font-size: 11px;
  }
  
  .item-date {
    font-size: 9px;
  }
}
</style>
