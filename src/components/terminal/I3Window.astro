---
interface Props {
  title: string;
  focused?: boolean;
  floating?: boolean;
  urgent?: boolean;
  resizable?: boolean;
  class?: string;
  id?: string;
}

const { 
  title, 
  focused = false, 
  floating = false, 
  urgent = false,
  resizable = false,
  class: className = "", 
  id 
} = Astro.props;
---

<div 
  class={`i3-window ${focused ? 'focused' : ''} ${floating ? 'floating' : ''} ${urgent ? 'urgent' : ''} ${className}`}
  id={id}
  data-floating={floating}
  tabindex="0"
>
  <div class="i3-titlebar">
    <div class="i3-titlebar-title">
      <span class="titlebar-icon">▣</span>
      <span class="titlebar-text">{title}</span>
    </div>
    <div class="i3-titlebar-actions">
      {floating && (
        <>
          <button class="i3-titlebar-btn" data-action="minimize" title="Minimize" aria-label="Minimize">
            ─
          </button>
          <button class="i3-titlebar-btn" data-action="maximize" title="Maximize" aria-label="Maximize">
            □
          </button>
        </>
      )}
      <button class="i3-titlebar-btn" data-action="toggle-float" title="Toggle Float" aria-label="Toggle floating">
        ◫
      </button>
      <button class="i3-titlebar-btn btn-close" data-action="close" title="Close" aria-label="Close window">
        ✕
      </button>
    </div>
  </div>
  
  <div class="i3-content">
    <slot />
  </div>

  {resizable && floating && (
    <div class="i3-resize-handles">
      <div class="i3-resize-handle resize-e" data-resize="e"></div>
      <div class="i3-resize-handle resize-s" data-resize="s"></div>
      <div class="i3-resize-handle resize-se" data-resize="se"></div>
    </div>
  )}
</div>

<style>
  .titlebar-icon {
    font-size: 12px;
    opacity: 0.7;
  }

  .titlebar-text {
    font-weight: 500;
  }

  .btn-close:hover {
    background: var(--red);
    color: white;
  }

  /* Resize Handles */
  .i3-resize-handles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .i3-resize-handle {
    position: absolute;
    pointer-events: all;
    z-index: 10;
  }

  .resize-e {
    right: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    cursor: ew-resize;
  }

  .resize-s {
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    cursor: ns-resize;
  }

  .resize-se {
    bottom: 0;
    right: 0;
    width: 12px;
    height: 12px;
    cursor: nwse-resize;
  }

  .resize-se::after {
    content: '⋮⋮';
    position: absolute;
    bottom: 0;
    right: 2px;
    font-size: 10px;
    color: var(--text-muted);
    opacity: 0.5;
  }

  /* Focus state */
  .i3-window:focus {
    outline: none;
  }

  .i3-window:focus-within {
    border-color: var(--i3-border-focused);
  }
</style>

<script>
  // Window interactions
  document.querySelectorAll('.i3-window').forEach(window => {
    const titlebar = window.querySelector('.i3-titlebar');
    const actions = window.querySelectorAll('[data-action]');

    // Focus on click
    window.addEventListener('click', () => {
      document.querySelectorAll('.i3-window.focused').forEach(w => {
        if (w !== window) w.classList.remove('focused');
      });
      window.classList.add('focused');
    });

    // Actions
    actions.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const action = (btn as HTMLElement).dataset.action;

        switch (action) {
          case 'close':
            window.style.display = 'none';
            break;
          case 'minimize':
            window.classList.toggle('minimized');
            break;
          case 'maximize':
            window.classList.toggle('maximized');
            break;
          case 'toggle-float':
            window.classList.toggle('floating');
            break;
        }
      });
    });

    // Dragging (floating windows only)
    if (window.classList.contains('floating')) {
      let isDragging = false;
      let startX = 0, startY = 0;
      let initialX = 0, initialY = 0;

      titlebar?.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement).closest('[data-action]')) return;
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        const rect = window.getBoundingClientRect();
        initialX = rect.left;
        initialY = rect.top;
        window.style.cursor = 'move';
      });

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        window.style.left = (initialX + dx) + 'px';
        window.style.top = (initialY + dy) + 'px';
      });

      document.addEventListener('mouseup', () => {
        isDragging = false;
        window.style.cursor = '';
      });
    }

    // Resizing (floating windows with resize handles)
    const resizeHandles = window.querySelectorAll('[data-resize]');
    resizeHandles.forEach(handle => {
      let isResizing = false;
      let startX = 0, startY = 0;
      let startWidth = 0, startHeight = 0;

      handle.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        isResizing = true;
        startX = e.clientX;
        startY = e.clientY;
        const rect = window.getBoundingClientRect();
        startWidth = rect.width;
        startHeight = rect.height;
      });

      document.addEventListener('mousemove', (e) => {
        if (!isResizing) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        const direction = (handle as HTMLElement).dataset.resize;

        if (direction?.includes('e')) {
          window.style.width = (startWidth + dx) + 'px';
        }
        if (direction?.includes('s')) {
          window.style.height = (startHeight + dy) + 'px';
        }
      });

      document.addEventListener('mouseup', () => {
        isResizing = false;
      });
    });
  });
</script>
