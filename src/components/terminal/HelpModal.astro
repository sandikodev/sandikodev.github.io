---
const shortcuts = [
  { category: 'Navigation', items: [
    { keys: ['j'], desc: 'Scroll down' },
    { keys: ['k'], desc: 'Scroll up' },
    { keys: ['g', 'g'], desc: 'Go to top' },
    { keys: ['G'], desc: 'Go to bottom' },
    { keys: ['g', 'h'], desc: 'Go to home' },
    { keys: ['g', 'b'], desc: 'Go to blog' },
  ]},
  { category: 'Actions', items: [
    { keys: ['/'], desc: 'Search' },
    { keys: ['Ctrl', 'K'], desc: 'Command palette' },
    { keys: ['Esc'], desc: 'Close modal' },
  ]},
  { category: 'Theme', items: [
    { keys: ['t'], desc: 'Cycle themes' },
  ]},
  { category: 'Help', items: [
    { keys: ['?'], desc: 'Show this help' },
  ]},
];
---

<div class="help-modal" id="help-modal">
  <div class="help-content">
    <div class="help-header">
      <h2 class="help-title">⌨️ Keyboard Shortcuts</h2>
      <button class="help-close" id="help-close" aria-label="Close">×</button>
    </div>
    
    <div class="help-body">
      {shortcuts.map(section => (
        <div class="help-section">
          <h3 class="help-section-title">{section.category}</h3>
          <div class="help-shortcuts">
            {section.items.map(item => (
              <div class="help-shortcut">
                <div class="help-keys">
                  {item.keys.map(key => (
                    <kbd class="help-key">{key}</kbd>
                  ))}
                </div>
                <div class="help-desc">{item.desc}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    
    <div class="help-footer">
      <p>Press <kbd class="help-key">Esc</kbd> to close</p>
    </div>
  </div>
</div>

<style>
  .help-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .help-modal.visible {
    opacity: 1;
    pointer-events: all;
  }

  .help-content {
    background: var(--bg-secondary);
    border: 2px solid var(--border);
    border-radius: 8px;
    width: 90%;
    max-width: 600px;
    max-height: 80vh;
    overflow: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .help-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg-secondary);
    z-index: 1;
  }

  .help-title {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .help-title::before {
    content: '';
  }

  .help-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
    font-size: 24px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .help-close:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border-color: var(--red);
  }

  .help-body {
    padding: 20px;
  }

  .help-section {
    margin-bottom: 24px;
  }

  .help-section:last-child {
    margin-bottom: 0;
  }

  .help-section-title {
    font-size: 0.875rem;
    color: var(--cyan);
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .help-section-title::before {
    content: '';
  }

  .help-shortcuts {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .help-shortcut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--bg-primary);
    border-radius: 4px;
  }

  .help-keys {
    display: flex;
    gap: 4px;
  }

  .help-key {
    display: inline-block;
    padding: 4px 8px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-primary);
    min-width: 28px;
    text-align: center;
  }

  .help-desc {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .help-footer {
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    text-align: center;
    background: var(--bg-primary);
  }

  .help-footer p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .help-content {
      width: 95%;
      max-height: 90vh;
    }

    .help-body {
      padding: 16px;
    }

    .help-shortcut {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  const modal = document.getElementById('help-modal');
  const closeBtn = document.getElementById('help-close');

  closeBtn?.addEventListener('click', () => {
    modal?.classList.remove('visible');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.remove('visible');
    }
  });
</script>
