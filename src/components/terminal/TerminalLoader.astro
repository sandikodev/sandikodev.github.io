---
interface Props {
  autoStart?: boolean;
  duration?: number; // total duration of the loading in seconds
  failAt?: number; // index where it fails, -1 for no failure
  failMessage?: string;
  steps?: string[];
}

const {
  autoStart = true,
  duration = 2,
  failAt = 2,
  failMessage = "node_not_found",
  steps = [
    "Resolving route definition...",
    "Scanning content collections...",
    "Mounting layout components...",
  ],
} = Astro.props;
---

<div class="loader-anim" data-autostart={autoStart} data-duration={duration}>
  <div class="progress-container">
    <div
      class="progress-bar"
      style={`animation-duration: ${duration}s; animation-fill-mode: forwards;`}
    >
    </div>
  </div>
  <div class="loader-steps">
    {
      steps.map((step, i) => {
        const isFail = i === failAt;
        const status = isFail ? "[ FAIL ]" : "[ DONE ]";
        const delay = (duration / steps.length) * i;

        return (
          <div
            class={`loader-step ${isFail ? "fail" : ""}`}
            style={`animation-delay: ${delay}s;`}
          >
            {status} {step}
            {isFail && failAt !== -1 ? `: ${failMessage}` : ""}
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .loader-anim {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1rem 0;
  }

  .progress-container {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-bar {
    width: 0%;
    height: 100%;
    background: var(--accent, #7aa2f7);
    border-radius: 2px;
    box-shadow: 0 0 10px var(--accent);
    animation: load linear forwards;
  }

  .loader-steps {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
  }

  .loader-step {
    color: var(--text-muted, #565f89);
    opacity: 0;
    transform: translateX(-10px);
    animation: slideIn 0.3s forwards;
  }

  .loader-step.fail {
    color: var(--red, #f7768e);
    font-weight: bold;
  }

  @keyframes load {
    0% {
      width: 0;
    }
    100% {
      width: 100%;
    } /* Default behavior, can be overridden if specific fail logic is needed */
  }

  /* Specific animation for 404 style failure behavior if needed */
  .fail-progress {
    animation: loadFail linear forwards;
  }

  @keyframes slideIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
