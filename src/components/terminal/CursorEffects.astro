---
// Terminal Cursor Effects - Custom cursor with trail and glow
---

<div id="cursor-dot" class="cursor-dot"></div>
<div id="cursor-trail" class="cursor-trail"></div>

<style>
  .cursor-dot {
    position: fixed;
    width: 8px;
    height: 8px;
    background: var(--accent, #7aa2f7);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    mix-blend-mode: difference;
    transition: transform 0.1s ease;
    box-shadow: 0 0 10px var(--accent, #7aa2f7);
  }
  
  .cursor-trail {
    position: fixed;
    width: 20px;
    height: 20px;
    border: 1px solid var(--accent, #7aa2f7);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transition: all 0.3s ease;
    opacity: 0.6;
  }
  
  /* Hide default cursor in dev mode */
  [data-theme-mode="terminal"] * {
    cursor: none !important;
  }
  
  /* Show default cursor on interactive elements */
  [data-theme-mode="terminal"] a,
  [data-theme-mode="terminal"] button,
  [data-theme-mode="terminal"] input,
  [data-theme-mode="terminal"] textarea,
  [data-theme-mode="terminal"] select {
    cursor: pointer !important;
  }
  
  [data-theme-mode="terminal"] input[type="text"],
  [data-theme-mode="terminal"] textarea {
    cursor: text !important;
  }
  
  /* Hover effects */
  .cursor-dot.hover {
    transform: scale(1.5);
    background: var(--green, #9ece6a);
    box-shadow: 0 0 20px var(--green, #9ece6a);
  }
  
  .cursor-trail.hover {
    transform: scale(1.2);
    border-color: var(--green, #9ece6a);
    opacity: 0.8;
  }
  
  /* Click effect */
  .cursor-dot.click {
    transform: scale(0.8);
    background: var(--red, #f7768e);
    box-shadow: 0 0 15px var(--red, #f7768e);
  }
  
  .cursor-trail.click {
    transform: scale(0.9);
    border-color: var(--red, #f7768e);
  }
  
  /* Hide on mobile */
  @media (max-width: 768px) {
    .cursor-dot,
    .cursor-trail {
      display: none;
    }
    
    [data-theme-mode="terminal"] * {
      cursor: auto !important;
    }
  }
</style>

<script>
  function initCursorEffects() {
    // Only run in terminal mode and on desktop
    if (window.innerWidth <= 768) return;
    
    const dot = document.getElementById('cursor-dot');
    const trail = document.getElementById('cursor-trail');
    
    if (!dot || !trail) return;
    
    let mouseX = 0;
    let mouseY = 0;
    let trailX = 0;
    let trailY = 0;
    
    // Update cursor position
    function updateCursor() {
      dot.style.left = mouseX - 4 + 'px';
      dot.style.top = mouseY - 4 + 'px';
      
      // Smooth trail following
      trailX += (mouseX - trailX) * 0.1;
      trailY += (mouseY - trailY) * 0.1;
      
      trail.style.left = trailX - 10 + 'px';
      trail.style.top = trailY - 10 + 'px';
      
      requestAnimationFrame(updateCursor);
    }
    
    // Mouse move handler
    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });
    
    // Hover effects
    document.addEventListener('mouseover', (e) => {
      const target = e.target;
      if (target.matches('a, button, input, textarea, select, .clickable')) {
        dot.classList.add('hover');
        trail.classList.add('hover');
      }
    });
    
    document.addEventListener('mouseout', (e) => {
      const target = e.target;
      if (target.matches('a, button, input, textarea, select, .clickable')) {
        dot.classList.remove('hover');
        trail.classList.remove('hover');
      }
    });
    
    // Click effects
    document.addEventListener('mousedown', () => {
      dot.classList.add('click');
      trail.classList.add('click');
    });
    
    document.addEventListener('mouseup', () => {
      dot.classList.remove('click');
      trail.classList.remove('click');
    });
    
    // Start animation loop
    updateCursor();
    
    // Show cursors
    dot.style.display = 'block';
    trail.style.display = 'block';
  }
  
  // Only init in terminal mode
  function checkAndInit() {
    const isTerminal = document.documentElement.getAttribute('data-theme-mode') === 'terminal';
    if (isTerminal && window.innerWidth > 768) {
      initCursorEffects();
    }
  }
  
  // Init
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkAndInit);
  } else {
    checkAndInit();
  }
  
  document.addEventListener('astro:page-load', checkAndInit);
</script>
