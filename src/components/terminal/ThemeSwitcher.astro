---
const themes = [
  { id: 'tokyo-night', name: 'Tokyo Night', icon: '🌃' },
  { id: 'dracula', name: 'Dracula', icon: '🧛' },
  { id: 'gruvbox', name: 'Gruvbox', icon: '🍂' },
  { id: 'nord', name: 'Nord', icon: '❄️' },
  { id: 'matrix', name: 'Matrix', icon: '💚' },
];
---

<div class="theme-switcher" id="theme-switcher">
  <button class="theme-btn" id="theme-btn" aria-label="Switch theme">
    <span class="theme-icon">🎨</span>
    <span class="theme-name">Theme</span>
  </button>
  
  <div class="theme-menu" id="theme-menu">
    {themes.map((theme) => (
      <button 
        class="theme-option" 
        data-theme={theme.id}
        aria-label={`Switch to ${theme.name}`}
      >
        <span class="theme-option-icon">{theme.icon}</span>
        <span class="theme-option-name">{theme.name}</span>
        <span class="theme-check">✓</span>
      </button>
    ))}
  </div>
</div>

<style>
  .theme-switcher {
    position: relative;
  }

  .theme-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .theme-btn:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border-color: var(--bar-accent);
  }

  .theme-icon {
    font-size: 14px;
  }

  .theme-menu {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px;
    min-width: 160px;
    display: none;
    flex-direction: column;
    gap: 2px;
    z-index: 1000;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .theme-menu.open {
    display: flex;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.15s;
    text-align: left;
  }

  .theme-option:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .theme-option.active {
    background: var(--bar-accent);
    color: var(--i3-bg);
  }

  .theme-option-icon {
    font-size: 16px;
  }

  .theme-option-name {
    flex: 1;
  }

  .theme-check {
    opacity: 0;
    font-size: 12px;
  }

  .theme-option.active .theme-check {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .theme-name {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('theme-btn');
  const menu = document.getElementById('theme-menu');
  const options = document.querySelectorAll('.theme-option');

  // Load saved theme
  const savedTheme = localStorage.getItem('theme') || 'tokyo-night';
  document.documentElement.setAttribute('data-theme', savedTheme);
  updateActiveTheme(savedTheme);

  // Toggle menu
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.toggle('open');
  });

  // Close menu on outside click
  document.addEventListener('click', () => {
    menu?.classList.remove('open');
  });

  // Theme selection
  options.forEach(option => {
    option.addEventListener('click', (e) => {
      const theme = (e.currentTarget as HTMLElement).dataset.theme;
      if (theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        updateActiveTheme(theme);
        menu?.classList.remove('open');
      }
    });
  });

  function updateActiveTheme(theme: string) {
    options.forEach(opt => {
      opt.classList.toggle('active', opt.getAttribute('data-theme') === theme);
    });
  }
</script>
