---
// Loading States for Blog Mode (V1)
// Skeleton loaders and loading indicators
---

<!-- Loading Bar -->
<div id="blog-loading-bar" class="blog-loading-bar"></div>

<!-- Skeleton Loaders (hidden by default) -->
<div id="skeleton-loaders" class="skeleton-container" style="display: none;">
  <div class="skeleton-post">
    <div class="skeleton-title"></div>
    <div class="skeleton-meta"></div>
    <div class="skeleton-content"></div>
    <div class="skeleton-content"></div>
    <div class="skeleton-content short"></div>
  </div>
</div>

<style>
  .blog-loading-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    width: 0%;
    transition: width 0.3s ease;
    z-index: 9999;
    opacity: 0;
  }

  .blog-loading-bar.active {
    opacity: 1;
    width: 100%;
  }

  .skeleton-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem;
  }

  .skeleton-post {
    animation: pulse 1.5s ease-in-out infinite;
  }

  .skeleton-title {
    height: 2rem;
    background: #e2e8f0;
    border-radius: 0.25rem;
    margin-bottom: 1rem;
    width: 70%;
  }

  .skeleton-meta {
    height: 1rem;
    background: #e2e8f0;
    border-radius: 0.25rem;
    margin-bottom: 2rem;
    width: 40%;
  }

  .skeleton-content {
    height: 1rem;
    background: #e2e8f0;
    border-radius: 0.25rem;
    margin-bottom: 0.75rem;
    width: 100%;
  }

  .skeleton-content.short {
    width: 60%;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Dark mode */
  .dark .skeleton-title,
  .dark .skeleton-meta,
  .dark .skeleton-content {
    background: #374151;
  }
</style>

<script>
  class BlogLoadingStates {
    constructor() {
      this.loadingBar = document.getElementById('blog-loading-bar');
      this.init();
    }

    init() {
      // Show loading bar on navigation
      document.addEventListener('astro:before-preparation', () => {
        this.showLoadingBar();
      });

      // Hide loading bar when page loads
      document.addEventListener('astro:page-load', () => {
        this.hideLoadingBar();
      });

      // Show skeleton on slow connections
      this.handleSlowConnection();
    }

    showLoadingBar() {
      if (this.loadingBar) {
        this.loadingBar.classList.add('active');
      }
    }

    hideLoadingBar() {
      if (this.loadingBar) {
        setTimeout(() => {
          this.loadingBar.classList.remove('active');
        }, 300);
      }
    }

    handleSlowConnection() {
      // Show skeleton if page takes too long to load
      const connection = navigator.connection;
      if (connection && connection.effectiveType === 'slow-2g') {
        this.showSkeleton();
      }
    }

    showSkeleton() {
      const skeleton = document.getElementById('skeleton-loaders');
      if (skeleton) {
        skeleton.style.display = 'block';
        
        // Hide after content loads
        document.addEventListener('astro:page-load', () => {
          skeleton.style.display = 'none';
        });
      }
    }
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new BlogLoadingStates());
  } else {
    new BlogLoadingStates();
  }
</script>
