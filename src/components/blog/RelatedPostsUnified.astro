---
import { getCollection } from "astro:content";
import { slugify } from "@/lib/utils/textConverter";
import PostCard from "@/components/blog/PostCard.astro";

interface Props {
  currentSlug: string;
  currentTags?: string[];
  currentCategories?: string[];
  algorithm?: 'recent' | 'similarity';
  limit?: number;
}

const { 
  currentSlug, 
  currentTags = [], 
  currentCategories = [], 
  algorithm = 'recent',
  limit = 3 
} = Astro.props;

// Get all posts
const posts = await getCollection("posts");
const publishedPosts = posts.filter(post => !post.data.draft);

let relatedPosts;

if (algorithm === 'similarity') {
  // Calculate similarity score
  function calculateSimilarity(post: any) {
    let score = 0;
    
    // Tag similarity (higher weight)
    const postTags = post.data.tags || [];
    const commonTags = postTags.filter((tag: string) => 
      currentTags.some(currentTag => slugify(currentTag) === slugify(tag))
    );
    score += commonTags.length * 3;
    
    // Category similarity
    const postCategories = post.data.categories || [];
    const commonCategories = postCategories.filter((cat: string) => 
      currentCategories.some(currentCat => slugify(currentCat) === slugify(cat))
    );
    score += commonCategories.length * 2;
    
    // Recency bonus (newer posts get slight boost)
    const daysSincePublished = Math.floor(
      (Date.now() - new Date(post.data.date).getTime()) / (1000 * 60 * 60 * 24)
    );
    score += Math.max(0, 30 - daysSincePublished) * 0.1;
    
    return score;
  }

  // Get related posts by similarity
  relatedPosts = publishedPosts
    .filter(post => post.id !== currentSlug)
    .map(post => ({
      ...post,
      similarity: calculateSimilarity(post)
    }))
    .sort((a, b) => b.similarity - a.similarity)
    .slice(0, limit);
} else {
  // Get recent posts
  relatedPosts = publishedPosts
    .filter(post => post.id !== currentSlug)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, limit);
}
---

{relatedPosts && relatedPosts.length > 0 && (
  <section class="related-posts">
    <h2 class="related-title">
      {algorithm === 'similarity' ? 'Related Posts' : 'Recent Posts'}
    </h2>
    <div class="related-grid">
      {relatedPosts.map((post: any) => (
        <PostCard 
          post={post} 
          variant="related"
          showImage={true}
          showReadingTime={false}
          showExcerpt={false}
          imageSize={{ width: 80, height: 50 }}
        />
      ))}
    </div>
  </section>
)}

<style>
  .related-posts {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  
  :global(.dark) .related-posts {
    border-color: rgba(255, 255, 255, 0.06);
  }
  
  .related-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #737373;
    margin-bottom: 1.5rem;
  }
  
  .related-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
