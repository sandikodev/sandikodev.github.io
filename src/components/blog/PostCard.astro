---
import { Image } from "astro:assets";

import dateFormat from "@/lib/utils/dateFormat";
import {
  calculateReadingTime,
  formatReadingTime,
} from "@/lib/utils/readingTime";

interface Props {
  imageSize?: { height: number; width: number };
  post: any;
  showExcerpt?: boolean;
  showImage?: boolean;
  showReadingTime?: boolean;
  variant?: "featured" | "grid" | "list" | "related";
}

const {
  imageSize = { height: 225, width: 400 },
  post,
  showExcerpt = false,
  showImage = true,
  showReadingTime = true,
  variant = "grid",
} = Astro.props;

const readingTime = calculateReadingTime(post.body);
const { date, description, image, tags, title } = post.data;
---

<article class={`post-card post-card--${variant}`}>
  {variant === "featured" && <div class="featured-badge">Latest Release</div>}
  <a class="post-link" href={`/${post.id}`}>
    {
      showImage && image && (
        <div class="post-image">
          <Image
            alt={title}
            class="main-image"
            height={imageSize.height}
            src={image}
            width={imageSize.width}
          />
        </div>
      )
    }

    <div class="post-content">
      <div class="post-meta">
        <div class="meta-item">
          <svg
            fill="none"
            height="14"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
          >
            <rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          <time>{dateFormat(date)}</time>
        </div>
        {
          showReadingTime && (
            <div class="meta-item">
              <svg
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              <span>{formatReadingTime(readingTime)}</span>
            </div>
          )
        }
      </div>

      <h3 class="post-title">{title}</h3>

      {showExcerpt && description && <p class="post-excerpt">{description}</p>}

      <div class="post-footer">
        <div class="post-tags-container">
          {
            tags && tags.length > 0 && (
              <div class="post-tags">
                {tags.slice(0, 2).map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )
          }
        </div>

        <div class="read-more">
          <span>Read article</span>
          <svg
            class="arrow-icon"
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="16"
          >
            <path
              d="M5 12h14M12 5l7 7-7 7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition-all);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100%;
    transform-origin: center;
  }

  .post-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      45deg,
      var(--color-primary-alpha-10),
      transparent
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
    pointer-events: none;
  }

  .post-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px var(--color-shadow-md);
    border-color: var(--color-primary-alpha-10);
  }

  .post-card:hover::before {
    opacity: 1;
  }

  .post-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 1;
  }

  .post-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-tertiary);
  }

  .post-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(0, 0, 0, 0.4));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Disable overlay for featured card */
  .post-card--featured .post-image::after {
    display: none;
  }

  .post-card:hover .post-image::after {
    opacity: 1;
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card:hover .post-image img {
    transform: scale(1.1) rotate(1deg);
  }

  .post-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 0.875rem;
    font-weight: 500;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .meta-item svg {
    opacity: 0.7;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    color: var(--color-text-main);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .post-card:hover .post-title {
    color: var(--color-primary);
  }

  .post-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 2rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-primary-alpha-10);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    opacity: 0.8;
    transition: var(--transition-all);
  }

  .arrow-icon {
    transition: transform 0.3s ease;
  }

  .post-card:hover .read-more {
    opacity: 1;
  }

  .post-card:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* --- Featured Variant Overrides --- */

  .post-card--featured {
    overflow: visible !important; /* Allow badge to sit on border without clipping */
  }

  /* Badge styling */
  .featured-badge {
    position: absolute;
    top: -10px;
    left: 20px;
    background: var(--color-primary);
    color: white;
    padding: 2px 12px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 700;
    z-index: 20;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  /* Container for the featured image */
  .post-card--featured .post-image {
    width: 100% !important;
    height: 400px !important;
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
  }

  .post-card--featured .post-content {
    padding: 2.5rem;
  }

  .post-card--featured .post-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    -webkit-line-clamp: 3;
    margin-bottom: 1.25rem;
  }

  .post-card--featured .post-excerpt {
    font-size: var(--text-base);
    -webkit-line-clamp: 4;
    margin-bottom: 2.5rem;
  }

  /* --- List Variant Overrides (Wide Card) --- */
  .post-card--list {
    flex-direction: row;
    align-items: stretch;
    gap: 0;
    /* min-height removed */
  }

  /* List Image Container */
  .post-card--list .post-image {
    flex: 1 1 45%; /* Flexible width with base of 45% */
    height: auto !important;
  }

  /* Content area for list */
  .post-card--list .post-content {
    flex: 1 1 55%; /* Flexible width with base of 55% */
    justify-content: center;
    padding: 2rem;
  }

  .post-card--list .post-title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  /* Remove overlays for list variant too */
  .post-card--list .post-image::before,
  .post-card--list .post-image::after {
    display: none !important;
    content: none !important;
  }

  /* Related variant specifics */
  .post-card--related {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0;
    min-height: 100px;
    isolation: isolate;
    position: relative;
    overflow: hidden;
  }

  .post-card--related .post-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
    position: relative;
    height: 100%;
    z-index: 10;
  }

  /* Image as background half-card */
  .post-card--related .post-image {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%; /* Exact half width */
    height: 100%;
    border-radius: 0;
    z-index: 0;
    border: none;
    box-shadow: none;
    object-fit: cover;

    /* Make it visible but subtle for text readability */
    mask-image: linear-gradient(to right, transparent, black 30%);
    -webkit-mask-image: linear-gradient(to right, transparent, black 30%);

    /* Blur and darken for readability */
    filter: blur(3px) brightness(0.6);
    opacity: 1; /* Fully visible */
    transition: all 0.5s ease;
  }

  .post-card--related:hover .post-image {
    /* sharpen on hover */
    filter: blur(0px) brightness(0.8);
    mask-image: linear-gradient(to right, transparent, black 10%);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%);
    width: 60%; /* Expand slightly */
  }

  .post-card--related .post-content {
    padding: 0;
    /* Text can overlay the image */
    width: 100%;
    position: relative;
    z-index: 5;
  }

  .post-card--related .post-title {
    font-size: 1rem;
    margin-bottom: 0.25rem;
    line-height: 1.4;
    /* Softer halo effect */
    text-shadow:
      0 0 10px var(--color-surface),
      0 0 20px var(--color-surface),
      0 0 30px var(--color-surface);
  }

  .post-card--related .post-footer {
    padding: 0;
    border: none;
    margin-top: 0.5rem;
  }

  .post-card--related .post-tags-container {
    display: none;
  }

  .post-card--related .read-more {
    font-size: 0.75rem;
    align-self: flex-start;
    background: var(--color-surface);
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    font-weight: 500;
    /* Create contrast against image */
    position: relative;
    z-index: 2;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .post-card--featured .post-image {
      height: 250px !important;
    }

    .post-card--featured .post-content {
      padding: 1.5rem;
    }

    .post-card--list {
      flex-direction: column;
      height: auto;
    }

    .post-card--list .post-image {
      width: 100%;
      height: 250px !important; /* Fixed height on mobile */
    }

    .post-card--list .post-content {
      width: 100%;
      padding: 1.5rem;
    }

    .post-card--list .post-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    /* Kept for safety, though handled by above media query mainly */
    .post-card--list {
      flex-direction: column;
    }
  }
</style>
