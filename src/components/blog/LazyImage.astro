---
interface Props {
  alt: string;
  class?: string;
  height?: number;
  src: string;
  width?: number;
}

const { alt, class: className, height, src, width } = Astro.props;
---

<img
  alt={alt}
  class={className}
  decoding="async"
  height={height}
  loading="lazy"
  src={src}
  width={width}
/>
