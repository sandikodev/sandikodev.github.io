---
interface Props {
  category?: string;
  categoryId?: string;
  repo?: string;
  repoId?: string;
}

const {
  category = "Announcements",
  categoryId = "DIC_kwDOIqW8wc4C2IxU",
  repo = "sandikodev/sandikodev.github.io",
  repoId = "R_kgDOIqW8wQ",
} = Astro.props;
---

<div class="comments-section">
  <h3 class="comments-title">Comments</h3>
  <div class="comments-container">
    <script
      is:inline
      async
      crossorigin="anonymous"
      data-category={category}
      data-category-id={categoryId}
      data-emit-metadata="0"
      data-input-position="top"
      data-lang="en"
      data-loading="lazy"
      data-mapping="pathname"
      data-reactions-enabled="1"
      data-repo={repo}
      data-repo-id={repoId}
      data-strict="1"
      data-theme="preferred_color_scheme"
      src="https://giscus.app/client.js"></script>
  </div>
</div>

<style>
  .comments-section {
    margin: 3rem auto;
    padding: 3rem 1.5rem;
    max-width: 680px;
    border-top: 1px solid var(--color-border);
  }

  .comments-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--color-text-main);
  }

  .comments-container {
    min-height: 200px;
  }
</style>

<script>
  function updateGiscusTheme() {
    const iframe = document.querySelector(
      "iframe.giscus-frame",
    ) as HTMLIFrameElement;
    if (!iframe) return;

    const isDark = document.documentElement.classList.contains("dark");
    const theme = isDark ? "dark" : "light";

    iframe.contentWindow?.postMessage(
      {
        giscus: {
          setConfig: {
            theme: theme,
          },
        },
      },
      "https://giscus.app",
    );
  }

  // Listen for custom theme-change event from Header.astro
  document.documentElement.addEventListener("theme-change", () => {
    setTimeout(updateGiscusTheme, 100);
  });

  // Support for Astro View Transitions
  document.addEventListener("astro:page-load", () => {
    setTimeout(updateGiscusTheme, 1000);
  });

  // Initial theme set
  setTimeout(updateGiscusTheme, 1000);
</script>
