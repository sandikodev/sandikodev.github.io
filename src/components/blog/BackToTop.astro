---
// Back to Top Button with Circular Progress
---

<button
  aria-label="Back to top"
  class="back-to-top"
  id="back-to-top"
  title="Back to top"
>
  <svg class="progress-ring" height="100%" viewBox="-1 -1 102 102" width="100%">
    <path
      class="progress-ring-circle-bg"
      d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"
    >
    </path>
    <path
      class="progress-ring-circle"
      d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"
    >
    </path>
  </svg>
  <span class="icon">↑</span>
</button>

<style>
  .back-to-top {
    position: fixed;
    bottom: var(--spacing-8);
    right: var(--spacing-8);
    z-index: 10000;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition: var(--transition-all);
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .progress-ring {
    position: absolute;
    top: 0;
    left: 0;
    transform: rotate(-90deg);
  }

  .progress-ring-circle-bg {
    stroke: var(--color-border);
    stroke-width: 4;
    fill: var(--color-bg);
  }

  .progress-ring-circle {
    stroke: var(--color-primary);
    stroke-width: 4;
    fill: transparent;
    stroke-dasharray: 307.87;
    stroke-dashoffset: 307.87;
    transition: stroke-dashoffset 0.1s;
    stroke-linecap: round;
  }

  :global(.dark) .progress-ring-circle-bg {
    fill: var(--color-surface);
  }

  .icon {
    position: relative;
    z-index: 1;
    font-size: 1.25rem;
    color: var(--color-text-main);
    transition: var(--transition-all);
  }

  .back-to-top:hover {
    transform: scale(1.1);
  }

  .back-to-top:hover .icon {
    transform: translateY(-2px);
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .back-to-top {
      bottom: var(--spacing-4);
      right: var(--spacing-4);
      width: 3rem;
      height: 3rem;
    }
  }
</style>

<script>
  function initBackToTop() {
    const button = document.getElementById("back-to-top") as HTMLButtonElement;
    const progressCircle = document.querySelector(
      ".progress-ring-circle",
    ) as SVGPathElement;
    const articleContainer = document.querySelector(
      ".article-content",
    ) as HTMLElement;

    if (!button || !progressCircle) return;

    const radius = 49;
    const circumference = 2 * Math.PI * radius;

    function updateProgress() {
      const scrollTop = window.scrollY;
      const winHeight = window.innerHeight;

      let scrollPercent: number;
      if (articleContainer) {
        // If in a post, track relative to the article content
        const rect = articleContainer.getBoundingClientRect();
        const totalHeight = rect.height;
        const currentProgress = scrollTop - (rect.top + scrollTop - winHeight);

        scrollPercent = Math.max(0, Math.min(1, currentProgress / totalHeight));
      } else {
        // Normal page tracking
        const docHeight = document.documentElement.scrollHeight - winHeight;
        scrollPercent = scrollTop / docHeight;
      }

      // Update visibility (only show after 300px scroll)
      if (scrollTop > 300) {
        button.classList.add("visible");
      } else {
        button.classList.remove("visible");
      }

      // Update progress ring
      const offset = circumference - scrollPercent * circumference;
      const safeOffset = Math.max(0, Math.min(offset, circumference));
      progressCircle.style.strokeDashoffset = safeOffset.toString();
    }

    button.addEventListener("click", () => {
      window.scrollTo({ behavior: "smooth", top: 0 });
    });

    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
  }

  document.addEventListener("astro:page-load", initBackToTop);
</script>
