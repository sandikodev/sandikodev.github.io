---
import { calculateReadingTime, formatReadingTime } from "@/lib/utils/readingTime";

interface Props {
  content: string;
  wordsPerMinute?: number;
}

const { content, wordsPerMinute = 200 } = Astro.props;

const minutes = calculateReadingTime(content, wordsPerMinute);
const words = content.trim().split(/\s+/).length;
---

<div class="reading-time">
  <span class="reading-time-icon" aria-hidden="true">📖</span>
  <span class="reading-time-text">
    {formatReadingTime(minutes)}
  </span>
  <span class="reading-time-words">
    ({words} words)
  </span>
</div>

<style>
  .reading-time {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    margin-bottom: 1rem;
  }
  
  .reading-time-icon {
    font-size: 1rem;
  }
  
  .reading-time-words {
    opacity: 0.7;
    font-size: 0.8rem;
  }
  
  /* Dev Mode styling */
  [data-theme-mode="terminal"] .reading-time {
    color: #7aa2f7;
  }
  
  [data-theme-mode="terminal"] .reading-time-words {
    color: #565f89;
  }
</style>
