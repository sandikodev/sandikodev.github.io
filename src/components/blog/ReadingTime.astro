---
import {
  calculateReadingTime,
  formatReadingTime,
} from "@/lib/utils/readingTime";

interface Props {
  content: string;
  wordsPerMinute?: number;
}

const { content, wordsPerMinute = 200 } = Astro.props;

const minutes = calculateReadingTime(content, wordsPerMinute);
const words = content.trim().split(/\s+/).length;
---

<div class="reading-time">
  <svg
    class="opacity-70"
    fill="none"
    height="14"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    width="14"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <polyline points="12 6 12 12 16 14"></polyline>
  </svg>
  <span class="reading-time-text">
    {formatReadingTime(minutes)}
  </span>
  <span class="reading-time-words">
    (
    {words}
    {words === 1 ? "word" : "words"}
    )
  </span>
</div>

<style>
  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .reading-time-icon {
    font-size: 1rem;
  }

  .reading-time-words {
    opacity: 0.7;
    font-size: 0.8rem;
  }

  /* Dev Mode styling */
  [data-theme-mode="terminal"] .reading-time {
    color: var(--color-terminal-accent);
  }

  [data-theme-mode="terminal"] .reading-time-words {
    color: var(--color-terminal-muted);
  }
</style>
