---
// Newsletter Signup for Blog Mode
---

<div class="newsletter-signup">
  <div class="newsletter-content">
    <h3>Stay Updated</h3>
    <p>Get the latest posts delivered right to your inbox.</p>

    <form class="newsletter-form" id="newsletter-form">
      <div class="form-group">
        <input
          class="newsletter-input"
          id="newsletter-email"
          placeholder="Enter your email"
          required
          type="email"
        />
        <button class="newsletter-btn" type="submit"> Subscribe </button>
      </div>
      <p class="newsletter-note">No spam, unsubscribe at any time.</p>
    </form>

    <div
      class="newsletter-message success"
      id="newsletter-success"
      style="display: none;"
    >
      ✅ Thanks for subscribing! Check your email to confirm.
    </div>

    <div
      class="newsletter-message error"
      id="newsletter-error"
      style="display: none;"
    >
      ❌ Something went wrong. Please try again.
    </div>
  </div>
</div>

<style>
  .newsletter-signup {
    text-align: left;
  }

  .newsletter-content h3 {
    font-size: var(--text-base);
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--color-text-main);
  }

  .newsletter-content p {
    font-size: var(--text-sm);
    margin: 0 0 1.25rem 0;
    color: var(--color-text-muted);
  }

  .form-group {
    display: block;
    max-width: 100%;
    margin: 0 auto 1.25rem auto;
  }

  .newsletter-input {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    background: var(--color-bg);
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-alpha-10);
  }

  .newsletter-btn {
    display: block;
    width: 100%;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: var(--transition-all);
  }

  .newsletter-btn:hover {
    background: var(--color-primary-hover);
  }

  .newsletter-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .newsletter-message {
    padding: 0.75rem;
    border-radius: 0.375rem;
    margin-top: 1rem;
  }

  .newsletter-message.success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .newsletter-message.error {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .form-group {
      flex-direction: column;
    }

    .newsletter-signup {
      padding: 1.5rem;
    }
  }
</style>

<script>
  class NewsletterSignup {
    emailInput: HTMLInputElement | null;
    errorMsg: HTMLElement | null;
    form: HTMLFormElement | null;
    successMsg: HTMLElement | null;

    constructor() {
      this.form = document.getElementById("newsletter-form") as HTMLFormElement;
      this.emailInput = document.getElementById(
        "newsletter-email",
      ) as HTMLInputElement;
      this.successMsg = document.getElementById("newsletter-success");
      this.errorMsg = document.getElementById("newsletter-error");
      this.init();
    }

    async handleSubmit(e: SubmitEvent) {
      e.preventDefault();

      if (!this.emailInput || !this.form) return;

      const email = this.emailInput.value.trim();
      if (!email) return;

      const submitBtn = this.form.querySelector(
        ".newsletter-btn",
      ) as HTMLButtonElement;
      const originalText = submitBtn.textContent;

      // Show loading state
      submitBtn.textContent = "Subscribing...";
      submitBtn.disabled = true;

      try {
        // Simulate API call (replace with actual newsletter service)
        await this.subscribeEmail(email);
        this.showSuccess();
        this.form.reset();
      } catch {
        this.showError();
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    }

    hideMessages() {
      if (this.successMsg) this.successMsg.style.display = "none";
      if (this.errorMsg) this.errorMsg.style.display = "none";
    }

    init() {
      if (this.form) {
        this.form.addEventListener("submit", (e) => this.handleSubmit(e));
      }
    }

    showError() {
      this.hideMessages();
      if (this.errorMsg) this.errorMsg.style.display = "block";
      setTimeout(() => this.hideMessages(), 5000);
    }

    showSuccess() {
      this.hideMessages();
      if (this.successMsg) this.successMsg.style.display = "block";
      setTimeout(() => this.hideMessages(), 5000);
    }

    async subscribeEmail(email: string) {
      // Replace this with your actual newsletter service
      // Examples: ConvertKit, Mailchimp, Buttondown, etc.

      // For now, just simulate success
      return new Promise<void>((resolve) => {
        setTimeout(() => {
          console.log("Newsletter signup:", email);
          resolve();
        }, 1000);
      });

      // Example with ConvertKit:
      // const response = await fetch('https://api.convertkit.com/v3/forms/YOUR_FORM_ID/subscribe', {
      //   method: 'POST',
      //   headers: { 'Content-Type': 'application/json' },
      //   body: JSON.stringify({
      //     api_key: 'YOUR_API_KEY',
      //     email: email
      //   })
      // });
      //
      // if (!response.ok) throw new Error('Subscription failed');
    }
  }

  // Initialize
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => new NewsletterSignup());
  } else {
    new NewsletterSignup();
  }
</script>
